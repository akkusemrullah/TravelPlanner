# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]64/
[Ll]og/
[Ll]ogs/
artifacts/
publish/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user
_ReSharper*/
*.swp
.DS_Store
Thumbs.db

# Copilot / IDE indexes
**/CopilotIndices/
**/FileContentIndex/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json

# Test results & coverage
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# Android / iOS build products and SIGNING MATERIAL - never commit these
*.apk
*.aab
*.ipa
*.dSYM/
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
*.cer
*.snk

# Local databases from manual testing
*.db3
*.db3-shm
*.db3-wal

# Temporary backups from manual refactors
_backup_*/
*.bak

# Supabase CLI local state & local secrets (never commit)
supabase/.temp/
.env
.env.*
**/functions/.env
