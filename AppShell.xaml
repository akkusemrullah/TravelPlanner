<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelPlanner.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
    xmlns:views="clr-namespace:TravelPlanner.Views"
    Shell.NavBarIsVisible="False"
    Title="TravelPlanner">

    <!-- Bottom tab bar: the three top-level destinations. Every other page is pushed on top of a tab
         (routes registered in AppShell.xaml.cs) and hides the tab bar itself. Icons come from the Lucide
         icon font; the Shell tints them with TabBarForegroundColor / TabBarUnselectedColor (Styles.xaml). -->
    <TabBar>
        <ShellContent
            Title="{x:Static res:AppResources.Nav_Home}"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Home}" Size="22" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="{x:Static res:AppResources.Nav_Trips}"
            ContentTemplate="{DataTemplate views:TripListPage}"
            Route="TripList">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Trips}" Size="22" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="{x:Static res:AppResources.Nav_Profile}"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="Settings">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.User}" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
