<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             x:Class="TravelPlanner.Views.TripDetailPage"
             x:DataType="vm:TripDetailViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{Binding Trip.Name}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
            <Border Grid.Column="2" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Share}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShareCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Share}" />
            </Border>
            <Border Grid.Column="3" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Edit}"
                    IsVisible="{Binding CanEdit}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditTripCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Edit}" />
            </Border>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,16,16,40" Spacing="16">

                    <!-- G6: shared with the user as a viewer -->
                    <Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource Banner.Warning}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Eye}" TextColor="{DynamicResource tp-warning}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{x:Static res:AppResources.TripDetail_ReadOnlyBanner}" FontSize="13" TextColor="{DynamicResource tp-warning}" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <!-- ════════ Cover photo (TripCoverService) ════════ -->
                    <Border IsVisible="{Binding HasCoverFile}" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="200" Margin="0,0,0,-4"
                            BackgroundColor="{DynamicResource tp-surface-alt}">
                        <Image Source="{Binding CoverFile}" Aspect="AspectFill" />
                    </Border>

                    <!-- ════════ Summary: the boarding pass (Views/TripTicketView) and the trip's own note ════════ -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding Ticket, Converter={StaticResource ObjectNotNullConverter}}">
                        <views:TripTicketView Ticket="{Binding Ticket}"
                                              WeatherCommand="{Binding GoToWeatherCommand}"
                                              MapCommand="{Binding GoToMapCommand}" />
                        <Label Text="{Binding Trip.Description}" Style="{StaticResource Text.Body2}" LineHeight="1.4" Margin="4,0"
                               IsVisible="{Binding Trip.Description, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <!-- ════════ Today (ongoing trips): green dot, "Bugün · 3. gün", "Planı aç ›", time + title rows ════════ -->
                    <Border IsVisible="{Binding IsTripOngoing}" Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToItineraryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Ellipse Grid.Column="0" WidthRequest="8" HeightRequest="8" Fill="{DynamicResource tp-success}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TodayTitle}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}"
                                       VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                                <HorizontalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.TripDetail_OpenPlan}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Center" />
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-accent-text}" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Label IsVisible="{Binding HasNoTodayActivities}" Text="{x:Static res:AppResources.TripDetail_TodayEmpty}" FontSize="13.5"
                                   TextColor="{DynamicResource tp-text-3}" Margin="0,8,0,0" />
                            <VerticalStackLayout IsVisible="{Binding HasTodayActivities}" Spacing="0" Margin="0,8,0,0" BindableLayout.ItemsSource="{Binding TodayActivities}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TripActivity">
                                        <VerticalStackLayout Spacing="0">
                                            <BoxView Style="{StaticResource Divider}" IsVisible="{Binding ListPosition, Converter={StaticResource ListPositionHasAboveConverter}}" />
                                            <Grid ColumnDefinitions="48,*" ColumnSpacing="12" Padding="0,8">
                                                <Label Grid.Column="0" Text="{Binding TimeDisplay}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-accent-text}" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Title}" FontFamily="InterMedium" FontSize="14.5" TextColor="{DynamicResource tp-text}" />
                                                    <HorizontalStackLayout Spacing="4" IsVisible="{Binding HasPlace}">
                                                        <Label Style="{StaticResource Icon}" FontSize="12" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-text-3}" />
                                                        <Label Text="{Binding PlaceName}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ════════ Budget: "BÜTÇE  %64", big spent amount, bar accent → amber at 80 % → red over ════════ -->
                    <Border Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToExpensesCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{helpers:Upper Budget_Title}" Style="{StaticResource Text.Overline}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding BudgetPercentText}" IsVisible="{Binding HasBudget}" FontFamily="InterBold" FontSize="13"
                                       TextColor="{DynamicResource tp-text-2}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsBudgetWarning}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-warning}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Label Text="{x:Static res:AppResources.TripDetail_NoBudget}" IsVisible="{Binding NoBudgetSet}" FontSize="14"
                                   TextColor="{DynamicResource tp-text-3}" Margin="0,6,0,0" />

                            <VerticalStackLayout IsVisible="{Binding HasBudget}" Spacing="0">
                                <HorizontalStackLayout Spacing="6" Margin="0,6,0,0">
                                    <Label Text="{Binding TotalExpensesFormatted}" FontFamily="InterBold" FontSize="26" TextColor="{DynamicResource tp-text}" VerticalOptions="End">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{x:Static res:AppResources.TripDetail_SpentSuffix}" FontSize="13" TextColor="{DynamicResource tp-text-3}" VerticalOptions="End" Margin="0,0,0,5" />
                                </HorizontalStackLayout>

                                <controls:ProgressPill Progress="{Binding BudgetProgress}" Tone="{Binding BudgetTone}" Margin="0,12,0,0" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{x:Static res:AppResources.Budget_Planned}" FontSize="13" TextColor="{DynamicResource tp-text-3}" />
                                        <Label Text="{Binding Trip.FormattedBudget}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="{x:Static res:AppResources.Budget_Remaining}" FontSize="13" TextColor="{DynamicResource tp-text-3}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding RemainingBudgetFormatted}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text}" HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>

                                <HorizontalStackLayout IsVisible="{Binding IsOverBudget}" Spacing="8" Margin="0,12,0,0">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" />
                                    <Label Text="{x:Static res:AppResources.TripDetail_OverBudget}" FontFamily="InterSemiBold" FontSize="13"
                                           TextColor="{DynamicResource tp-danger}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ════════ AI trip planner: soft accent card, 44 accent tile ════════ -->
                    <Border IsVisible="{Binding CanEdit}" BackgroundColor="{DynamicResource tp-accent-soft}" Stroke="Transparent" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" Padding="16"
                            SemanticProperties.Description="{x:Static res:AppResources.AiPlan_Title}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAiPlannerCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-accent}"
                                    WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Sparkles}" TextColor="{StaticResource White}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{x:Static res:AppResources.AiPlan_Title}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                <Label Text="{Binding AiPlannerSubtitle}" FontSize="12.5" TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-accent-text}" />
                        </Grid>
                    </Border>

                    <!-- ════════ Planning ════════ -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{helpers:Upper TripDetail_SectionPlanning}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <controls:ListRow Icon="{StaticResource Ic.CalendarDays}" Title="{x:Static res:AppResources.Section_Itinerary}"
                                                  Subtitle="{Binding ActivitiesSummary}" Command="{Binding GoToItineraryCommand}" />
                                <BoxView Style="{StaticResource Divider.Inset}" />
                                <controls:ListRow Icon="{StaticResource Ic.ListChecks}" Tone="success" Title="{x:Static res:AppResources.Section_Tasks}"
                                                  Subtitle="{Binding TasksSummary}" Command="{Binding GoToTasksCommand}" />
                                <BoxView Style="{StaticResource Divider.Inset}" />
                                <controls:ListRow Icon="{StaticResource Ic.Pin}" Title="{x:Static res:AppResources.Section_Places}"
                                                  Subtitle="{Binding PlacesSummary}" Command="{Binding GoToPlacesCommand}" />
                                <BoxView Style="{StaticResource Divider.Inset}" />
                                <controls:ListRow Icon="{StaticResource Ic.Map}" Tone="info" Title="{x:Static res:AppResources.Section_Map}"
                                                  Subtitle="{x:Static res:AppResources.TripDetail_MapSub}" Command="{Binding GoToMapCommand}" />
                                <BoxView Style="{StaticResource Divider.Inset}" />
                                <controls:ListRow Icon="{StaticResource Ic.Weather}" Tone="warning" Title="{x:Static res:AppResources.Section_Weather}"
                                                  Subtitle="{Binding Trip.City}" Command="{Binding GoToWeatherCommand}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Finance ════════ -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{helpers:Upper TripDetail_SectionFinance}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <controls:ListRow Icon="{StaticResource Ic.Wallet}" Title="{x:Static res:AppResources.Section_Expenses}"
                                                  Subtitle="{Binding ExpensesSummary}" Command="{Binding GoToExpensesCommand}" />
                                <BoxView Style="{StaticResource Divider.Inset}" />
                                <controls:ListRow Icon="{StaticResource Ic.PieChart}" Tone="info" Title="{x:Static res:AppResources.Section_Analysis}"
                                                  Subtitle="{x:Static res:AppResources.TripDetail_AnalysisSub}" Command="{Binding GoToAnalysisCommand}" />
                                <BoxView Style="{StaticResource Divider.Inset}" />
                                <controls:ListRow Icon="{StaticResource Ic.ArrowLeftRight}" Tone="success" Title="{x:Static res:AppResources.Section_Split}"
                                                  Subtitle="{x:Static res:AppResources.TripDetail_SplitSub}" Command="{Binding GoToSplitCommand}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Sharing (G6) ════════ -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{helpers:Upper TripDetail_SectionSharing}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <controls:ListRow Icon="{StaticResource Ic.Users}" Title="{x:Static res:AppResources.Members_Title}"
                                                  Subtitle="{Binding SharingSubtitle}" Command="{Binding GoToMembersCommand}" />
                                <HorizontalStackLayout IsVisible="{Binding HasLastChange}" Spacing="4" Margin="68,-6,16,12">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToMembersCommand}" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label Style="{StaticResource Icon}" FontSize="12" Text="{StaticResource Ic.Clock}" TextColor="{DynamicResource tp-text-3}" />
                                    <Label Text="{Binding LastChangeText}" FontSize="12" TextColor="{DynamicResource tp-text-3}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Documents (its own card, no section title) ════════ -->
                    <Border Style="{StaticResource Card.List}">
                        <controls:ListRow Icon="{StaticResource Ic.FileText}" Tone="neutral" Title="{x:Static res:AppResources.Section_Attachments}"
                                          Subtitle="{Binding FilesSummary}" Command="{Binding GoToAttachmentsCommand}" />
                    </Border>

                    <!-- ════════ Duplicate: a new trip from this one (to-dos, places, plan, participants) ════════ -->
                    <Button Text="{x:Static res:AppResources.TripDetail_Duplicate}" Command="{Binding DuplicateTripCommand}" Style="{StaticResource Btn.Secondary}"
                            ContentLayout="Left,8">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Copy}" Size="18" Color="{DynamicResource tp-text}" />
                        </Button.ImageSource>
                    </Button>

                    <!-- ════════ Danger zone ════════ -->
                    <Button Text="{x:Static res:AppResources.TripDetail_Delete}" Command="{Binding DeleteTripCommand}" Style="{StaticResource Btn.Danger}"
                            IsVisible="{Binding IsOwner}" ContentLayout="Left,8">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Trash}" Size="18" Color="{DynamicResource tp-danger}" />
                        </Button.ImageSource>
                    </Button>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
