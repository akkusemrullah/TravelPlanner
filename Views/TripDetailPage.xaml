<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.TripDetailPage"
             x:DataType="vm:TripDetailViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{Binding Trip.Name}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
            <Border Grid.Column="2" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Share}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShareCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Share}" />
            </Border>
            <Border Grid.Column="3" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Edit}"
                    IsVisible="{Binding CanEdit}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditTripCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Edit}" />
            </Border>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,16,16,28" Spacing="20">

                    <!-- G6: shared with the user as a viewer -->
                    <Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource Banner.Info}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Eye}" TextColor="{DynamicResource tp-info}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{x:Static res:AppResources.TripDetail_ReadOnlyBanner}" FontSize="13" TextColor="{DynamicResource tp-info}" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <!-- ════════ Cover photo (TripCoverService) ════════ -->
                    <Border IsVisible="{Binding HasCoverFile}" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="190"
                            BackgroundColor="{DynamicResource tp-surface-alt}">
                        <Image Source="{Binding CoverFile}" Aspect="AspectFill" />
                    </Border>

                    <!-- ════════ Summary: the boarding pass (Views/TripTicketView) and the trip's own note ════════ -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding Ticket, Converter={StaticResource ObjectNotNullConverter}}">
                        <views:TripTicketView Ticket="{Binding Ticket}"
                                              WeatherCommand="{Binding GoToWeatherCommand}"
                                              MapCommand="{Binding GoToMapCommand}" />
                        <Label Text="{Binding Trip.Description}" Style="{StaticResource Text.Body2}" LineHeight="1.3" Margin="4,0"
                               IsVisible="{Binding Trip.Description, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <!-- ════════ Today (ongoing trips) ════════ -->
                    <Border IsVisible="{Binding IsTripOngoing}" Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToItineraryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Accent}" WidthRequest="32" HeightRequest="32">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Clock}" TextColor="{DynamicResource tp-accent-text}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding TodayTitle}" Style="{StaticResource Text.Title}" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                                <Label Grid.Column="2" Text="{x:Static res:AppResources.TripDetail_OpenPlan}" Style="{StaticResource Text.Link}" FontSize="13" VerticalOptions="Center" />
                            </Grid>
                            <Label IsVisible="{Binding HasNoTodayActivities}" Text="{x:Static res:AppResources.TripDetail_TodayEmpty}" Style="{StaticResource Text.Body2}" />
                            <VerticalStackLayout IsVisible="{Binding HasTodayActivities}" Spacing="10" BindableLayout.ItemsSource="{Binding TodayActivities}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TripActivity">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Grid.Column="0" Text="{Binding TimeDisplay}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text}" MinimumWidthRequest="44" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Title}" Style="{StaticResource Text.Body}" FontSize="14" />
                                                <Label Text="{Binding PlaceName}" IsVisible="{Binding HasPlace}" Style="{StaticResource Text.Caption}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ════════ Budget (TP-98: "BÜTÇE  %64", big spent amount, bar accent → amber at 80 % → red over) ════════ -->
                    <Border Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToExpensesCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{x:Static res:AppResources.Budget_Title}" Style="{StaticResource Text.Overline}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding BudgetPercentText}" IsVisible="{Binding HasBudget}" FontFamily="InterSemiBold" FontSize="13"
                                       TextColor="{DynamicResource tp-text-2}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsBudgetWarning}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-warning}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Label Text="{x:Static res:AppResources.TripDetail_NoBudget}" IsVisible="{Binding NoBudgetSet}" Style="{StaticResource Text.Body2}" />

                            <VerticalStackLayout IsVisible="{Binding HasBudget}" Spacing="14">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding TotalExpensesFormatted}" Style="{StaticResource Text.Metric}" VerticalOptions="End" />
                                    <Label Text="{x:Static res:AppResources.TripDetail_SpentSuffix}" Style="{StaticResource Text.Caption}" VerticalOptions="End" Margin="0,0,0,4" />
                                </HorizontalStackLayout>

                                <ProgressBar Progress="{Binding BudgetUsagePercentage, Converter={StaticResource PercentageToFractionConverter}}"
                                             ProgressColor="{DynamicResource tp-accent}" HeightRequest="6">
                                    <ProgressBar.Triggers>
                                        <DataTrigger TargetType="ProgressBar" Binding="{Binding IsBudgetWarning}" Value="True">
                                            <Setter Property="ProgressColor" Value="{DynamicResource tp-warning}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="ProgressBar" Binding="{Binding IsOverBudget}" Value="True">
                                            <Setter Property="ProgressColor" Value="{DynamicResource tp-danger}" />
                                        </DataTrigger>
                                    </ProgressBar.Triggers>
                                </ProgressBar>

                                <Border IsVisible="{Binding IsOverBudget}" Style="{StaticResource Banner.Error}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Grid.Column="0" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" />
                                        <Label Grid.Column="1" Text="{x:Static res:AppResources.TripDetail_OverBudget}" FontFamily="InterSemiBold" FontSize="13"
                                               TextColor="{DynamicResource tp-danger}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{x:Static res:AppResources.Budget_Planned}" Style="{StaticResource Text.Caption}" />
                                        <Label Text="{Binding Trip.FormattedBudget}" Style="{StaticResource Text.Value}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{x:Static res:AppResources.Budget_Remaining}" Style="{StaticResource Text.Caption}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding RemainingBudgetFormatted}" Style="{StaticResource Text.Value}" HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ════════ AI trip planner ════════ -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding CanEdit}" BackgroundColor="{DynamicResource tp-accent-soft}" Stroke="Transparent"
                            SemanticProperties.Description="{x:Static res:AppResources.AiPlan_Title}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAiPlannerCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource tp-accent}" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Sparkles}" TextColor="{StaticResource White}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{x:Static res:AppResources.AiPlan_Title}" Style="{StaticResource Text.Title}" />
                                <Label Text="{Binding AiPlannerSubtitle}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- ════════ Planning ════════ -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static res:AppResources.TripDetail_SectionPlanning}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Itinerary}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToItineraryCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Tint}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.CalendarDays}" TextColor="{DynamicResource tp-accent-text}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{x:Static res:AppResources.Section_Itinerary}" Style="{StaticResource Text.Body}" />
                                        <Label Text="{Binding ActivitiesSummary}" Style="{StaticResource Text.Caption}" MaxLines="1" LineBreakMode="TailTruncation"
                                               IsVisible="{Binding ActivitiesSummary, Converter={StaticResource StringNotEmptyConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider.Inset}" Margin="60,0,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Tasks}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToTasksCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Success}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Checklist}" TextColor="{DynamicResource tp-success}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{x:Static res:AppResources.Section_Tasks}" Style="{StaticResource Text.Body}" />
                                        <Label Text="{Binding TasksSummary}" Style="{StaticResource Text.Caption}" MaxLines="1" LineBreakMode="TailTruncation"
                                               IsVisible="{Binding TasksSummary, Converter={StaticResource StringNotEmptyConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider.Inset}" Margin="60,0,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Places}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToPlacesCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Warning}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-warning}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{x:Static res:AppResources.Section_Places}" Style="{StaticResource Text.Body}" />
                                        <Label Text="{Binding PlacesSummary}" Style="{StaticResource Text.Caption}" MaxLines="1" LineBreakMode="TailTruncation"
                                               IsVisible="{Binding PlacesSummary, Converter={StaticResource StringNotEmptyConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider.Inset}" Margin="60,0,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Map}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToMapCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Info}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Map}" TextColor="{DynamicResource tp-info}" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Section_Map}" Style="{StaticResource Text.Body}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider.Inset}" Margin="60,0,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Weather}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToWeatherCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Tint}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Weather}" TextColor="{DynamicResource tp-accent-text}" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Section_Weather}" Style="{StaticResource Text.Body}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Finance ════════ -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static res:AppResources.TripDetail_SectionFinance}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Expenses}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToExpensesCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Success}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Receipt}" TextColor="{DynamicResource tp-success}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{x:Static res:AppResources.Section_Expenses}" Style="{StaticResource Text.Body}" />
                                        <Label Text="{Binding ExpensesSummary}" Style="{StaticResource Text.Caption}" MaxLines="1" LineBreakMode="TailTruncation"
                                               IsVisible="{Binding ExpensesSummary, Converter={StaticResource StringNotEmptyConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider.Inset}" Margin="60,0,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Analysis}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToAnalysisCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Tint}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.PieChart}" TextColor="{DynamicResource tp-accent-text}" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Section_Analysis}" Style="{StaticResource Text.Body}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider.Inset}" Margin="60,0,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Split}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToSplitCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Info}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Users}" TextColor="{DynamicResource tp-info}" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Section_Split}" Style="{StaticResource Text.Body}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Sharing (G6) ════════ -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static res:AppResources.TripDetail_SectionSharing}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Members_Title}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToMembersCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Info}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Users}" TextColor="{DynamicResource tp-info}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{x:Static res:AppResources.Members_Title}" Style="{StaticResource Text.Body}" />
                                        <Label Text="{Binding SharingSubtitle}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding LastChangeText}" IsVisible="{Binding HasLastChange}" Style="{StaticResource Text.Caption}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Documents ════════ -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static res:AppResources.TripDetail_SectionFiles}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="56"
                                      SemanticProperties.Description="{x:Static res:AppResources.Section_Attachments}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToAttachmentsCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Warning}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Attachment}" TextColor="{DynamicResource tp-warning}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{x:Static res:AppResources.Section_Attachments}" Style="{StaticResource Text.Body}" />
                                        <Label Text="{Binding FilesSummary}" Style="{StaticResource Text.Caption}" MaxLines="1" LineBreakMode="TailTruncation"
                                               IsVisible="{Binding FilesSummary, Converter={StaticResource StringNotEmptyConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Duplicate: a new trip from this one (to-dos, places, plan, participants) ════════ -->
                    <VerticalStackLayout Spacing="10">
                    <Button Text="{x:Static res:AppResources.TripDetail_Duplicate}" Command="{Binding DuplicateTripCommand}" Style="{StaticResource Btn.Secondary}"
                            ContentLayout="Left,8">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Copy}" Size="16" Color="{DynamicResource tp-text}" />
                        </Button.ImageSource>
                    </Button>

                    <!-- ════════ Danger zone ════════ -->
                    <Button Text="{x:Static res:AppResources.TripDetail_Delete}" Command="{Binding DeleteTripCommand}" Style="{StaticResource Btn.Danger}"
                            IsVisible="{Binding IsOwner}" ContentLayout="Left,8">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Trash}" Size="16" Color="{DynamicResource tp-danger}" />
                        </Button.ImageSource>
                    </Button>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
