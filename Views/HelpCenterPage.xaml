<?xml version="1.0" encoding="utf-8" ?>
<!--
    Yardım merkezi: search, the FAQ grouped by topic (tap a question to open its answer), a "write to us" card and
    the legal documents. Questions and answers: AppResources.Help_Faq ("## Topic" / "? Question" lines).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.HelpCenterPage"
             x:DataType="vm:HelpCenterViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Help_Title}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,20,16,32" Spacing="20">

                <!-- ════════ Header + search ════════ -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource IconTile.Accent}" VerticalOptions="Center">
                            <Label Style="{StaticResource Icon.Accent}" Text="{StaticResource Ic.Compass}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{x:Static res:AppResources.Help_Heading}" Style="{StaticResource Text.H2}" LineBreakMode="WordWrap"
                                   SemanticProperties.HeadingLevel="Level1" />
                            <Label Text="{x:Static res:AppResources.Help_Subtitle}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <!-- SearchBar draws its own magnifier/clear icons; the Border only supplies the field chrome. -->
                    <Border Style="{StaticResource Input}" Padding="2,0">
                        <SearchBar Text="{Binding SearchText}" Placeholder="{x:Static res:AppResources.Help_SearchPlaceholder}"
                                   SemanticProperties.Description="{x:Static res:AppResources.Help_SearchPlaceholder}" />
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ FAQ by topic ════════ -->
                <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Categories}" IsVisible="{Binding HasResults}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:HelpCategoryView">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" Style="{StaticResource Text.Overline}" Margin="4,0" SemanticProperties.HeadingLevel="Level2" />
                                <Border Style="{StaticResource Card.List}">
                                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HelpItemView">
                                                <VerticalStackLayout Spacing="0">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,14" MinimumHeightRequest="52"
                                                          SemanticProperties.Description="{Binding Question}">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HelpCenterViewModel}}, Path=ToggleCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Grid.GestureRecognizers>
                                                        <Label Grid.Column="0" Text="{Binding Question}" Style="{StaticResource Text.Body}" FontFamily="InterSemiBold"
                                                               LineBreakMode="WordWrap" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronDown}"
                                                               TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Rotation" Value="180" />
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-accent}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Grid>
                                                    <Label Text="{Binding Answer}" Style="{StaticResource Text.Body}" FontSize="14" LineHeight="1.4"
                                                           TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap"
                                                           Padding="16,0,16,16" IsVisible="{Binding IsExpanded}" />
                                                    <BoxView Style="{StaticResource Divider.Inset}" Margin="16,0,0,0" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Nothing matched the search -->
                <VerticalStackLayout IsVisible="{Binding NoResults}" Spacing="12" Padding="16,8">
                    <Border Style="{StaticResource EmptyIcon}">
                        <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Search}" TextColor="{DynamicResource tp-text-2}" />
                    </Border>
                    <Label Text="{x:Static res:AppResources.Help_NoResults}" Style="{StaticResource EmptyStateTextLabel}" />
                    <Button Text="{x:Static res:AppResources.Help_ClearSearch}" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource Btn.Ghost.Sm}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- ════════ Contact ════════ -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource IconTile.Accent}" VerticalOptions="Start">
                                <Label Style="{StaticResource Icon.Accent}" Text="{StaticResource Ic.Notebook}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{x:Static res:AppResources.Help_ContactTitle}" Style="{StaticResource Text.Title}" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{Binding ContactHint}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="{x:Static res:AppResources.Help_WriteToUs}" Command="{Binding ContactCommand}" Style="{StaticResource Btn.Primary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ════════ Legal documents ════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.Profile_Legal}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,8" MinimumHeightRequest="52"
                                  SemanticProperties.Description="{x:Static res:AppResources.Privacy_Title}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDocumentCommand}" CommandParameter="privacy" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Tint}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Lock}" TextColor="{DynamicResource tp-accent-text}" />
                                </Border>
                                <Label Grid.Column="1" Text="{x:Static res:AppResources.Privacy_Title}" Style="{StaticResource Text.Body}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider.Inset}" Margin="16,0,0,0" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,8" MinimumHeightRequest="52"
                                  SemanticProperties.Description="{x:Static res:AppResources.Kvkk_Title}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDocumentCommand}" CommandParameter="kvkk" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Info}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Shield}" TextColor="{DynamicResource tp-info}" />
                                </Border>
                                <Label Grid.Column="1" Text="{x:Static res:AppResources.Kvkk_Title}" Style="{StaticResource Text.Body}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider.Inset}" Margin="16,0,0,0" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,8" MinimumHeightRequest="52"
                                  SemanticProperties.Description="{x:Static res:AppResources.Terms_Title}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDocumentCommand}" CommandParameter="terms" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Warning}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Scale}" TextColor="{DynamicResource tp-warning}" />
                                </Border>
                                <Label Grid.Column="1" Text="{x:Static res:AppResources.Terms_Title}" Style="{StaticResource Text.Body}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
