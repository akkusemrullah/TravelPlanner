<?xml version="1.0" encoding="utf-8" ?>
<!--
    Yardım merkezi: search, the FAQ grouped by topic (tap a question to open its answer), a "write to us" card and
    the legal documents. Questions and answers: AppResources.Help_Faq ("## Topic" / "? Question" lines).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             x:Class="TravelPlanner.Views.HelpCenterPage"
             x:DataType="vm:HelpCenterViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Help_Title}" Style="{StaticResource Text.AppBarTitle}" Margin="0,0,44,0" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,16,16,40" Spacing="16">

                <!-- ════════ Header + search (TP-105: the prototype's big question + search box) ════════ -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static res:AppResources.Help_Heading}" FontFamily="InterBold" FontSize="22" TextColor="{DynamicResource tp-text}"
                           LineBreakMode="WordWrap" SemanticProperties.HeadingLevel="Level1" />
                    <Border Style="{StaticResource SearchBox}">
                        <SearchBar Text="{Binding SearchText}" Placeholder="{x:Static res:AppResources.Help_SearchPlaceholder}"
                                   SemanticProperties.Description="{x:Static res:AppResources.Help_SearchPlaceholder}" />
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ FAQ by topic ════════ -->
                <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Categories}" IsVisible="{Binding HasResults}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:HelpCategoryView">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" Style="{StaticResource Text.Overline}" Margin="4,0" SemanticProperties.HeadingLevel="Level2" />
                                <Border Style="{StaticResource Card.List}">
                                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HelpItemView">
                                                <VerticalStackLayout Spacing="0">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,14" MinimumHeightRequest="52"
                                                          SemanticProperties.Description="{Binding Question}">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HelpCenterViewModel}}, Path=ToggleCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Grid.GestureRecognizers>
                                                        <Label Grid.Column="0" Text="{Binding Question}" FontFamily="InterMedium" FontSize="14.5" TextColor="{DynamicResource tp-text}"
                                                               LineBreakMode="WordWrap" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.ChevronDown}"
                                                               TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Rotation" Value="180" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Grid>
                                                    <Label Text="{Binding Answer}" FontSize="13.5" LineHeight="1.4"
                                                           TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap"
                                                           Padding="16,0,16,16" Margin="0,-4,0,0" IsVisible="{Binding IsExpanded}" />
                                                    <BoxView Style="{StaticResource Divider.Inset}" Margin="16,0,0,0" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Nothing matched the search -->
                <VerticalStackLayout IsVisible="{Binding NoResults}" Spacing="12" Padding="16,8">
                    <Border Style="{StaticResource EmptyIcon}">
                        <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.SearchX}" TextColor="{DynamicResource tp-accent-text}" />
                    </Border>
                    <Label Text="{x:Static res:AppResources.Help_NoResults}" Style="{StaticResource Text.EmptyText}" />
                    <Button Text="{x:Static res:AppResources.Help_ClearSearch}" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource Btn.Secondary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- ════════ Contact (TP-105: centred card like the prototype) ════════ -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{x:Static res:AppResources.Help_ContactTitle}" FontFamily="InterSemiBold" FontSize="15" TextColor="{DynamicResource tp-text}"
                               HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{x:Static res:AppResources.Help_ContactShort}" FontSize="13" TextColor="{DynamicResource tp-text-3}" HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Button Text="{x:Static res:AppResources.Help_WriteToUs}" Command="{Binding ContactCommand}" Style="{StaticResource Btn.Primary}"
                                HorizontalOptions="Center" Margin="0,12,0,0" Padding="20,0" ContentLayout="Left,8">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Mail}" Size="16" Color="{DynamicResource tp-on-primary}" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <!-- ════════ Legal documents ════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.Profile_Legal}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <controls:ListRow Icon="{StaticResource Ic.ShieldPlain}" Tone="info" Title="{x:Static res:AppResources.Privacy_Title}"
                                              Command="{Binding OpenDocumentCommand}" CommandParameter="privacy" />
                            <BoxView Style="{StaticResource Divider.Inset}" />
                            <controls:ListRow Icon="{StaticResource Ic.FileText}" Tone="info" Title="{x:Static res:AppResources.Kvkk_Title}"
                                              Command="{Binding OpenDocumentCommand}" CommandParameter="kvkk" />
                            <BoxView Style="{StaticResource Divider.Inset}" />
                            <controls:ListRow Icon="{StaticResource Ic.BookOpen}" Tone="info" Title="{x:Static res:AppResources.Terms_Title}"
                                              Command="{Binding OpenDocumentCommand}" CommandParameter="terms" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
