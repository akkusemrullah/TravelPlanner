<?xml version="1.0" encoding="utf-8" ?>
<!--
    The app's legal documents: privacy policy, KVKK notice, terms of use, open-source licences.
    Route Routes.Privacy?doc=privacy|kvkk|terms|licenses (Helpers/LegalDocuments). The texts live in AppResources
    (Privacy_Body, Kvkk_Body …) with "## Heading" lines; the public copies are in docs/.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             x:Class="TravelPlanner.Views.PrivacyPage"
             x:DataType="vm:LegalDocumentViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.AppBarTitle}" Margin="0,0,44,0" LineBreakMode="TailTruncation" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- TP-105: the prototype's plain document - big title, date, numbered sections, a contact card at the end -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20,20,20,40" Spacing="0">
                <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="22" TextColor="{DynamicResource tp-text}" LineBreakMode="WordWrap"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding UpdatedText}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" Margin="0,4,0,0" />

                <VerticalStackLayout Spacing="20" Margin="0,20,0,0" BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="helpers:DocumentSection">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Heading}" FontFamily="InterSemiBold" FontSize="15" TextColor="{DynamicResource tp-text}" LineBreakMode="WordWrap"
                                       SemanticProperties.HeadingLevel="Level2"
                                       IsVisible="{Binding Heading, Converter={StaticResource StringNotEmptyConverter}}" />
                                <Label Text="{Binding Body}" FontSize="14" LineHeight="1.4" TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap"
                                       IsVisible="{Binding Body, Converter={StaticResource StringNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Questions about the document -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowContact}" Margin="0,32,0,0">
                    <VerticalStackLayout Spacing="0">
                        <Label FontSize="13.5" TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span TextColor="{DynamicResource tp-text-2}" Text="{x:Static res:AppResources.Legal_QuestionsTitle}" />
                                    <Span TextColor="{DynamicResource tp-text-2}" Text=" " />
                                    <Span TextColor="{DynamicResource tp-text-2}" Text="{x:Static res:AppResources.Legal_QuestionsHint}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="{x:Static res:AppResources.Help_WriteToUs}" Command="{Binding ContactCommand}" Style="{StaticResource Btn.Primary.Sm}"
                                HorizontalOptions="Start" Margin="0,12,0,0" ContentLayout="Left,6">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Mail}" Size="15" Color="{DynamicResource tp-on-primary}" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
