<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             x:Class="TravelPlanner.Views.PrivacyPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Privacy_Title}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,20,16,28" Spacing="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Style="{StaticResource IconTile}">
                        <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Shield}" />
                    </Border>
                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Privacy_Title}" Style="{StaticResource Text.H2}" VerticalOptions="Center" />
                </Grid>
                <Border Style="{StaticResource Card}" Padding="20">
                    <Label Text="{x:Static res:AppResources.Privacy_Body}" Style="{StaticResource Text.Body}" FontSize="14" LineHeight="1.4"
                           TextColor="{DynamicResource tp-text-2}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
