<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:sync="clr-namespace:TravelPlanner.Services.Sync"
             x:Class="TravelPlanner.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- Tab root (Profile): a short hub. The profile/account card on top, then a few menu rows - each with its own
         icon colour so they are told apart at a glance. The settings themselves live on the Tercihler page
         (PreferencesPage), the legal documents and backup actions behind one row each. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ════════ Header ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Label Text="{x:Static res:AppResources.Nav_Profile}" Style="{StaticResource Text.H1}" SemanticProperties.HeadingLevel="Level1" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,16,16,120" Spacing="20"> <!-- bottom: room for the floating menu -->

                <!-- ════════ Profile + account card (TP-105: the prototype's card) ════════ -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Grid Grid.Column="0" WidthRequest="60" HeightRequest="60">
                                <controls:Avatar Name="{Binding UserName}" Size="60" IsVisible="{Binding HasInitials}" />
                                <Border IsVisible="{Binding HasInitials, Converter={StaticResource InvertBoolConverter}}" WidthRequest="60" HeightRequest="60"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 30" BackgroundColor="{DynamicResource tp-surface-alt}">
                                    <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.UserPlain}" FontSize="28" TextColor="{DynamicResource tp-text-3}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}" FontFamily="InterBold" FontSize="18" TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Style="{StaticResource Icon}" FontSize="14" Text="{StaticResource Ic.Cloud}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsGuest}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource Ic.WifiOff}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding AccountTitle}" FontSize="13" TextColor="{DynamicResource tp-text-3}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Guest: what an account adds, then "Giriş yap" and "Hesap oluştur" side by side. -->
                        <Label Text="{Binding AccountSubtitle}" FontSize="13.5" LineHeight="1.35" TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap"
                               IsVisible="{Binding IsGuest}" Margin="0,12,0,0" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsGuest}" Margin="0,12,0,0">
                            <Button Grid.Column="0" Text="{x:Static res:AppResources.Auth_SignIn}" Command="{Binding OpenSignInCommand}" Style="{StaticResource Btn.Primary}" />
                            <Button Grid.Column="1" Text="{x:Static res:AppResources.Auth_CreateAccount}" Command="{Binding OpenSignUpCommand}" Style="{StaticResource Btn.Secondary}" />
                        </Grid>

                        <!-- Signed in: sync status (coloured dot) + manual sync (G4). -->
                        <Border IsVisible="{Binding IsSignedIn}" BackgroundColor="{DynamicResource tp-surface-alt}" Stroke="Transparent"
                                StrokeShape="RoundRectangle 12" Padding="12" Margin="0,16,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Grid Grid.Column="0" VerticalOptions="Center">
                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{DynamicResource tp-accent}" IsVisible="{Binding IsSyncing, Converter={StaticResource InvertBoolConverter}}">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding SyncState}" Value="{x:Static sync:SyncStatus.UpToDate}">
                                                <Setter Property="Color" Value="{DynamicResource tp-success}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding SyncState}" Value="{x:Static sync:SyncStatus.Offline}">
                                                <Setter Property="Color" Value="{DynamicResource tp-warning}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding SyncState}" Value="{x:Static sync:SyncStatus.Error}">
                                                <Setter Property="Color" Value="{DynamicResource tp-danger}" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                    <controls:LoadingDots IsVisible="{Binding IsSyncing}" DotSize="6" DotColor="{DynamicResource tp-accent}" />
                                </Grid>
                                <Label Grid.Column="1" Text="{Binding SyncStatusText}" FontSize="13.5" TextColor="{DynamicResource tp-text-2}" VerticalOptions="Center"
                                       LineBreakMode="WordWrap" />
                                <Button Grid.Column="2" Text="{x:Static res:AppResources.Sync_Now}" Command="{Binding SyncNowCommand}" Style="{StaticResource Btn.Soft.Sm}"
                                        ContentLayout="Left,6" VerticalOptions="Center">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Refresh}" Size="15" Color="{DynamicResource tp-accent-text}" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ════════ App ════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{helpers:Upper Profile_App}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <controls:ListRow Icon="{StaticResource Ic.Settings2}" Title="{x:Static res:AppResources.Profile_Preferences}"
                                              Subtitle="{Binding PreferencesSummary}" Command="{Binding OpenPreferencesCommand}" />
                            <!-- G6: join a trip someone shared -->
                            <BoxView Style="{StaticResource Divider.Inset}" IsVisible="{Binding IsSignedIn}" />
                            <controls:ListRow Icon="{StaticResource Ic.Ticket}" Title="{x:Static res:AppResources.Join_Title}" IsVisible="{Binding IsSignedIn}"
                                              Subtitle="{x:Static res:AppResources.Profile_JoinHint}" Command="{Binding JoinTripCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ Data ════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{helpers:Upper Profile_Data}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <!-- G6: deleted items, restorable for 30 days - the red count so it is noticed. -->
                            <controls:ListRow Icon="{StaticResource Ic.Trash}" Tone="neutral" Title="{x:Static res:AppResources.Trash_Title}"
                                              Subtitle="{Binding TrashSubtitle}" Command="{Binding OpenTrashCommand}">
                                <Border Style="{StaticResource CountPill}" IsVisible="{Binding HasTrash}">
                                    <Label Text="{Binding TrashCount}" FontFamily="InterBold" FontSize="11.5" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </controls:ListRow>
                            <BoxView Style="{StaticResource Divider.Inset}" />
                            <!-- TP-502: export / restore behind one row -->
                            <controls:ListRow Icon="{StaticResource Ic.Archive}" Tone="neutral" Title="{x:Static res:AppResources.Backup_Title}"
                                              Subtitle="{x:Static res:AppResources.Profile_BackupHint}" Command="{Binding OpenBackupCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ Support & legal ════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{helpers:Upper Profile_Support}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <controls:ListRow Icon="{StaticResource Ic.LifeBuoy}" Tone="info" Title="{x:Static res:AppResources.Help_Title}"
                                              Subtitle="{x:Static res:AppResources.Help_RowHint}" Command="{Binding OpenHelpCenterCommand}" />
                            <BoxView Style="{StaticResource Divider.Inset}" />
                            <!-- TP-93: the first-start tour again -->
                            <controls:ListRow Icon="{StaticResource Ic.Layers}" Tone="info" Title="{x:Static res:AppResources.Profile_ShowTour}"
                                              Subtitle="{x:Static res:AppResources.Profile_ShowTourHint}" Command="{Binding ShowTourCommand}" />
                            <BoxView Style="{StaticResource Divider.Inset}" />
                            <controls:ListRow Icon="{StaticResource Ic.Mail}" Tone="info" Title="{x:Static res:AppResources.Help_ContactRow}"
                                              Subtitle="{Binding SupportEmail}" Command="{Binding ContactSupportCommand}" />
                            <BoxView Style="{StaticResource Divider.Inset}" />
                            <!-- Legal & privacy (Google Play: privacy policy reachable in the app): one row, a sheet of documents -->
                            <controls:ListRow Icon="{StaticResource Ic.ShieldPlain}" Tone="info" Title="{x:Static res:AppResources.Profile_Legal}"
                                              Subtitle="{x:Static res:AppResources.Profile_LegalHint}" Command="{Binding OpenLegalCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ Account actions (signed in) - last, apart from everything else ════════ -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSignedIn}">
                    <Label Text="{helpers:Upper Profile_Account}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <controls:ListRow Icon="{StaticResource Ic.LogOut}" Tone="neutral" Title="{x:Static res:AppResources.Account_SignOut}" IsVisible="{Binding CanDeleteAccount}"
                                              Subtitle="{x:Static res:AppResources.Profile_SignOutHint}" Command="{Binding SignOutCommand}" />
                            <BoxView Style="{StaticResource Divider.Inset}" IsVisible="{Binding CanDeleteAccount}" />
                            <!-- G7: delete the account for good (online only) -->
                            <controls:ListRow Icon="{StaticResource Ic.UserX}" IsDanger="True" Title="{x:Static res:AppResources.Account_Delete}" IsVisible="{Binding CanDeleteAccount}"
                                              Subtitle="{x:Static res:AppResources.Profile_DeleteHint}" Command="{Binding DeleteAccountCommand}" />
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Padding="0,14" IsVisible="{Binding IsDeletingAccount}">
                                <controls:LoadingDots IsVisible="{Binding IsDeletingAccount}" DotSize="6" DotColor="{DynamicResource tp-danger}" />
                                <Label Text="{x:Static res:AppResources.Account_Deleting}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ About: one quiet footer instead of a card ════════ -->
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="0"
                            BackgroundColor="{StaticResource BrandRoyal}" HorizontalOptions="Center" Margin="0,0,0,8">
                        <controls:LogoMark Size="28" PinColor="White" PlaneColor="{StaticResource BrandRoyal}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text-2}" HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span TextColor="{DynamicResource tp-text-2}" Text="{x:Static res:AppResources.About_Developer}" />
                                <Span TextColor="{DynamicResource tp-text-2}" Text=" · " />
                                <Span TextColor="{DynamicResource tp-text-2}" Text="EAKSOFT" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{Binding VersionText}" FontSize="12" TextColor="{DynamicResource tp-text-3}" HorizontalOptions="Center" />
                    <Label Text="{Binding CopyrightText}" FontSize="12" TextColor="{DynamicResource tp-text-3}" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ════════ TP-106: floating bottom menu ════════ -->
        <controls:FloatingTabBar Grid.RowSpan="3" Current="Settings" />
    </Grid>
</ContentPage>
