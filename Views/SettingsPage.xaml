<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Tab root (Profile): a short hub. The profile/account card on top, then a few menu rows - each with its own
         icon colour so they are told apart at a glance. The settings themselves live on the Tercihler page
         (PreferencesPage), the legal documents and backup actions behind one row each. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ════════ Header ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Label Text="{x:Static res:AppResources.Nav_Profile}" Style="{StaticResource Text.H1}" SemanticProperties.HeadingLevel="Level1" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,20,16,28" Spacing="22">

                <!-- ════════ Profile + account card ════════ -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="56" HeightRequest="56" Padding="0" StrokeShape="RoundRectangle 28"
                                    Stroke="Transparent" BackgroundColor="{DynamicResource tp-primary}">
                                <Grid>
                                    <Label Text="{Binding Initials}" IsVisible="{Binding HasInitials}" FontFamily="InterSemiBold" FontSize="20"
                                           TextColor="{DynamicResource tp-on-primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Label IsVisible="{Binding HasInitials, Converter={StaticResource InvertBoolConverter}}" Style="{StaticResource Icon}"
                                           Text="{StaticResource Ic.User}" FontSize="26" TextColor="{DynamicResource tp-on-primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}" Style="{StaticResource Text.H3}" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Cloud}" TextColor="{DynamicResource tp-text-3}" />
                                    <Label Text="{Binding AccountTitle}" Style="{StaticResource Text.Caption}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Guest: one clear call to action. -->
                        <Label Text="{Binding AccountSubtitle}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" IsVisible="{Binding IsGuest}" />
                        <Button Text="{x:Static res:AppResources.Account_SignInOrCreate}" Command="{Binding OpenSignInCommand}"
                                Style="{StaticResource Btn.Primary.Sm}" HeightRequest="40" IsVisible="{Binding IsGuest}" />

                        <!-- Signed in: sync status + manual sync (G4). -->
                        <Border IsVisible="{Binding IsSignedIn}" BackgroundColor="{DynamicResource tp-surface-alt}" Stroke="Transparent"
                                StrokeShape="RoundRectangle 10" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <controls:LoadingDots IsVisible="{Binding IsSyncing}" DotSize="6" DotColor="{DynamicResource tp-primary}" />
                                    <Label Text="{Binding SyncStatusText}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{x:Static res:AppResources.Sync_Now}" Style="{StaticResource Text.Link}" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SyncNowCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ════════ App ════════ -->
                <Border Style="{StaticResource Card.List}">
                    <VerticalStackLayout Spacing="0">
                        <!-- Tercihler: name, currency, reminder, theme, language -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="60"
                              SemanticProperties.Description="{x:Static res:AppResources.Profile_Preferences}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPreferencesCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Style="{StaticResource IconTile.Tint}">
                                <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Sliders}" TextColor="{DynamicResource tp-accent-text}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{x:Static res:AppResources.Profile_Preferences}" Style="{StaticResource Text.Title}" />
                                <Label Text="{Binding PreferencesSummary}" Style="{StaticResource Text.Caption}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                        </Grid>
                        <!-- G6: join a trip someone shared -->
                        <BoxView Style="{StaticResource Divider.Inset}" Margin="62,0,0,0" IsVisible="{Binding IsSignedIn}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="60" IsVisible="{Binding IsSignedIn}"
                              SemanticProperties.Description="{x:Static res:AppResources.Join_Title}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding JoinTripCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Style="{StaticResource IconTile.Info}">
                                <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Users}" TextColor="{DynamicResource tp-info}" />
                            </Border>
                            <Label Grid.Column="1" Text="{x:Static res:AppResources.Join_Title}" Style="{StaticResource Text.Title}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ════════ Data ════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.Profile_Data}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <!-- G6: deleted items, restorable for 30 days - red tile + count so it is noticed. -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="60"
                                  SemanticProperties.Description="{x:Static res:AppResources.Trash_Title}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTrashCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Danger}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Delete}" TextColor="{DynamicResource tp-danger}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.Trash_Title}" Style="{StaticResource Text.Title}" />
                                    <Label Text="{Binding TrashSubtitle}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource CountPill}" IsVisible="{Binding HasTrash}">
                                    <Label Text="{Binding TrashCount}" FontFamily="InterSemiBold" FontSize="12" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="3" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider.Inset}" Margin="62,0,0,0" />
                            <!-- TP-502: export / restore behind one row -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="60"
                                  SemanticProperties.Description="{x:Static res:AppResources.Backup_Title}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenBackupCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Success}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Download}" TextColor="{DynamicResource tp-success}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.Backup_Title}" Style="{StaticResource Text.Title}" />
                                    <Label Text="{x:Static res:AppResources.Profile_BackupHint}" Style="{StaticResource Text.Caption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ Support & legal ════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.Profile_Support}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="60"
                                  SemanticProperties.Description="{x:Static res:AppResources.Help_Title}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenHelpCenterCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Warning}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Compass}" TextColor="{DynamicResource tp-warning}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.Help_Title}" Style="{StaticResource Text.Title}" />
                                    <Label Text="{x:Static res:AppResources.Help_RowHint}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider.Inset}" Margin="62,0,0,0" />
                            <!-- TP-93: the first-start tour again -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="60"
                                  SemanticProperties.Description="{x:Static res:AppResources.Profile_ShowTour}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowTourCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Success}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Layers}" TextColor="{DynamicResource tp-success}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.Profile_ShowTour}" Style="{StaticResource Text.Title}" />
                                    <Label Text="{x:Static res:AppResources.Profile_ShowTourHint}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider.Inset}" Margin="62,0,0,0" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="60"
                                  SemanticProperties.Description="{x:Static res:AppResources.Help_ContactRow}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ContactSupportCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Info}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Notebook}" TextColor="{DynamicResource tp-info}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.Help_ContactRow}" Style="{StaticResource Text.Title}" />
                                    <Label Text="{Binding SupportEmail}" Style="{StaticResource Text.Caption}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider.Inset}" Margin="62,0,0,0" />
                            <!-- Legal & privacy (Google Play: privacy policy reachable in the app): one row, a sheet of documents -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="60"
                                  SemanticProperties.Description="{x:Static res:AppResources.Profile_Legal}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenLegalCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Tint}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Lock}" TextColor="{DynamicResource tp-accent-text}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.Profile_Legal}" Style="{StaticResource Text.Title}" />
                                    <Label Text="{x:Static res:AppResources.Profile_LegalHint}" Style="{StaticResource Text.Caption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-text-3}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ Account actions (signed in) - last, apart from everything else ════════ -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSignedIn}">
                    <Label Text="{x:Static res:AppResources.Profile_Account}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                    <Border Style="{StaticResource Card.List}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="56" IsVisible="{Binding CanDeleteAccount}"
                                  SemanticProperties.Description="{x:Static res:AppResources.Account_SignOut}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SignOutCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Tint}" BackgroundColor="{DynamicResource tp-surface-alt}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ArrowRight}" TextColor="{DynamicResource tp-text-2}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.Account_SignOut}" Style="{StaticResource Text.Title}" />
                                    <Label Text="{x:Static res:AppResources.Profile_SignOutHint}" Style="{StaticResource Text.Caption}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource Divider.Inset}" Margin="62,0,0,0" IsVisible="{Binding CanDeleteAccount}" />
                            <!-- G7: delete the account for good (two confirmations, online only) -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,10" MinimumHeightRequest="56" IsVisible="{Binding CanDeleteAccount}"
                                  SemanticProperties.Description="{x:Static res:AppResources.Account_Delete}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource IconTile.Danger}">
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{x:Static res:AppResources.Account_Delete}" Style="{StaticResource Text.Title}" TextColor="{DynamicResource tp-danger}" />
                                    <Label Text="{x:Static res:AppResources.Profile_DeleteHint}" Style="{StaticResource Text.Caption}" />
                                </VerticalStackLayout>
                            </Grid>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Padding="0,14" IsVisible="{Binding IsDeletingAccount}">
                                <controls:LoadingDots IsVisible="{Binding IsDeletingAccount}" DotSize="6" DotColor="{DynamicResource tp-danger}" />
                                <Label Text="{x:Static res:AppResources.Account_Deleting}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════ About: one quiet footer instead of a card ════════ -->
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,4,0,0">
                    <Label Style="{StaticResource Text.Caption}" HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static res:AppResources.About_Developer}" />
                                <Span Text=" · " />
                                <Span Text="EAKSOFT" FontFamily="InterSemiBold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" HorizontalOptions="Center" />
                    <Label Text="{Binding CopyrightText}" Style="{StaticResource Text.Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
