<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.PlaceListPage"
             x:DataType="vm:PlaceListViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Section_Places}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
            <Border Grid.Column="2" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Delete}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <Grid Grid.Row="2">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadPlacesCommand}" IsVisible="{Binding HasPlaces}">
                <CollectionView x:Name="PlacesCollectionView" ItemsSource="{Binding Places}">
                    <CollectionView.Header>
                        <BoxView HeightRequest="16" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="96" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Place">
                                <Border Style="{StaticResource Card.Compact}" Margin="16,0" HorizontalOptions="Fill">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                            <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceListViewModel}}, Path=PlaceTappedCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}">
                                            <Grid>
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Pin}"
                                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceListViewModel}}, Path=Selection.IsInactive}" />
                                                <!-- Selection mode: the tile shows the tick. -->
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Circle}" TextColor="{DynamicResource tp-text-3}"
                                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceListViewModel}}, Path=Selection.IsActive}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Text" Value="{StaticResource Ic.CheckCircle}" />
                                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource Text.Title}" />
                                            <Label Text="{Binding IsVisited, Converter={StaticResource VisitedTextConverter}}" Style="{StaticResource Text.Caption}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsVisited}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource tp-success}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding Description}" Style="{StaticResource Text.Body2}" FontSize="13" LineBreakMode="TailTruncation"
                                                   IsVisible="{Binding Description, Converter={StaticResource StringNotEmptyConverter}}" />
                                        </VerticalStackLayout>
                                        <!-- Visited toggle: icon only, so long place names keep the row's width.
                                             The status is also spelled out under the name. -->
                                        <Border Grid.Column="2" Style="{StaticResource IconButton.Outlined}" WidthRequest="40" HeightRequest="40"
                                                SemanticProperties.Description="{Binding IsVisited, Converter={StaticResource VisitedTextConverter}}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceListViewModel}}, Path=Selection.IsInactive}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceListViewModel}}, Path=ToggleVisitedCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsVisited}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource tp-success-soft}" />
                                                    <Setter Property="Stroke" Value="Transparent" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Circle}" TextColor="{DynamicResource tp-text-3}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsVisited}" Value="True">
                                                        <Setter Property="Text" Value="{StaticResource Ic.CheckCircle}" />
                                                        <Setter Property="TextColor" Value="{DynamicResource tp-success}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>
                                </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoPlaces}" Spacing="14" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.MapPinned}" TextColor="{DynamicResource tp-text-2}" />
                </Border>
                <Label Text="{x:Static res:AppResources.PlaceList_Empty}" Style="{StaticResource EmptyStateTextLabel}" />
                <!-- TP-80: one tap to the first entry -->
                <Button Text="{x:Static res:AppResources.PlaceList_AddFirst}" Command="{Binding GoToAddPlaceCommand}"
                        IsVisible="{Binding CanEdit}" Style="{StaticResource Btn.Primary.Sm}" HorizontalOptions="Center" />
            </VerticalStackLayout>

        <Border Style="{StaticResource Fab}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Add}" IsVisible="{Binding ShowAddButton}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToAddPlaceCommand}" />
            </Border.GestureRecognizers>
            <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-accent}" />
        </Border>
        </Grid>
    </Grid>
</ContentPage>
