<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.ExpenseListPage"
             x:DataType="vm:ExpenseListViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Section_Expenses}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
            <!-- Expense export: every expense of the trip as a CSV file for Excel / Google Sheets. -->
            <Border Grid.Column="2" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.ExpenseList_Export}"
                    ToolTipProperties.Text="{x:Static res:AppResources.ExpenseList_Export}" IsVisible="{Binding ShowExport}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExportCsvCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.FileDown}" />
            </Border>
            <Border Grid.Column="3" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.Section_Analysis}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAnalysisCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.PieChart}" />
            </Border>
            <Border Grid.Column="4" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Delete}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- ════════ Summary + filter ════════ -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" Padding="16,16,16,4">
            <VerticalStackLayout Spacing="2">
                <Label Text="{x:Static res:AppResources.Dashboard_TotalExpenses}" Style="{StaticResource Text.Overline}" />
                <Label Text="{Binding TotalExpensesFormatted}" Style="{StaticResource Text.H1}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Input}" MinimumHeightRequest="44" Padding="12,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Label Grid.Column="0" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Filter}" TextColor="{DynamicResource tp-text-3}" />
                    <Picker Grid.Column="1" x:DataType="{x:Null}" Title="{x:Static res:AppResources.ExpenseList_FilterTitle}"
                            ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter}"
                            FontSize="14">
                        <Picker.ItemDisplayBinding>
                            <Binding Converter="{StaticResource ExpenseCategoryDisplayConverter}" />
                        </Picker.ItemDisplayBinding>
                    </Picker>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="3">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadExpensesCommand}" IsVisible="{Binding HasExpenses}">
                <CollectionView x:Name="ExpensesCollectionView" ItemsSource="{Binding Expenses}">
                    <CollectionView.Header>
                        <BoxView HeightRequest="12" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="96" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Expense">
                                <Border Style="{StaticResource Card.Compact}" Margin="16,0" HorizontalOptions="Fill">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                            <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpenseListViewModel}}, Path=ExpenseTappedCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}">
                                            <Grid>
                                                <Label Style="{StaticResource Icon}" Text="{Binding Category, Converter={StaticResource CategoryGlyphConverter}}"
                                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpenseListViewModel}}, Path=Selection.IsInactive}" />
                                                <!-- Selection mode: the tile shows the tick. -->
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Circle}" TextColor="{DynamicResource tp-text-3}"
                                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpenseListViewModel}}, Path=Selection.IsActive}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Text" Value="{StaticResource Ic.CheckCircle}" />
                                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Category, Converter={StaticResource ExpenseCategoryDisplayConverter}}" Style="{StaticResource Text.Title}" FontSize="14" />
                                            <Label Text="{Binding Description}" Style="{StaticResource Text.Body2}" FontSize="13" LineBreakMode="TailTruncation"
                                                   IsVisible="{Binding Description, Converter={StaticResource StringNotEmptyConverter}}" />
                                            <Label Text="{Binding Date, StringFormat='{0:d MMM yyyy}'}" Style="{StaticResource Text.Caption}" />
                                            <Label Text="{Binding FormattedOriginalAmount, StringFormat={x:Static res:AppResources.Expense_ConvertedFromFormat}}"
                                                   IsVisible="{Binding IsConverted}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding FormattedAmount}" HorizontalOptions="End" Style="{StaticResource Text.Value}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoExpenses}" Spacing="14" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Receipt}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.ExpenseList_Empty}" Style="{StaticResource EmptyStateTextLabel}" />
                <!-- TP-80: one tap to the first entry -->
                <Button Text="{x:Static res:AppResources.ExpenseList_AddFirst}" Command="{Binding GoToAddExpenseCommand}"
                        IsVisible="{Binding CanEdit}" Style="{StaticResource Btn.Primary.Sm}" HorizontalOptions="Center" />
            </VerticalStackLayout>

        <Border Style="{StaticResource Fab}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Add}" IsVisible="{Binding ShowAddButton}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToAddExpenseCommand}" />
            </Border.GestureRecognizers>
            <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-accent}" />
        </Border>
        </Grid>
    </Grid>
</ContentPage>
