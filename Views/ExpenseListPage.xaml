<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.ExpenseListPage"
             x:DataType="vm:ExpenseListViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" Margin="4,0,0,0">
                <Label Text="{x:Static res:AppResources.Section_Expenses}" Style="{StaticResource Text.AppBarTitle}" />
                <Label Text="{Binding TripName}" Style="{StaticResource Text.Caption}" LineBreakMode="TailTruncation"
                       IsVisible="{Binding TripName, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>
            <!-- Expense export: every expense of the trip as a CSV file for Excel / Google Sheets. -->
            <Border Grid.Column="2" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.ExpenseList_Export}"
                    ToolTipProperties.Text="{x:Static res:AppResources.ExpenseList_Export}" IsVisible="{Binding ShowExport}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExportCsvCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.FileDown}" />
            </Border>
            <Border Grid.Column="3" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.Section_Analysis}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAnalysisCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.PieChart}" />
            </Border>
            <Border Grid.Column="4" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Delete}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- ════════ Summary + filter (TP-104: the prototype's two cards + category chips) ════════ -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" Padding="16,16,16,0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{x:Static res:AppResources.ExpenseList_Mine}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                        <Label Text="{Binding MyTotalFormatted}" FontFamily="InterBold" FontSize="19" TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{x:Static res:AppResources.ExpenseList_AllTotal}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                        <Label Text="{Binding AllTotalFormatted}" FontFamily="InterBold" FontSize="19" TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static res:AppResources.ExpenseList_FilterTitle}" FontFamily="InterSemiBold" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" Margin="4,0" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-16,0">
                    <HorizontalStackLayout Spacing="8" Padding="16,0,16,4" BindableLayout.ItemsSource="{Binding CategoryFilters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpenseCategoryFilterOption">
                                <Border Style="{StaticResource Chip}" SemanticProperties.Description="{Binding Label}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource tp-primary}" />
                                            <Setter Property="Stroke" Value="{DynamicResource tp-primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpenseListViewModel}}, Path=SelectCategoryFilterCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Style="{StaticResource Icon}" FontSize="15" Text="{Binding Glyph}" TextColor="{DynamicResource tp-text-2}" VerticalOptions="Center"
                                               IsVisible="{Binding IsAll, Converter={StaticResource InvertBoolConverter}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Label}" FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource tp-text-2}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="3">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadExpensesCommand}" IsVisible="{Binding HasExpenses}">
                <CollectionView x:Name="ExpensesCollectionView" ItemsSource="{Binding Expenses}">
                    <CollectionView.Header>
                        <BoxView HeightRequest="12" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="96" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Expense">
                            <!-- one slice of the list card (Helpers/ListPositions) -->
                            <Border BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0"
                                    StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}"
                                    Margin="{Binding ListPosition, Converter={StaticResource ListPositionMarginConverter}}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Padding="16,12" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpenseListViewModel}}, Path=ExpenseTappedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <controls:SelectCircle Grid.Column="0" IsOn="{Binding IsSelected}" VerticalOptions="Center" Margin="0,0,12,0"
                                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpenseListViewModel}}, Path=Selection.IsActive}" />
                                    <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center"
                                            BackgroundColor="{Binding Category, Converter={StaticResource CategoryColorConverter}, ConverterParameter=Soft}">
                                        <Label Style="{StaticResource Icon}" FontSize="19"
                                               Text="{Binding Category, Converter={StaticResource CategoryGlyphConverter}}"
                                               TextColor="{Binding Category, Converter={StaticResource CategoryColorConverter}}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center" Margin="12,0">
                                        <Label Text="{Binding DisplayTitle}" FontFamily="InterMedium" FontSize="14.5" TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding MetaLine}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding FormattedAmount}" HorizontalOptions="End" FontFamily="InterSemiBold" FontSize="14.5" TextColor="{DynamicResource tp-text}" />
                                        <Label Text="{Binding FormattedOriginalAmount, StringFormat={x:Static res:AppResources.Expense_ConvertedFromFormat}}" HorizontalOptions="End"
                                               IsVisible="{Binding IsConverted}" FontSize="11" TextColor="{DynamicResource tp-text-3}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoExpenses}" Spacing="12" Padding="32,24" VerticalOptions="Start">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Wallet}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.ExpenseList_Empty}" Style="{StaticResource Text.EmptyText}" />
                <!-- TP-80: one tap to the first entry -->
                <Button Text="{x:Static res:AppResources.ExpenseList_AddFirst}" Command="{Binding GoToAddExpenseCommand}"
                        IsVisible="{Binding CanEdit}" Style="{StaticResource Btn.Primary}" HorizontalOptions="Center" ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Plus}" Size="18" Color="{DynamicResource tp-on-primary}" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>

            <Border Style="{StaticResource Fab}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Add}" IsVisible="{Binding ShowAddButton}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAddExpenseCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" FontSize="26" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-accent}" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
