<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:services="clr-namespace:TravelPlanner.Services"
             x:Class="TravelPlanner.Views.PreferencesPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- Profil → Tercihler: name, currency, reminder time, theme and language, with a sticky Save bar.
         The theme applies as soon as it is picked; everything else on Save. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Profile_Preferences}" Style="{StaticResource Text.AppBarTitle}" Margin="0,0,44,0" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- TP-105: the prototype's form - plain fields with hints, theme as three tiles, language as a segment -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,16,16,32" Spacing="20">

                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.Settings_NameLabel}" Style="{StaticResource Text.Field}" />
                        <Label Grid.Column="1" Text="{Binding UserName.Length, StringFormat='{0}/40'}" Style="{StaticResource Text.Counter}" />
                    </Grid>
                    <Border Style="{StaticResource Input}">
                        <Entry Text="{Binding UserName}" Placeholder="{x:Static res:AppResources.Settings_NamePlaceholder}" MaxLength="40" Keyboard="{x:Static helpers:AppKeyboards.Words}" />
                    </Border>
                    <Label Text="{x:Static res:AppResources.Settings_NameHint}" Style="{StaticResource Text.Hint}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:AppResources.Settings_CurrencyLabel}" Style="{StaticResource Text.Field}" />
                    <Border Style="{StaticResource Input}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" Title="{x:Static res:AppResources.Settings_CurrencyLabel}" />
                            <Label Grid.Column="1" Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.ChevronDown}" InputTransparent="True" />
                        </Grid>
                    </Border>
                    <Label Text="{x:Static res:AppResources.Settings_CurrencyHint}" Style="{StaticResource Text.Hint}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:AppResources.Settings_ReminderLabel}" Style="{StaticResource Text.Field}" />
                    <Border Style="{StaticResource Input}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker ItemsSource="{Binding ReminderHours}" SelectedItem="{Binding SelectedReminderHour}" Title="{x:Static res:AppResources.Settings_ReminderLabel}" />
                            <Label Grid.Column="1" Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.ChevronDown}" InputTransparent="True" />
                        </Grid>
                    </Border>
                    <Label Text="{x:Static res:AppResources.Settings_ReminderHint}" Style="{StaticResource Text.Hint}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:AppResources.Settings_ThemeLabel}" Style="{StaticResource Text.Field}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" HeightRequest="76" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-surface}"
                                Stroke="{DynamicResource tp-border}" SemanticProperties.Description="{x:Static res:AppResources.Theme_System}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.System}">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                    <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static services:AppThemeOption.System}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Style="{StaticResource Icon}" FontSize="22" Text="{StaticResource Ic.Monitor}" TextColor="{DynamicResource tp-text-2}" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.System}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent-text}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{x:Static res:AppResources.Theme_System}" FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource tp-text-2}" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.System}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent-text}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" HeightRequest="76" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-surface}"
                                Stroke="{DynamicResource tp-border}" SemanticProperties.Description="{x:Static res:AppResources.Theme_Light}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.Light}">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                    <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static services:AppThemeOption.Light}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Style="{StaticResource Icon}" FontSize="22" Text="{StaticResource Ic.Sun}" TextColor="{DynamicResource tp-text-2}" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.Light}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent-text}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{x:Static res:AppResources.Theme_Light}" FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource tp-text-2}" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.Light}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent-text}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" HeightRequest="76" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-surface}"
                                Stroke="{DynamicResource tp-border}" SemanticProperties.Description="{x:Static res:AppResources.Theme_Dark}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.Dark}">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                    <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static services:AppThemeOption.Dark}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Style="{StaticResource Icon}" FontSize="22" Text="{StaticResource Ic.Moon}" TextColor="{DynamicResource tp-text-2}" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.Dark}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent-text}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{x:Static res:AppResources.Theme_Dark}" FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource tp-text-2}" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedTheme.Value}" Value="{x:Static services:AppThemeOption.Dark}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent-text}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Label Text="{x:Static res:AppResources.Settings_ThemeHint}" Style="{StaticResource Text.Hint}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:AppResources.Settings_LanguageLabel}" Style="{StaticResource Text.Field}" />
                    <Border BackgroundColor="{DynamicResource tp-surface-sunken}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="3">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">
                            <Border Grid.Column="0" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="Transparent"
                                    SemanticProperties.Description="{x:Static res:AppResources.Language_System}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedLanguage.Value}" Value="{x:Static services:AppLanguages.System}">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource tp-surface}" />
                                        <Setter Property="Shadow">
                                            <Shadow Brush="Black" Opacity="0.08" Radius="3" Offset="0,1" />
                                        </Setter>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectLanguageCommand}" CommandParameter="{x:Static services:AppLanguages.System}" />
                                </Border.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.Language_System}" FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource tp-text-2}"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedLanguage.Value}" Value="{x:Static services:AppLanguages.System}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-text}" />
                                            <Setter Property="FontFamily" Value="InterSemiBold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <Border Grid.Column="1" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="Transparent"
                                    SemanticProperties.Description="{x:Static res:AppResources.Language_Turkish}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedLanguage.Value}" Value="{x:Static services:AppLanguages.Turkish}">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource tp-surface}" />
                                        <Setter Property="Shadow">
                                            <Shadow Brush="Black" Opacity="0.08" Radius="3" Offset="0,1" />
                                        </Setter>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectLanguageCommand}" CommandParameter="{x:Static services:AppLanguages.Turkish}" />
                                </Border.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.Language_Turkish}" FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource tp-text-2}"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedLanguage.Value}" Value="{x:Static services:AppLanguages.Turkish}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-text}" />
                                            <Setter Property="FontFamily" Value="InterSemiBold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <Border Grid.Column="2" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="Transparent"
                                    SemanticProperties.Description="{x:Static res:AppResources.Language_English}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedLanguage.Value}" Value="{x:Static services:AppLanguages.English}">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource tp-surface}" />
                                        <Setter Property="Shadow">
                                            <Shadow Brush="Black" Opacity="0.08" Radius="3" Offset="0,1" />
                                        </Setter>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectLanguageCommand}" CommandParameter="{x:Static services:AppLanguages.English}" />
                                </Border.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.Language_English}" FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource tp-text-2}"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedLanguage.Value}" Value="{x:Static services:AppLanguages.English}">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-text}" />
                                            <Setter Property="FontFamily" Value="InterSemiBold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>
                    <Label Text="{x:Static res:AppResources.Settings_LanguageHint}" Style="{StaticResource Text.Hint}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ════════ Sticky save bar ════════ -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" BackgroundColor="{DynamicResource tp-surface}">
            <BoxView Grid.Row="0" Style="{StaticResource Divider}" />
            <VerticalStackLayout Grid.Row="1" Spacing="10" Padding="16,12,16,12">
                <Border IsVisible="{Binding ShowLanguageRestartHint}" Style="{StaticResource Banner.Warning}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-warning}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.Settings_LanguageHint}" FontSize="13" TextColor="{DynamicResource tp-warning}" />
                    </Grid>
                </Border>
                <Border IsVisible="{Binding ShowSavedHint}" Style="{StaticResource Banner.Info}" BackgroundColor="{DynamicResource tp-success-soft}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.CheckCircle}" TextColor="{DynamicResource tp-success}" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.Settings_Saved}" FontSize="13" TextColor="{DynamicResource tp-success}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Button Text="{x:Static res:AppResources.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource Btn.Primary}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
