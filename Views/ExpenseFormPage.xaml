<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             x:Class="TravelPlanner.Views.ExpenseFormPage"
             x:DataType="vm:ExpenseFormViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Close}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" Margin="0,0,44,0">
                <Label Text="{Binding PageTitle}" Style="{StaticResource Text.AppBarTitle}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding TripName}" Style="{StaticResource Text.Caption}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"
                       IsVisible="{Binding TripName, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <ScrollView Grid.Row="2">
            <!-- TP-104: the prototype's form - amount + currency side by side, category tiles, plain fields -->
            <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

                <Grid ColumnDefinitions="*,112" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="{x:Static res:AppResources.Expense_AmountLabel}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding Amount}" Keyboard="Numeric" MaxLength="16" Placeholder="0,00" FontFamily="InterBold" FontSize="20" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="{x:Static res:AppResources.Expense_CurrencyLabel}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- The narrow box shows the code; the list still shows the full names. -->
                                <Picker Grid.Column="0" x:DataType="{x:Null}" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" ItemDisplayBinding="{Binding Value}"
                                        Title="{x:Static res:AppResources.Expense_CurrencyLabel}" FontSize="15" />
                                <Label Grid.Column="1" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.ChevronDown}" TextColor="{DynamicResource tp-text-3}"
                                       VerticalOptions="Center" Margin="0,0,10,0" InputTransparent="True" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Border IsVisible="{Binding HasConversionPreview}" Style="{StaticResource Banner.Info}" Margin="0,-6,0,0">
                    <Label Text="{Binding ConversionPreview}" FontSize="13" TextColor="{DynamicResource tp-info}" />
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:AppResources.Expense_CategoryLabel}" Style="{StaticResource Text.Field}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding CategoryOptions}" Wrap="Wrap" JustifyContent="SpaceBetween">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpenseCategoryOption">
                                <Border FlexLayout.Basis="32%" HeightRequest="68" Margin="0,0,0,8" StrokeShape="RoundRectangle 12" StrokeThickness="1"
                                        Stroke="{DynamicResource tp-border}" BackgroundColor="{DynamicResource tp-surface}" SemanticProperties.Description="{Binding Label}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                            <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpenseFormViewModel}}, Path=SelectCategoryCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource Icon}" FontSize="20" HorizontalOptions="Center" Text="{Binding Glyph}"
                                               TextColor="{Binding Category, Converter={StaticResource CategoryColorConverter}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource tp-accent-text}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Label}" FontFamily="InterMedium" FontSize="12.5" HorizontalOptions="Center" TextColor="{DynamicResource tp-text-2}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource tp-accent-text}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:AppResources.Expense_DateLabel}" Style="{StaticResource Text.Field}" />
                    <Border Style="{StaticResource Input}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.Calendar}" />
                            <DatePicker Grid.Column="1" Date="{Binding Date}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
                <Border IsVisible="{Binding HasDateWarning}" Style="{StaticResource Banner.Warning}" Margin="0,-6,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-warning}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{Binding DateWarning}" FontSize="13" TextColor="{DynamicResource tp-warning}" />
                    </Grid>
                </Border>

                <!-- ════════ Split (only when the trip has participants) ════════ -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasParticipants}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static res:AppResources.Section_Split}" FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource tp-text}" />
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{x:Static res:AppResources.Split_PaidByLabel}" Style="{StaticResource Text.Field}" />
                            <Border Style="{StaticResource Input}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Picker Grid.Column="0" ItemsSource="{Binding PayerOptions}" SelectedItem="{Binding SelectedPayer}"
                                            Title="{x:Static res:AppResources.Split_PaidByLabel}" FontSize="15" />
                                    <Label Grid.Column="1" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.ChevronDown}" TextColor="{DynamicResource tp-text-3}"
                                           VerticalOptions="Center" Margin="0,0,12,0" InputTransparent="True" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsSplitting}" Spacing="2">
                            <Label Text="{x:Static res:AppResources.Split_SharedByLabel}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text-2}" Margin="0,0,0,4" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SplitParticipants}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SplitParticipantOption">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,6" MinimumHeightRequest="40" BackgroundColor="Transparent"
                                              SemanticProperties.Description="{Binding Name}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnParticipantTapped" />
                                            </Grid.GestureRecognizers>
                                            <controls:CheckMark Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="14.5" TextColor="{DynamicResource tp-text}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding ShareText}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ════════ Note ════════ -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.Common_DescriptionLabel}" Style="{StaticResource Text.Field}" />
                        <Label Grid.Column="1" Text="{Binding Description.Length, StringFormat='{0}/250', FallbackValue='0/250', TargetNullValue='0/250'}" Style="{StaticResource Text.Counter}" />
                    </Grid>
                    <Border Style="{StaticResource Input.Multiline}" MinimumHeightRequest="88">
                        <Editor Text="{Binding Description}" AutoSize="TextChanges" MaxLength="250" Placeholder="{x:Static res:AppResources.Expense_DescriptionPlaceholder}" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ════════ Action bar ════════ -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" BackgroundColor="{DynamicResource tp-surface}">
            <BoxView Grid.Row="0" Style="{StaticResource Divider}" />
            <VerticalStackLayout Grid.Row="1" Spacing="10" Padding="16,12">
                <Border IsVisible="{Binding HasValidationError}" Style="{StaticResource Banner.Error}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{Binding ValidationMessage}" FontSize="13" TextColor="{DynamicResource tp-danger}" />
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="{x:Static res:AppResources.Common_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource Btn.Secondary}" />
                    <Button Grid.Column="1" Text="{x:Static res:AppResources.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource Btn.Primary}" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
