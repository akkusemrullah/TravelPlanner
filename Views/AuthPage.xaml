<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.AuthPage"
             x:DataType="vm:AuthViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="{DynamicResource tp-surface}">

    <!-- G3: sign in / create account / confirm code / reset password - one page, the ViewModel's Mode picks the fields.
         TP-101: laid out like the prototype - app icon, large title, Google button, "veya", fields with icons,
         the guest box and the legal line. -->
    <Grid RowDefinitions="Auto,*">

        <!-- ════════ Top bar: ✕ on sign in / sign up, ← on the code and reset steps ════════ -->
        <Grid Grid.Row="0" Padding="6,6,6,0" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" IsVisible="{Binding ShowClose}"
                    SemanticProperties.Description="{x:Static res:AppResources.Auth_Close}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" FontSize="22" Text="{StaticResource Ic.Close}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Border Grid.Column="0" Style="{StaticResource IconButton}" IsVisible="{Binding ShowBack}"
                    SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowSignInCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" FontSize="22" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,0,24,40" Spacing="0">

                <!-- ════════ App icon + heading ════════ -->
                <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="0"
                        BackgroundColor="{StaticResource BrandRoyal}" HorizontalOptions="Start">
                    <controls:LogoMark Size="35" PinColor="White" PlaneColor="{StaticResource BrandRoyal}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="26" TextColor="{DynamicResource tp-text}" Margin="0,16,0,0"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Subtitle}" FontSize="14.5" TextColor="{DynamicResource tp-text-2}" LineHeight="1.35" Margin="0,6,0,0"
                       LineBreakMode="WordWrap" />

                <!-- ════════ Google + "veya" ════════ -->
                <VerticalStackLayout IsVisible="{Binding ShowGoogle}" Margin="0,24,0,0" Spacing="20">
                    <Border HeightRequest="48" StrokeShape="RoundRectangle 12" Stroke="{DynamicResource tp-border-strong}" StrokeThickness="1"
                            BackgroundColor="{DynamicResource tp-surface}" Padding="0"
                            SemanticProperties.Description="{x:Static res:AppResources.Auth_ContinueWithGoogle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SignInWithGoogleCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <!-- TP-110: Google's own "G" (Resources/Images/google_g.svg, built into a PNG) -->
                            <Image Source="google_g.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" VerticalOptions="Center"
                                   SemanticProperties.Description="Google" />
                            <Label Text="{x:Static res:AppResources.Auth_ContinueWithGoogle}" FontFamily="InterSemiBold" FontSize="15"
                                   TextColor="{DynamicResource tp-text}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                        <BoxView Grid.Column="0" Style="{StaticResource Divider}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.Auth_Or}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                        <BoxView Grid.Column="2" Style="{StaticResource Divider}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <!-- ════════ Fields ════════ -->
                <VerticalStackLayout Spacing="14" Margin="0,20,0,0">

                    <!-- Ad Soyad (sign up) -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSignUp}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{x:Static res:AppResources.Auth_NameLabel}" Style="{StaticResource Text.Field}" />
                            <Label Grid.Column="1" Text="{Binding DisplayName.Length, StringFormat='{0}/40'}" FontSize="13" TextColor="{DynamicResource tp-text-3}" />
                        </Grid>
                        <Border Style="{StaticResource Input}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.UserPlain}" />
                                <Entry Grid.Column="1" Text="{Binding DisplayName}" MaxLength="40" Placeholder="{x:Static res:AppResources.Settings_NamePlaceholder}"
                                       Keyboard="Text" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- E-posta -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowEmailField}">
                        <Label Text="{x:Static res:AppResources.Auth_EmailLabel}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.Mail}" />
                                <Entry Grid.Column="1" Text="{Binding Email}" Keyboard="Email" MaxLength="254" IsSpellCheckEnabled="False"
                                       IsTextPredictionEnabled="False" Placeholder="ornek@eposta.com" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Şifre (+ göster) -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowPasswordField}">
                        <Label Text="{x:Static res:AppResources.Auth_PasswordLabel}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}" Padding="14,0,4,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.Lock}" />
                                <Entry Grid.Column="1" Text="{Binding Password}" IsPassword="{Binding IsPasswordHidden}" MaxLength="72" Placeholder="••••••••" />
                                <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40" SemanticProperties.Description="{x:Static res:AppResources.Auth_ShowPassword}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Eye}" TextColor="{DynamicResource tp-text-3}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsPasswordHidden}" Value="False">
                                                <Setter Property="Text" Value="{StaticResource Ic.EyeOff}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Grid>
                        </Border>
                        <Label Text="{x:Static res:AppResources.Auth_PasswordHint}" Style="{StaticResource Text.Hint}" IsVisible="{Binding IsSignUp}" />
                        <Label Text="{x:Static res:AppResources.Auth_ForgotPassword}" FontFamily="InterSemiBold" FontSize="13.5" TextColor="{DynamicResource tp-accent-text}"
                               HorizontalOptions="End" Padding="0,4" IsVisible="{Binding IsSignIn}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowForgotPasswordCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Doğrulama kodu -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsCodeMode}">
                        <Label Text="{x:Static res:AppResources.Auth_CodeLabel}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.Hash}" />
                                <Entry Grid.Column="1" Text="{Binding Code}" Keyboard="Numeric" MaxLength="10" FontFamily="InterBold" FontSize="18"
                                       CharacterSpacing="6" Placeholder="{x:Static res:AppResources.Auth_CodePlaceholder}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Yeni şifre -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsResetPassword}">
                        <Label Text="{x:Static res:AppResources.Auth_NewPasswordLabel}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.KeyRound}" />
                                <Entry Grid.Column="1" Text="{Binding NewPassword}" IsPassword="True" MaxLength="72" Placeholder="••••••••" />
                            </Grid>
                        </Border>
                        <Label Text="{x:Static res:AppResources.Auth_PasswordHint}" Style="{StaticResource Text.Hint}" />
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding HasError}" Style="{StaticResource Banner.Error}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="13" TextColor="{DynamicResource tp-danger}" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding HasInfo}" Style="{StaticResource Banner.Info}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-info}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding InfoMessage}" FontSize="13" TextColor="{DynamicResource tp-info}" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,4,0,0">
                        <Button Text="{x:Static res:AppResources.Auth_SignIn}" Command="{Binding SignInCommand}" Style="{StaticResource Btn.Primary.Lg}" IsVisible="{Binding IsSignIn}" />
                        <Button Text="{x:Static res:AppResources.Auth_CreateAccount}" Command="{Binding SignUpCommand}" Style="{StaticResource Btn.Primary.Lg}" IsVisible="{Binding IsSignUp}" />
                        <Button Text="{x:Static res:AppResources.Auth_Confirm}" Command="{Binding VerifyCodeCommand}" Style="{StaticResource Btn.Primary.Lg}" IsVisible="{Binding IsVerifySignUp}" />
                        <Button Text="{x:Static res:AppResources.Auth_SendCode}" Command="{Binding SendResetCodeCommand}" Style="{StaticResource Btn.Primary.Lg}" IsVisible="{Binding IsForgotPassword}" />
                        <Button Text="{x:Static res:AppResources.Auth_SetNewPassword}" Command="{Binding ResetPasswordCommand}" Style="{StaticResource Btn.Primary.Lg}" IsVisible="{Binding IsResetPassword}" />
                    </Grid>

                    <controls:LoadingDots IsVisible="{Binding IsWorking}" DotSize="8" DotColor="{DynamicResource tp-accent}" />

                    <Button Text="{x:Static res:AppResources.Auth_ResendCode}" Command="{Binding ResendCodeCommand}" Style="{StaticResource Btn.Ghost}"
                            IsVisible="{Binding IsCodeMode}" />
                </VerticalStackLayout>

                <!-- ════════ Switch between sign in and create account ════════ -->
                <Label HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="{Binding IsSignIn}" Margin="0,20,0,0" FontSize="14">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static res:AppResources.Auth_NoAccount}" TextColor="{DynamicResource tp-text-2}" />
                            <Span Text=" " />
                            <Span Text="{x:Static res:AppResources.Auth_CreateAccount}" TextColor="{DynamicResource tp-accent-text}" FontFamily="InterSemiBold">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowSignUpCommand}" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="{Binding IsSignUp}" Margin="0,20,0,0" FontSize="14">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static res:AppResources.Auth_HaveAccount}" TextColor="{DynamicResource tp-text-2}" />
                            <Span Text=" " />
                            <Span Text="{x:Static res:AppResources.Auth_SignIn}" TextColor="{DynamicResource tp-accent-text}" FontFamily="InterSemiBold">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowSignInCommand}" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- ════════ Guest box + legal (sign in / sign up) ════════ -->
                <VerticalStackLayout IsVisible="{Binding ShowGoogle}" Spacing="0">
                    <Border Margin="0,24,0,0" Padding="16" StrokeShape="RoundRectangle 16" BackgroundColor="{DynamicResource tp-surface-alt}"
                            Stroke="{DynamicResource tp-border}" StrokeThickness="1">
                        <VerticalStackLayout Spacing="10">
                            <Button Text="{x:Static res:AppResources.Auth_ContinueAsGuest}" Command="{Binding CloseCommand}" Style="{StaticResource Btn.Secondary}" />
                            <Label Text="{x:Static res:AppResources.Auth_GuestHint}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" LineHeight="1.35"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- KVKK: inform before the data is collected -->
                    <Label FontSize="12" TextColor="{DynamicResource tp-text-3}" LineHeight="1.35" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                           Margin="0,20,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span TextColor="{DynamicResource tp-text-3}" Text="{x:Static res:AppResources.Auth_LegalText1}" />
                                <Span Text="{x:Static res:AppResources.Auth_LegalTerms}" TextColor="{DynamicResource tp-accent-text}" FontFamily="InterMedium" TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTermsTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span TextColor="{DynamicResource tp-text-3}" Text="{x:Static res:AppResources.Auth_LegalText2}" />
                                <Span Text="{x:Static res:AppResources.Auth_LegalPrivacy}" TextColor="{DynamicResource tp-accent-text}" FontFamily="InterMedium" TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPrivacyTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span TextColor="{DynamicResource tp-text-3}" Text="{x:Static res:AppResources.Auth_LegalAnd}" />
                                <Span Text="{x:Static res:AppResources.Auth_LegalKvkk}" TextColor="{DynamicResource tp-accent-text}" FontFamily="InterMedium" TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnKvkkTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span TextColor="{DynamicResource tp-text-3}" Text="{x:Static res:AppResources.Auth_LegalText3}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
