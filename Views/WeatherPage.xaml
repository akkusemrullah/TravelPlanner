<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             x:Class="TravelPlanner.Views.WeatherPage"
             x:DataType="vm:WeatherViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="44,*,44">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.Section_Weather}" Style="{StaticResource Text.AppBarTitle}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Trip.City}" Style="{StaticResource Text.Caption}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,20,16,28" Spacing="20">

                    <controls:LoadingLogo IsVisible="{Binding IsBusy}" Size="56" />

                    <!-- ════════ Current conditions (TP-103: the prototype's hero) ════════ -->
                    <Border Style="{StaticResource Card.Hero}" StrokeShape="RoundRectangle 22" IsVisible="{Binding Weather, Converter={StaticResource ObjectNotNullConverter}}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Trip.PlaceDisplay, StringFormat={x:Static res:AppResources.Weather_NowFormat}}" FontSize="14"
                                           TextColor="{DynamicResource tp-hero-muted}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Weather.Temperature, StringFormat='{0:F0}°'}" FontFamily="InterBold" FontSize="56" CharacterSpacing="-2"
                                           TextColor="{DynamicResource tp-on-hero}" Margin="0,4,0,0" />
                                    <Label Text="{Binding Weather.Condition}" FontFamily="InterMedium" FontSize="15" TextColor="{DynamicResource tp-on-hero}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" FontFamily="Lucide" FontSize="92" TextColor="{DynamicResource tp-on-hero}" Opacity="0.9" VerticalOptions="Center"
                                       Text="{Binding Weather.IconEmoji, Converter={StaticResource WeatherGlyphConverter}}"
                                       AutomationProperties.IsInAccessibleTree="False" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="White" Opacity="0.15" />
                            <HorizontalStackLayout Spacing="20">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Style="{StaticResource Icon}" FontSize="16" Text="{StaticResource Ic.Droplets}" TextColor="{DynamicResource tp-hero-muted}" VerticalOptions="Center" />
                                    <Label FontSize="13.5" TextColor="{DynamicResource tp-hero-muted}" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static res:AppResources.Weather_Humidity}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Weather.Humidity, StringFormat='%{0}'}" FontFamily="InterBold" TextColor="{DynamicResource tp-on-hero}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Style="{StaticResource Icon}" FontSize="16" Text="{StaticResource Ic.Wind}" TextColor="{DynamicResource tp-hero-muted}" VerticalOptions="Center" />
                                    <Label FontSize="13.5" TextColor="{DynamicResource tp-hero-muted}" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static res:AppResources.Weather_Wind}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Weather.WindSpeed, StringFormat='{0:F1} m/s'}" FontFamily="InterBold" TextColor="{DynamicResource tp-on-hero}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ════════ Error ════════ -->
                    <Border Style="{StaticResource Banner.Error}" IsVisible="{Binding HasError}" Padding="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource Icon}" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="14" TextColor="{DynamicResource tp-danger}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- ════════ Trip forecast ════════ -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasTripForecast}">
                        <Label Text="{helpers:Upper Forecast_Title}" Style="{StaticResource Text.Overline}" Margin="4,0" SemanticProperties.HeadingLevel="Level2" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding TripForecast}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:DailyForecast">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="86,Auto,*,Auto" ColumnSpacing="12" Padding="16,12">
                                                <Grid.Triggers>
                                                    <DataTrigger TargetType="Grid" Binding="{Binding IsClimateAverage}" Value="True">
                                                        <Setter Property="Opacity" Value="0.7" />
                                                    </DataTrigger>
                                                </Grid.Triggers>
                                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                                    <Label Text="{Binding DateDisplay}" FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource tp-text}" />
                                                    <Border Style="{StaticResource Tag}" HeightRequest="20" Padding="7,0" HorizontalOptions="Start" BackgroundColor="{DynamicResource tp-info-soft}">
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="{x:Static models:ForecastKind.Observed}">
                                                                <Setter Property="BackgroundColor" Value="{DynamicResource tp-surface-alt}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="{x:Static models:ForecastKind.ClimateAverage}">
                                                                <Setter Property="BackgroundColor" Value="{DynamicResource tp-warning-soft}" />
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Label Text="{Binding KindLabel}" Style="{StaticResource Tag.Text}" FontSize="10.5" TextColor="{DynamicResource tp-info}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="{x:Static models:ForecastKind.Observed}">
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-text-2}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="{x:Static models:ForecastKind.ClimateAverage}">
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-warning}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" FontFamily="Lucide" FontSize="28" VerticalOptions="Center" TextColor="{DynamicResource tp-info}"
                                                       Text="{Binding IconEmoji, Converter={StaticResource WeatherGlyphConverter}}" AutomationProperties.IsInAccessibleTree="False">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding ConditionTone}" Value="warning">
                                                            <Setter Property="TextColor" Value="{DynamicResource tp-warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding ConditionTone}" Value="neutral">
                                                            <Setter Property="TextColor" Value="{DynamicResource tp-text-3}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Condition}" FontSize="13.5" TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" />
                                                    <HorizontalStackLayout Spacing="3" IsVisible="{Binding HasPrecipitation}">
                                                        <Label Style="{StaticResource Icon}" FontSize="12" Text="{StaticResource Ic.Droplets}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                                                        <Label Text="{Binding PrecipitationDisplay}" FontSize="12" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="3" VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding MaxDisplay}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                                            <Span Text="{Binding MinDisplay}" FontSize="14" TextColor="{DynamicResource tp-text-3}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Grid>
                                            <BoxView Style="{StaticResource Divider.Inset}" Margin="16,0,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding HasClimateAverages}" Style="{StaticResource Banner.Warning}" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-warning}" VerticalOptions="Start" />
                                <Label Grid.Column="1" Text="{x:Static res:AppResources.Forecast_Note}" FontSize="13" TextColor="{DynamicResource tp-warning}" />
                            </Grid>
                        </Border>
                        <Grid IsVisible="{Binding HasForecastNotice}" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="4,4,4,0">
                            <Label Grid.Column="0" Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding ForecastNotice}" Style="{StaticResource Text.Caption}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Label Text="{x:Static res:AppResources.Weather_Source}" FontSize="11.5" TextColor="{DynamicResource tp-text-3}" HorizontalTextAlignment="Center"
                           IsVisible="{Binding Weather, Converter={StaticResource ObjectNotNullConverter}}" />

                    <Label IsVisible="{Binding TripForecastUnavailable}" Text="{x:Static res:AppResources.Forecast_Unavailable}"
                           Style="{StaticResource Text.Body2}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
