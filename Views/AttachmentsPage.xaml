<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.AttachmentsPage"
             x:DataType="vm:AttachmentsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="44,*,44" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Attachments_Title}" Style="{StaticResource Text.AppBarTitle}" HorizontalTextAlignment="Center" />
            <Border Grid.Column="2" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Delete}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- ════════ Add actions (TP-104: the prototype's three tiles) ════════ -->
        <VerticalStackLayout Grid.Row="2" Padding="16,16,16,4" Spacing="10" IsVisible="{Binding ShowEditActions}">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" HeightRequest="84" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{DynamicResource tp-border}"
                        BackgroundColor="{DynamicResource tp-surface}" SemanticProperties.Description="{x:Static res:AppResources.Attachments_TakePhoto}" IsEnabled="{Binding CanTakePhoto}">
                    <Border.Triggers>
                        <Trigger TargetType="Border" Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TakePhotoCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-accent-soft}" HorizontalOptions="Center">
                            <Label Style="{StaticResource Icon}" FontSize="20" Text="{StaticResource Ic.Camera}" TextColor="{DynamicResource tp-accent-text}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{x:Static res:AppResources.Attachments_TakePhoto}" FontFamily="InterMedium" FontSize="13" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" MaxLines="1" Margin="4,0" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" HeightRequest="84" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{DynamicResource tp-border}"
                        BackgroundColor="{DynamicResource tp-surface}" SemanticProperties.Description="{x:Static res:AppResources.Attachments_PickPhoto}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-accent-soft}" HorizontalOptions="Center">
                            <Label Style="{StaticResource Icon}" FontSize="20" Text="{StaticResource Ic.Image}" TextColor="{DynamicResource tp-accent-text}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{x:Static res:AppResources.Attachments_PickPhoto}" FontFamily="InterMedium" FontSize="13" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" MaxLines="1" Margin="4,0" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" HeightRequest="84" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{DynamicResource tp-border}"
                        BackgroundColor="{DynamicResource tp-surface}" SemanticProperties.Description="{x:Static res:AppResources.Attachments_PickDocument}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickDocumentCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-accent-soft}" HorizontalOptions="Center">
                            <Label Style="{StaticResource Icon}" FontSize="20" Text="{StaticResource Ic.Folder}" TextColor="{DynamicResource tp-accent-text}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{x:Static res:AppResources.Attachments_PickDocument}" FontFamily="InterMedium" FontSize="13" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" MaxLines="1" Margin="4,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Label Text="{x:Static res:AppResources.Attachments_Hint}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" Margin="4,0" />
        </VerticalStackLayout>

        <Grid Grid.Row="3">
            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoAttachments}" Spacing="12" Padding="32,24" VerticalOptions="Start">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.FileText}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Attachments_Empty}" Style="{StaticResource Text.EmptyText}" />
                <!-- TP-80: say who can see a passport or ticket before the first one is added -->
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Style="{StaticResource Icon}" FontSize="13" Text="{StaticResource Ic.Lock}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                    <Label Text="{x:Static res:AppResources.Attachments_MembersOnly}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <RefreshView IsVisible="{Binding HasAttachments}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
                <CollectionView x:Name="AttachmentsCollectionView" ItemsSource="{Binding Attachments}" SelectionMode="None">
                    <CollectionView.Header>
                        <BoxView HeightRequest="12" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <HorizontalStackLayout Spacing="6" Padding="20,12,20,32">
                            <Label Style="{StaticResource Icon}" FontSize="13" Text="{StaticResource Ic.Lock}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                            <Label Text="{x:Static res:AppResources.Attachments_MembersOnly}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </CollectionView.Footer>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TripAttachment">
                            <!-- one slice of the list card (Helpers/ListPositions) -->
                            <Border BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0"
                                    StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}"
                                    Margin="{Binding ListPosition, Converter={StaticResource ListPositionMarginConverter}}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Padding="14,10,6,10" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttachmentsViewModel}}, Path=AttachmentTappedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <controls:SelectCircle Grid.Column="0" IsOn="{Binding IsSelected}" VerticalOptions="Center" Margin="0,0,12,0"
                                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AttachmentsViewModel}}, Path=Selection.IsActive}" />
                                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0"
                                            BackgroundColor="{DynamicResource tp-surface-alt}" VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsDocument}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource tp-danger-soft}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <Image Source="{Binding FullPath}" Aspect="AspectFill" IsVisible="{Binding IsPhoto}"
                                                   SemanticProperties.Description="{Binding DisplayName}" />
                                            <VerticalStackLayout IsVisible="{Binding IsDocument}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="1">
                                                <Label Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.FileText}" TextColor="{DynamicResource tp-danger}" HorizontalOptions="Center" />
                                                <Label Text="{Binding Extension}" FontFamily="InterBold" FontSize="9" HorizontalOptions="Center" TextColor="{DynamicResource tp-danger}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1" Margin="12,0,0,0">
                                        <Label Text="{Binding DisplayName}" FontFamily="InterMedium" FontSize="14.5" TextColor="{DynamicResource tp-text}" LineBreakMode="MiddleTruncation" />
                                        <Label FontSize="12.5" TextColor="{DynamicResource tp-text-3}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding SizeDisplay}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding CreatedDate, StringFormat='{0:dd.MM.yyyy}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <!-- Rename (was a swipe action). Viewers and selection mode don't get it. -->
                                    <Border Grid.Column="3" Style="{StaticResource IconButton}"
                                            SemanticProperties.Description="{x:Static res:AppResources.Attachments_Rename}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AttachmentsViewModel}}, Path=ShowEditActions}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttachmentsViewModel}}, Path=RenameCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Style="{StaticResource Icon}" FontSize="17" Text="{StaticResource Ic.Edit}" TextColor="{DynamicResource tp-text-3}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
