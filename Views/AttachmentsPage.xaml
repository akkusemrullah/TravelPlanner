<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.AttachmentsPage"
             x:DataType="vm:AttachmentsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Attachments_Title}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
            <Border Grid.Column="2" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Delete}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- ════════ Add actions ════════ -->
        <VerticalStackLayout Grid.Row="2" Padding="16,16,16,4" Spacing="10">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding ShowEditActions}">
                <Border Grid.Column="0" Style="{StaticResource Card.Compact}" Padding="8,14" IsEnabled="{Binding CanTakePhoto}"
                        SemanticProperties.Description="{x:Static res:AppResources.Attachments_TakePhoto}">
                    <Border.Triggers>
                        <Trigger TargetType="Border" Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TakePhotoCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Camera}" TextColor="{DynamicResource tp-text}" />
                        <Label Text="{x:Static res:AppResources.Attachments_TakePhoto}" FontFamily="InterMedium" FontSize="12" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap" MaxLines="2" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card.Compact}" Padding="8,14"
                        SemanticProperties.Description="{x:Static res:AppResources.Attachments_PickPhoto}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Image}" TextColor="{DynamicResource tp-text}" />
                        <Label Text="{x:Static res:AppResources.Attachments_PickPhoto}" FontFamily="InterMedium" FontSize="12" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap" MaxLines="2" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card.Compact}" Padding="8,14"
                        SemanticProperties.Description="{x:Static res:AppResources.Attachments_PickDocument}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickDocumentCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.FileText}" TextColor="{DynamicResource tp-text}" />
                        <Label Text="{x:Static res:AppResources.Attachments_PickDocument}" FontFamily="InterMedium" FontSize="12" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap" MaxLines="2" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <Label Grid.Column="0" Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Start" />
                <Label Grid.Column="1" Text="{x:Static res:AppResources.Attachments_Hint}" Style="{StaticResource Text.Caption}" />
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="3">
            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoAttachments}" Spacing="14" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Attachment}" TextColor="{DynamicResource tp-text-2}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Attachments_Empty}" Style="{StaticResource EmptyStateTextLabel}" />
            </VerticalStackLayout>

            <RefreshView IsVisible="{Binding HasAttachments}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
                <CollectionView x:Name="AttachmentsCollectionView" ItemsSource="{Binding Attachments}" SelectionMode="None">
                    <CollectionView.Header>
                        <BoxView HeightRequest="12" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="24" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TripAttachment">
                                <Border Style="{StaticResource Card.Compact}" Margin="16,0" HorizontalOptions="Fill">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                            <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttachmentsViewModel}}, Path=AttachmentTappedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Selection mode: tick in front of the thumbnail. -->
                                        <Label Grid.Column="0" Style="{StaticResource Icon}" Text="{StaticResource Ic.Circle}" TextColor="{DynamicResource tp-text-3}"
                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AttachmentsViewModel}}, Path=Selection.IsActive}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Text" Value="{StaticResource Ic.CheckCircle}" />
                                                    <Setter Property="TextColor" Value="{DynamicResource tp-accent}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Border Grid.Column="1" Style="{StaticResource IconTile}" WidthRequest="52" HeightRequest="52">
                                            <Grid>
                                                <Image Source="{Binding FullPath}" Aspect="AspectFill" IsVisible="{Binding IsPhoto}"
                                                       SemanticProperties.Description="{Binding DisplayName}" />
                                                <VerticalStackLayout IsVisible="{Binding IsDocument}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.File}" />
                                                    <Label Text="{Binding Extension}" FontFamily="InterSemiBold" FontSize="9" HorizontalOptions="Center"
                                                           TextColor="{DynamicResource tp-text-2}" TextTransform="Uppercase" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="3">
                                            <Label Text="{Binding DisplayName}" Style="{StaticResource Text.Title}" FontSize="14" LineBreakMode="MiddleTruncation" />
                                            <Label Style="{StaticResource Text.Caption}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding SizeDisplay}" TextColor="{DynamicResource tp-text-3}" />
                                                        <Span Text="  ·  " TextColor="{DynamicResource tp-text-3}" />
                                                        <Span Text="{Binding CreatedDate, StringFormat='{0:d MMM yyyy}'}" TextColor="{DynamicResource tp-text-3}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <!-- Rename (was a swipe action). Viewers and selection mode don't get it. -->
                                        <Border Grid.Column="3" Style="{StaticResource IconButton}" WidthRequest="36" HeightRequest="36"
                                                SemanticProperties.Description="{x:Static res:AppResources.Attachments_Rename}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AttachmentsViewModel}}, Path=ShowEditActions}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttachmentsViewModel}}, Path=RenameCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Edit}" TextColor="{DynamicResource tp-text-3}" />
                                        </Border>
                                    </Grid>
                                </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
