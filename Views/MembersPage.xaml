<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.MembersPage"
             x:DataType="vm:MembersViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- G6: members of a trip, invites, roles, leaving. Everything here needs a connection. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" Margin="0,0,44,0">
                <Label Text="{x:Static res:AppResources.Members_Title}" Style="{StaticResource Text.AppBarTitle}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding TripName}" Style="{StaticResource Text.Caption}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <!-- TP-104: the prototype's members screen - avatars, role badges, the invite card with the big code -->
                <VerticalStackLayout Padding="16,16,16,32" Spacing="20">

                    <!-- ════════ Guest / offline / error ════════ -->
                    <VerticalStackLayout IsVisible="{Binding IsGuest}" Spacing="12" Padding="16,24">
                        <Border Style="{StaticResource EmptyIcon}">
                            <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Users}" TextColor="{DynamicResource tp-accent-text}" />
                        </Border>
                        <Label Text="{x:Static res:AppResources.Members_SignInTitle}" Style="{StaticResource Text.EmptyTitle}" />
                        <Label Text="{x:Static res:AppResources.Members_SignInHint}" Style="{StaticResource Text.EmptyText}" />
                        <Button Text="{x:Static res:AppResources.Account_SignInOrCreate}" Command="{Binding OpenSignInCommand}" Style="{StaticResource Btn.Primary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsOffline}" Spacing="12" Padding="16,24">
                        <Border Style="{StaticResource EmptyIcon}">
                            <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.WifiOff}" TextColor="{DynamicResource tp-accent-text}" />
                        </Border>
                        <Label Text="{x:Static res:AppResources.Members_OfflineTitle}" Style="{StaticResource Text.EmptyTitle}" />
                        <Label Text="{x:Static res:AppResources.Sharing_ErrorOffline}" Style="{StaticResource Text.EmptyText}" />
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding HasError}" Style="{StaticResource Banner.Error}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding ErrorText}" FontSize="13" TextColor="{DynamicResource tp-danger}" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <!-- ════════ Members ════════ -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSignedIn}">
                        <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                            <Label Grid.Column="0" Text="{helpers:Upper Members_ListTitle}" Style="{StaticResource Text.Overline}" VerticalOptions="Center" />
                            <controls:Badge Grid.Column="1" Text="{Binding MyRoleText}" Tone="{Binding MyRoleTone}" />
                        </Grid>
                        <Border IsVisible="{Binding IsNotShared}" Style="{StaticResource Banner.Accent}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Users}" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Start" />
                                <Label Grid.Column="1" Text="{x:Static res:AppResources.Members_NotShared}" FontSize="13" TextColor="{DynamicResource tp-accent-text}" />
                            </Grid>
                        </Border>
                        <controls:LoadingLogo IsVisible="{Binding IsBusy}" Size="40" Margin="0,12" />
                        <Border Style="{StaticResource Card.List}" IsVisible="{Binding HasMembers}">
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Members}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemberItem">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,12" MinimumHeightRequest="64" BackgroundColor="Transparent">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MembersViewModel}}, Path=ManageMemberCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <controls:Avatar Grid.Column="0" Name="{Binding AvatarName}" Size="42" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" FontFamily="InterMedium" FontSize="15" TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Email}" IsVisible="{Binding HasEmail}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding JoinedText}" IsVisible="{Binding HasJoinedText}" FontSize="12" TextColor="{DynamicResource tp-text-3}" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <controls:Badge Grid.Column="2" Text="{Binding RoleText}" Tone="{Binding RoleTone}">
                                                    <controls:Badge.Triggers>
                                                        <DataTrigger TargetType="controls:Badge" Binding="{Binding IsOwnerRole}" Value="True">
                                                            <Setter Property="Icon" Value="{StaticResource Ic.Crown}" />
                                                        </DataTrigger>
                                                    </controls:Badge.Triggers>
                                                </controls:Badge>
                                            </Grid>
                                            <BoxView Style="{StaticResource Divider.Inset}" Margin="70,0,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Invite (owner) ════════ -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding CanInvite}">
                        <Label Text="{helpers:Upper Members_InviteTitle}" Style="{StaticResource Text.Overline}" Margin="4,0" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="{x:Static res:AppResources.Members_InviteHint}" FontSize="13.5" TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap" />
                                <Border IsVisible="{Binding HasInvite}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16" BackgroundColor="{DynamicResource tp-accent-soft}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{helpers:Upper Members_InviteCodeLabel}" FontFamily="InterSemiBold" FontSize="11" CharacterSpacing="1.1" TextColor="{DynamicResource tp-accent-text}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding LastInviteCode}" FontFamily="InterBold" FontSize="30" CharacterSpacing="5"
                                               HorizontalTextAlignment="Center" TextColor="{DynamicResource tp-text}" />
                                        <Label Text="{Binding LastInviteText}" FontSize="12.5" TextColor="{DynamicResource tp-text-2}" HorizontalTextAlignment="Center" />
                                        <Button Text="{x:Static res:AppResources.Common_Copy}" Command="{Binding CopyInviteCommand}" Style="{StaticResource Btn.Secondary.Sm}"
                                                HorizontalOptions="Center" Margin="0,8,0,0" ContentLayout="Left,6">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Copy}" Size="16" Color="{DynamicResource tp-text}" />
                                            </Button.ImageSource>
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding CodeCopied}" Value="True">
                                                    <Setter Property="Text" Value="{x:Static res:AppResources.Members_CodeCopied}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </VerticalStackLayout>
                                </Border>
                                <VerticalStackLayout Spacing="8">
                                    <!-- TP-4: one person by default; a group code only on purpose (with a warning). -->
                                    <Button Text="{x:Static res:AppResources.Members_Invite}" Command="{Binding InviteCommand}" Style="{StaticResource Btn.Primary}" ContentLayout="Left,8">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Ticket}" Size="18" Color="{DynamicResource tp-on-primary}" />
                                        </Button.ImageSource>
                                    </Button>
                                    <Button Text="{x:Static res:AppResources.Members_InviteGroup}" Command="{Binding InviteGroupCommand}" Style="{StaticResource Btn.Secondary}" ContentLayout="Left,8">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.UserPlus}" Size="18" Color="{DynamicResource tp-text}" />
                                        </Button.ImageSource>
                                    </Button>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ════════ Leave (editor / viewer) ════════ -->
                    <Button Text="{x:Static res:AppResources.Members_Leave}" Command="{Binding LeaveCommand}" Style="{StaticResource Btn.Danger}"
                            IsVisible="{Binding CanLeave}" ContentLayout="Left,8">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.LogOut}" Size="18" Color="{DynamicResource tp-danger}" />
                        </Button.ImageSource>
                    </Button>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
