<?xml version="1.0" encoding="utf-8" ?>
<!--
    Launch splash shown before the Shell (~3 s): a faint globe appears, a paper plane flies a dashed route across it
    and lands in the logo pin, which pops in with a ring on the ground; then the TravelPlanner wordmark and tagline
    slide in, and everything fades out and App swaps in the AppShell. The scene is Controls/SplashRouteView; the
    app's loading animation (Controls/LoadingLogo, AI planner and loading pages) is not used here.
    Background = the native splash colour (#1E3A8A, see TravelPlanner.csproj MauiSplashScreen), so the hand-over
    from the OS splash is seamless. Colours = docs/brand/logo-mark-white.svg (white pin, royal-blue plane).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             x:Class="TravelPlanner.Views.SplashPage"
             BackgroundColor="{StaticResource BrandRoyal}"
             Shell.NavBarIsVisible="False">

    <Grid x:Name="Root" RowDefinitions="*,Auto,*,Auto" Padding="24,0,24,36">

        <VerticalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center"
                             SemanticProperties.Description="TravelPlanner">

            <!-- Map scene + the logo pin sitting where the route ends. -->
            <Grid x:Name="Stage" HorizontalOptions="Center">
                <controls:SplashRouteView x:Name="Scene" />
                <controls:LogoMark x:Name="Pin" HorizontalOptions="Start" VerticalOptions="Start"
                                   PinColor="White" PlaneColor="{StaticResource BrandRoyal}"
                                   Opacity="0" Scale="0.4" />
            </Grid>

            <!-- Wordmark: "Travel" bold + "Planner" regular, all white on royal blue (docs/brand/README.md). -->
            <Label x:Name="Wordmark" HorizontalOptions="Center" Opacity="0" TranslationY="14"
                   FontSize="34" CharacterSpacing="-0.5">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Travel" FontFamily="InterBold" TextColor="White" />
                        <Span Text="Planner" FontFamily="InterRegular" TextColor="White" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label x:Name="Tagline" Text="{x:Static res:AppResources.Splash_Tagline}" HorizontalOptions="Center"
                   FontFamily="InterRegular" FontSize="14" TextColor="{StaticResource BrandMuted}" Opacity="0" />

        </VerticalStackLayout>

        <!-- Publisher. -->
        <VerticalStackLayout x:Name="Footer" Grid.Row="3" Spacing="4" HorizontalOptions="Center" Opacity="0">
            <Label Text="EAKSOFT" HorizontalOptions="Center" CharacterSpacing="4"
                   FontFamily="InterSemiBold" FontSize="14" TextColor="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
