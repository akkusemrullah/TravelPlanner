<?xml version="1.0" encoding="utf-8" ?>
<!--
    CAPTCHA (Cloudflare Turnstile) before the e-mail auth calls - shown modally by TurnstileCaptchaService.
    Most people pass without touching anything; Turnstile shows its checkbox only when it wants an interaction.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             x:Class="TravelPlanner.Views.CaptchaPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{DynamicResource tp-surface}">

    <Grid RowDefinitions="Auto,*">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.Captcha_Cancel}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Close}" TextColor="{DynamicResource tp-text}" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,4,24,32" Spacing="20">

                <VerticalStackLayout Spacing="10">
                    <Border Style="{StaticResource IconTile.Accent}" HorizontalOptions="Start">
                        <Label Style="{StaticResource Icon.Accent}" Text="{StaticResource Ic.Shield}" />
                    </Border>
                    <Label Text="{x:Static res:AppResources.Captcha_Title}" Style="{StaticResource Text.H1}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{x:Static res:AppResources.Captcha_Subtitle}" Style="{StaticResource Text.Body2}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- The widget. The dots sit under the transparent WebView: visible until Turnstile shows its checkbox. -->
                <Grid HeightRequest="80">
                    <controls:LoadingDots x:Name="Dots" DotSize="8" DotColor="{DynamicResource tp-primary}"
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <WebView x:Name="Web" BackgroundColor="Transparent" Navigating="OnNavigating" />
                </Grid>

                <Border x:Name="ErrorBanner" IsVisible="False" Style="{StaticResource Banner.Error}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.Captcha_Failed}" FontSize="13" TextColor="{DynamicResource tp-danger}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Button x:Name="RetryButton" IsVisible="False" Text="{x:Static res:AppResources.Captcha_Retry}" Clicked="OnRetryClicked"
                            Style="{StaticResource Btn.Primary}" />
                    <Button Text="{x:Static res:AppResources.Captcha_Cancel}" Clicked="OnCancelClicked" Style="{StaticResource Btn.Ghost}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
