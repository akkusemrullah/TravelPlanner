<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.TrashPage"
             x:DataType="vm:TrashViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- G6: things deleted in the last 30 days; a trip comes back with everything that was in it. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Trash_Title}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <Grid Grid.Row="2">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
                <ScrollView>
                    <VerticalStackLayout Padding="16,20,16,28" Spacing="12">
                        <Label Text="{x:Static res:AppResources.Trash_Hint}" Style="{StaticResource Text.Caption}" Margin="4,0" LineBreakMode="WordWrap"
                               IsVisible="{Binding HasItems}" />
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrashItemView">
                                    <Border Style="{StaticResource Card}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" Style="{StaticResource Text.Title}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding ExpiryText}" Style="{StaticResource Text.Caption}" TextColor="{DynamicResource tp-text-3}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="{x:Static res:AppResources.Trash_Restore}" Style="{StaticResource Btn.Secondary.Sm}"
                                                    HeightRequest="38" VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrashViewModel}}, Path=RestoreCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56"
                                  HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="14" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Delete}" TextColor="{DynamicResource tp-text-2}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Trash_Empty}" Style="{StaticResource EmptyStateTextLabel}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
