<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.TrashPage"
             x:DataType="vm:TrashViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- G6: things deleted in the last 30 days; a trip comes back with everything that was in it.
         The trash button opens the same "Seçerek sil" mode as every list: tick rows (or "Tümünü seç") and delete
         them for good with one confirmation. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="44,*,44" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Trash_Title}" Style="{StaticResource Text.AppBarTitle}" />
            <Border Grid.Column="2" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Trash_SelectA11y}"
                    ToolTipProperties.Text="{x:Static res:AppResources.Trash_SelectA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Trash}" TextColor="{DynamicResource tp-text}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] - here "sil" deletes for good. -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <Grid Grid.Row="2">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
                <ScrollView>
                    <VerticalStackLayout Padding="16,16,16,40" Spacing="12">
                        <!-- How the trash works: restore within 30 days, or delete for good (TP-105: the prototype's info notice). -->
                        <Border Style="{StaticResource Banner.Info}" IsVisible="{Binding HasItems}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-info}" VerticalOptions="Start" />
                                <Label Grid.Column="1" Text="{x:Static res:AppResources.Trash_PageHint}" FontSize="13" TextColor="{DynamicResource tp-info}" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                        <!-- one card, a slice per deleted item -->
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrashItemView">
                                    <Border BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0"
                                            StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}"
                                            Margin="{Binding ListPosition, Converter={StaticResource ListPositionMarginConverter}}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Padding="16,12" BackgroundColor="Transparent">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrashViewModel}}, Path=ItemTappedCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <controls:SelectCircle Grid.Column="0" IsOn="{Binding IsSelected}" VerticalOptions="Center" Margin="0,0,12,0"
                                                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TrashViewModel}}, Path=Selection.IsActive}" />
                                            <!-- What was deleted (trip, expense …). -->
                                            <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{DynamicResource tp-surface-alt}" VerticalOptions="Center" Margin="0,0,12,0">
                                                <Label Style="{StaticResource Icon}" FontSize="19" Text="{StaticResource Ic.FileText}" TextColor="{DynamicResource tp-text-2}"
                                                       HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Trip">
                                                            <Setter Property="Text" Value="{StaticResource Ic.Luggage}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Expense">
                                                            <Setter Property="Text" Value="{StaticResource Ic.Wallet}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Todo">
                                                            <Setter Property="Text" Value="{StaticResource Ic.ListChecks}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Place">
                                                            <Setter Property="Text" Value="{StaticResource Ic.Pin}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Activity">
                                                            <Setter Property="Text" Value="{StaticResource Ic.CalendarDays}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Attachment">
                                                            <Setter Property="Text" Value="{StaticResource Ic.FileText}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Participant">
                                                            <Setter Property="Text" Value="{StaticResource Ic.Users}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="PackingTemplate">
                                                            <Setter Property="Text" Value="{StaticResource Ic.ClipboardList}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" FontFamily="InterMedium" FontSize="15" TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding ExpiryText}" FontSize="12" TextColor="{DynamicResource tp-warning}" Margin="0,2,0,0">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpiringSoon}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="3" Text="{x:Static res:AppResources.Trash_Restore}" Style="{StaticResource Btn.Soft.Sm}"
                                                    VerticalOptions="Center" Margin="10,0,0,0" ContentLayout="Left,6"
                                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TrashViewModel}}, Path=Selection.IsInactive}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrashViewModel}}, Path=RestoreCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.RotateCcw}" Size="15" Color="{DynamicResource tp-accent-text}" />
                                                </Button.ImageSource>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56"
                                  HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="14" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Trash}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Trash_Empty}" Style="{StaticResource Text.EmptyText}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
