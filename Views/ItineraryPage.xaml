<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.ItineraryPage"
             x:DataType="vm:ItineraryViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- ════════ App bar: ← "Gün gün plan" / trip name (centred) [sil] ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="44,*,44" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.Itinerary_Title}" Style="{StaticResource Text.AppBarTitle}" />
                <Label Text="{Binding Trip.Name}" Style="{StaticResource Text.AppBarSubtitle}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Delete}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- ════════ Day strip: 92 wide cards, "3. Gün" / "Paz 25 Eki" / "4 etkinlik" / Bugün ════════ -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="16,12">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Days}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItineraryDay">
                        <Border WidthRequest="92" Padding="10" StrokeShape="RoundRectangle 16" StrokeThickness="1"
                                BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}"
                                SemanticProperties.Description="{Binding DateLabel}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource tp-primary}" />
                                    <Setter Property="Stroke" Value="{DynamicResource tp-primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=SelectDayCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="13" TextColor="{DynamicResource tp-text}" MaxLines="1">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding DateLabel}" FontSize="12" TextColor="{DynamicResource tp-text-3}" MaxLines="1" Margin="0,2,0,0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                            <Setter Property="Opacity" Value="0.85" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding CountText}" FontSize="11.5" TextColor="{DynamicResource tp-text-3}" MaxLines="1" Margin="0,6,0,0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                            <Setter Property="Opacity" Value="0.85" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border IsVisible="{Binding IsToday}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2" Margin="0,6,0,0"
                                        HorizontalOptions="Start" BackgroundColor="{DynamicResource tp-success-soft}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#33FFFFFF" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{x:Static res:AppResources.Itinerary_TodayBadge}" FontFamily="InterBold" FontSize="10.5" TextColor="{DynamicResource tp-success}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <!-- ════════ Notices + "3. Gün · Paz 25 Eki" + drag hint ════════ -->
            <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="16,0,16,12">
                <!-- Part of the plan can't be shown (trip longer than the day limit / activities outside the trip dates). -->
                <Border IsVisible="{Binding HasRangeNotice}" Style="{StaticResource Banner.Warning}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-warning}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{Binding RangeNotice}" FontSize="13" TextColor="{DynamicResource tp-warning}" />
                    </Grid>
                </Border>
                <Label Margin="4,0" IsVisible="{Binding SelectedDay, Converter={StaticResource ObjectNotNullConverter}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SelectedDay.Title}" FontFamily="InterBold" FontSize="17" TextColor="{DynamicResource tp-text}" />
                            <Span Text=" · " FontFamily="InterMedium" FontSize="14" TextColor="{DynamicResource tp-text-3}" />
                            <Span Text="{Binding SelectedDay.DateLabel}" FontFamily="InterMedium" FontSize="14" TextColor="{DynamicResource tp-text-3}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="4,-4,4,0" IsVisible="{Binding ShowDragHint}">
                    <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="14" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Start" Margin="0,1,0,0" />
                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Itinerary_DragHint}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                </Grid>
            </VerticalStackLayout>

            <controls:LoadingLogo Grid.Row="1" IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout Grid.Row="1" IsVisible="{Binding HasNoActivities}" Spacing="0" Padding="32,24" VerticalOptions="Start">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon}" FontSize="30" Text="{StaticResource Ic.CalendarDays}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Itinerary_Empty}" Style="{StaticResource Text.EmptyText}" Margin="0,16,0,0" />
            </VerticalStackLayout>

            <RefreshView Grid.Row="1" IsVisible="{Binding HasActivities}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
                <CollectionView x:Name="ActivitiesCollectionView" ItemsSource="{Binding DayActivities}" SelectionMode="None">
                    <CollectionView.Footer>
                        <BoxView HeightRequest="112" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TripActivity">
                            <!-- One slice of the day's card (Helpers/ListPositions). ClassId marks the row for ItineraryPage.FindRow
                                 (the row lifts while its grip is dragged). -->
                            <Border ClassId="ItineraryRow" BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0"
                                    StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}"
                                    Margin="{Binding ListPosition, Converter={StaticResource ListPositionMarginConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=ActivityTappedCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,52,*,Auto" ColumnSpacing="12" Padding="16,12,0,12" BackgroundColor="Transparent">
                                    <controls:SelectCircle Grid.Column="0" IsOn="{Binding IsSelected}" VerticalOptions="Start"
                                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=Selection.IsActive}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Start">
                                        <Label Text="{Binding StartTimeDisplay}" IsVisible="{Binding HasTime}" FontFamily="InterBold" FontSize="14" TextColor="{DynamicResource tp-text}" />
                                        <Label Text="{Binding EndTimeDisplay}" IsVisible="{Binding HasEndTime}" FontSize="12" TextColor="{DynamicResource tp-text-3}" />
                                        <Label Text="{x:Static res:AppResources.Itinerary_AnyTime}" FontFamily="InterSemiBold" FontSize="12" TextColor="{DynamicResource tp-info}"
                                               IsVisible="{Binding HasTime, Converter={StaticResource InvertBoolConverter}}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" Margin="0,0,16,0">
                                        <Label Text="{Binding Title}" FontFamily="InterMedium" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                        <HorizontalStackLayout Spacing="4" IsVisible="{Binding HasPlace}">
                                            <Label Style="{StaticResource Icon}" FontSize="12" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-accent-text}" />
                                            <Label Text="{Binding PlaceName}" FontSize="12.5" TextColor="{DynamicResource tp-accent-text}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <!-- Reorder: press the grip and move up/down (ItineraryPage.xaml.cs). Hidden for viewers and while selecting. -->
                                    <controls:DragHandle Grid.Column="3" WidthRequest="44" VerticalOptions="Fill" Margin="-12,-12,0,-12"
                                                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=ShowEditActions}"
                                                         SemanticProperties.Description="{x:Static res:AppResources.Itinerary_ReorderHandle}"
                                                         DragStarted="OnHandleDragStarted" DragMoved="OnHandleDragMoved" DragEnded="OnHandleDragEnded">
                                        <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Grip}" TextColor="{DynamicResource tp-text-3}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </controls:DragHandle>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource Fab}" SemanticProperties.Description="{x:Static res:AppResources.Activity_TitleAdd}" IsVisible="{Binding ShowEditActions}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddActivityCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" FontSize="26" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-accent}" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
