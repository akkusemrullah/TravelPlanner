<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.ItineraryPage"
             x:DataType="vm:ItineraryViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" Margin="4,0,0,0">
                <Label Text="{x:Static res:AppResources.Itinerary_Title}" Style="{StaticResource Text.AppBarTitle}" />
                <Label Text="{Binding Trip.Name}" Style="{StaticResource Text.Caption}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Delete}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <BoxView Style="{StaticResource Divider}" />
            <!-- Part of the plan can't be shown (trip longer than the day limit / activities outside the trip dates). -->
            <Grid IsVisible="{Binding HasRangeNotice}" ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="16,8"
                  BackgroundColor="{DynamicResource tp-surface}">
                <Label Grid.Column="0" Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Start" />
                <Label Grid.Column="1" Text="{Binding RangeNotice}" Style="{StaticResource Text.Caption}" />
            </Grid>
        </VerticalStackLayout>

        <!-- ════════ Day strip ════════ -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{DynamicResource tp-surface}" Padding="16,12">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Days}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItineraryDay">
                        <Border Style="{StaticResource Chip}" Padding="12,8" MinimumWidthRequest="76" StrokeShape="RoundRectangle 10"
                                SemanticProperties.Description="{Binding DateLabel}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource tp-primary}" />
                                    <Setter Property="Stroke" Value="{DynamicResource tp-primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=SelectDayCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{x:Static res:AppResources.Itinerary_TodayBadge}" IsVisible="{Binding IsToday}" Style="{StaticResource Text.Overline}"
                                       FontSize="9" HorizontalOptions="Center" TextColor="{DynamicResource tp-accent-text}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="13" HorizontalOptions="Center" TextColor="{DynamicResource tp-text}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding DateLabel}" FontSize="11" HorizontalOptions="Center" TextColor="{DynamicResource tp-text-2}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding ActivityCount, StringFormat={x:Static res:AppResources.Itinerary_ActivityCountFormat}}"
                                       FontSize="10" HorizontalOptions="Center" TextColor="{DynamicResource tp-text-3}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>
        <BoxView Grid.Row="3" Style="{StaticResource Divider}" />

        <Grid Grid.Row="4">
            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoActivities}" Spacing="14" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.CalendarDays}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Itinerary_Empty}" Style="{StaticResource EmptyStateTextLabel}" />
            </VerticalStackLayout>

            <Grid IsVisible="{Binding HasActivities}" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="20,12,16,4" IsVisible="{Binding ShowEditActions}">
                    <Label Grid.Column="0" Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Grip}" TextColor="{DynamicResource tp-text-3}" />
                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Itinerary_DragHint}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                </Grid>
                <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
                    <CollectionView x:Name="ActivitiesCollectionView" ItemsSource="{Binding DayActivities}" SelectionMode="None">
                        <CollectionView.Header>
                            <BoxView HeightRequest="8" Color="Transparent" />
                        </CollectionView.Header>
                        <CollectionView.Footer>
                            <BoxView HeightRequest="96" Color="Transparent" />
                        </CollectionView.Footer>
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TripActivity">
                                    <!-- ClassId marks the row for ItineraryPage.FindRow (the row lifts while its grip is dragged). -->
                                    <Border Style="{StaticResource Card.Compact}" Margin="16,0" HorizontalOptions="Fill" ClassId="ItineraryRow">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                                <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=ActivityTappedCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                                            <!-- Selection mode: the tick takes the time column's place. -->
                                            <Label Grid.Column="0" Style="{StaticResource Icon}" Text="{StaticResource Ic.Circle}" TextColor="{DynamicResource tp-text-3}"
                                                   MinimumWidthRequest="44"
                                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=Selection.IsActive}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Text" Value="{StaticResource Ic.CheckCircle}" />
                                                        <Setter Property="TextColor" Value="{DynamicResource tp-accent}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" MinimumWidthRequest="44"
                                                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=Selection.IsInactive}">
                                                <Label Text="{Binding TimeDisplay}" IsVisible="{Binding HasTime}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text}" />
                                                <Label Text="{x:Static res:AppResources.Itinerary_AnyTime}" Style="{StaticResource Text.Caption}"
                                                       IsVisible="{Binding HasTime, Converter={StaticResource InvertBoolConverter}}" />
                                            </VerticalStackLayout>
                                            <BoxView Grid.Column="1" WidthRequest="2" Color="{DynamicResource tp-accent}" VerticalOptions="Fill" />
                                            <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" Style="{StaticResource Text.Title}" />
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" IsVisible="{Binding HasPlace}">
                                                    <Label Grid.Column="0" Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-text-3}" />
                                                    <Label Grid.Column="1" Text="{Binding PlaceName}" Style="{StaticResource Text.Caption}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                </Grid>
                                                <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" Style="{StaticResource Text.Body2}" FontSize="12"
                                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <!-- Reorder: press the grip and move up/down (ItineraryPage.xaml.cs). Hidden for viewers and while selecting. -->
                                            <controls:DragHandle Grid.Column="3" WidthRequest="40" VerticalOptions="Fill" Margin="0,-6,-6,-6"
                                                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ItineraryViewModel}}, Path=ShowEditActions}"
                                                                 SemanticProperties.Description="{x:Static res:AppResources.Itinerary_ReorderHandle}"
                                                                 DragStarted="OnHandleDragStarted" DragMoved="OnHandleDragMoved" DragEnded="OnHandleDragEnded">
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Grip}" TextColor="{DynamicResource tp-text-3}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </controls:DragHandle>
                                        </Grid>
                                    </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

        <Border Style="{StaticResource Fab}" SemanticProperties.Description="{x:Static res:AppResources.Activity_TitleAdd}" IsVisible="{Binding ShowEditActions}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddActivityCommand}" />
            </Border.GestureRecognizers>
            <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-accent}" />
        </Border>
        </Grid>
    </Grid>
</ContentPage>
