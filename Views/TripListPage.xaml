<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.TripListPage"
             x:DataType="vm:TripListViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Tab root (Trips). -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ════════ Header ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource PageHeader}" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding Selection.IsInactive}">
            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.Nav_Trips}" Style="{StaticResource Text.Overline}" />
                <Label Text="{x:Static res:AppResources.Section_MyTrips}" Style="{StaticResource Text.H1}" SemanticProperties.HeadingLevel="Level1" />
            </VerticalStackLayout>
            <Border Grid.Column="1" Style="{StaticResource IconButton}" VerticalOptions="End" IsVisible="{Binding HasTrips}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Delete}" />
            </Border>
            <Border Grid.Column="2" Style="{StaticResource IconButton.Filled}" VerticalOptions="End"
                    SemanticProperties.Description="{x:Static res:AppResources.A11y_Add}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAddTripCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-primary}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />

        <!-- ════════ Search / filter / sort ════════ -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding ShowFilterBar}" Spacing="12" Padding="16,0,16,14"
                             BackgroundColor="{DynamicResource tp-surface}">
            <!-- SearchBar draws its own magnifier/clear icons; the Border only supplies the field chrome. -->
            <Border Style="{StaticResource Input}" Padding="2,0">
                <SearchBar Text="{Binding SearchText}" Placeholder="{x:Static res:AppResources.TripList_SearchPlaceholder}"
                           SemanticProperties.Description="{x:Static res:AppResources.TripList_SearchPlaceholder}" />
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding StatusFilters}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TripStatusFilterOption">
                            <Border Style="{StaticResource Chip}" SemanticProperties.Description="{Binding Label}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource tp-primary}" />
                                        <Setter Property="Stroke" Value="{DynamicResource tp-primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TripListViewModel}}, Path=SelectStatusFilterCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontFamily="InterMedium" FontSize="13" TextColor="{DynamicResource tp-text-2}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Sliders}" TextColor="{DynamicResource tp-text-3}" />
                    <Label Text="{x:Static res:AppResources.TripList_SortTitle}" Style="{StaticResource Text.Field}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border Grid.Column="1" Style="{StaticResource Input}" MinimumHeightRequest="40">
                    <Picker ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                            Title="{x:Static res:AppResources.TripList_SortTitle}" FontSize="14" />
                </Border>
            </Grid>
        </VerticalStackLayout>
        <BoxView Grid.Row="2" Style="{StaticResource Divider}" />

        <!-- ════════ List ════════ -->
        <Grid Grid.Row="3">
            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadTripsCommand}" IsVisible="{Binding HasTrips}">
                <CollectionView x:Name="TripsCollectionView" ItemsSource="{Binding Trips}" SelectionMode="None">
                    <CollectionView.Header>
                        <BoxView HeightRequest="16" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="24" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Trip">
                                <Border Style="{StaticResource Card.Compact}" Margin="16,0" HorizontalOptions="Fill">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource tp-accent-soft}" />
                                            <Setter Property="Stroke" Value="{DynamicResource tp-accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TripListViewModel}}, Path=TripTappedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}" VerticalOptions="Start">
                                            <Grid>
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Briefcase}"
                                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TripListViewModel}}, Path=Selection.IsInactive}" />
                                                <!-- Selection mode: the tile shows the tick. -->
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Circle}" TextColor="{DynamicResource tp-text-3}"
                                                       IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TripListViewModel}}, Path=Selection.IsActive}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Text" Value="{StaticResource Ic.CheckCircle}" />
                                                            <Setter Property="TextColor" Value="{DynamicResource tp-accent}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Text.Title}" VerticalOptions="Center" />
                                                <Border Grid.Column="1" Style="{StaticResource Tag}"
                                                        BackgroundColor="{Binding Status, Converter={StaticResource TripTagColorConverter}}">
                                                    <Label Text="{Binding StatusTag}" Style="{StaticResource Tag.Text}"
                                                           TextColor="{Binding Status, Converter={StaticResource TripTagColorConverter}, ConverterParameter=Foreground}" />
                                                </Border>
                                            </Grid>
                                            <Label Text="{Binding City}" Style="{StaticResource Text.Body2}" LineBreakMode="TailTruncation" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding CompactDateRangeDisplay}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding FormattedBudget}" Style="{StaticResource Text.Value}" FontSize="14" />
                                            </Grid>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}"
                                               TextColor="{DynamicResource tp-text-3}" />
                                    </Grid>
                                </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- No trips at all -->
            <VerticalStackLayout IsVisible="{Binding HasNoTrips}" Spacing="16" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Trips}" TextColor="{DynamicResource tp-text-2}" />
                </Border>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static res:AppResources.TripList_Empty}" Style="{StaticResource Text.H3}" HorizontalTextAlignment="Center" />
                    <Label Text="{x:Static res:AppResources.TripList_EmptyHint}" Style="{StaticResource EmptyStateTextLabel}" />
                </VerticalStackLayout>
                <Button Text="{x:Static res:AppResources.Dashboard_CreateTrip}" Command="{Binding GoToAddTripCommand}"
                        Style="{StaticResource Btn.Primary}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Filters match nothing -->
            <VerticalStackLayout IsVisible="{Binding HasNoResults}" Spacing="16" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Search}" TextColor="{DynamicResource tp-text-2}" />
                </Border>
                <Label Text="{x:Static res:AppResources.TripList_NoResults}" Style="{StaticResource EmptyStateTextLabel}" />
                <Button Text="{x:Static res:AppResources.TripList_ClearFilters}" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource Btn.Secondary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
