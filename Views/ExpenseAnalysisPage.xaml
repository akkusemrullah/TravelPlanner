<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.ExpenseAnalysisPage"
             x:DataType="vm:ExpenseAnalysisViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" Margin="0,0,44,0">
                <Label Text="{x:Static res:AppResources.Analysis_Title}" Style="{StaticResource Text.AppBarTitle}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Trip.Name, FallbackValue=''}" Style="{StaticResource Text.Caption}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <Grid Grid.Row="2">
            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoData}" Spacing="12" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.PieChart}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Analysis_Empty}" Style="{StaticResource Text.EmptyText}" />
            </VerticalStackLayout>

            <RefreshView IsVisible="{Binding HasData}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
                <ScrollView>
                    <!-- TP-104: the prototype's analysis - three summary cards, the donut with its legend, the daily bars -->
                    <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{x:Static res:AppResources.Analysis_Total}" FontSize="11.5" TextColor="{DynamicResource tp-text-3}" />
                                    <Label Text="{Binding TotalFormatted}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{x:Static res:AppResources.Analysis_DailyAverage}" FontSize="11.5" TextColor="{DynamicResource tp-text-3}" />
                                    <Label Text="{Binding DailyAverageFormatted}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{x:Static res:AppResources.Analysis_HighestDay}" FontSize="11.5" TextColor="{DynamicResource tp-text-3}" />
                                    <Label Text="{Binding HighestDayAmount}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                    <Label Text="{Binding HighestDayDate}" FontSize="11" TextColor="{DynamicResource tp-text-3}" Margin="0,-2,0,0"
                                           IsVisible="{Binding HighestDayDate, Converter={StaticResource StringNotEmptyConverter}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- ════════ By category ════════ -->
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{x:Static res:AppResources.Analysis_ByCategory}" FontFamily="InterSemiBold" FontSize="15" TextColor="{DynamicResource tp-text}"
                                       SemanticProperties.HeadingLevel="Level2" />
                                <GraphicsView x:Name="CategoryChartView" Drawable="{Binding CategoryChart}" HeightRequest="180" WidthRequest="180" HorizontalOptions="Center"
                                              SemanticProperties.Description="{x:Static res:AppResources.Analysis_ByCategory}" />
                                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Categories}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryBreakdownItem">
                                            <VerticalStackLayout Spacing="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto,92" ColumnSpacing="8">
                                                    <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10" Fill="{Binding Brush}" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Label}" FontSize="13.5" TextColor="{DynamicResource tp-text}" VerticalOptions="Center" />
                                                    <Label Grid.Column="2" Text="{Binding PercentText}" FontSize="13.5" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                                                    <Label Grid.Column="3" Text="{Binding FormattedTotal}" FontFamily="InterSemiBold" FontSize="13.5" TextColor="{DynamicResource tp-text}"
                                                           HorizontalTextAlignment="End" VerticalOptions="Center" />
                                                </Grid>
                                                <controls:ProgressPill Progress="{Binding Fraction}" BarHeight="6" FillColor="{Binding Color}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ════════ By day ════════ -->
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{x:Static res:AppResources.Analysis_ByDay}" FontFamily="InterSemiBold" FontSize="15" TextColor="{DynamicResource tp-text}"
                                       SemanticProperties.HeadingLevel="Level2" />
                                <GraphicsView x:Name="DailyChartView" Drawable="{Binding DailyChart}" HeightRequest="170"
                                              SemanticProperties.Description="{Binding DailyChartDescription}" />
                                <Grid IsVisible="{Binding HasDailyBudget}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Line Grid.Column="0" X1="0" Y1="1" X2="20" Y2="1" Stroke="{DynamicResource tp-warning}" StrokeThickness="2" StrokeDashArray="2.5,2"
                                          WidthRequest="20" HeightRequest="2" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding DailyBudgetText}" FontSize="12" TextColor="{DynamicResource tp-text-3}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
