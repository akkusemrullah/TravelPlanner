<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.ExpenseAnalysisPage"
             x:DataType="vm:ExpenseAnalysisViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Analysis_Title}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <Grid Grid.Row="2">
            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoData}" Spacing="14" Padding="32" VerticalOptions="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.BarChart}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Analysis_Empty}" Style="{StaticResource EmptyStateTextLabel}" />
            </VerticalStackLayout>

            <RefreshView IsVisible="{Binding HasData}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
                <ScrollView>
                    <VerticalStackLayout Padding="16,20,16,28" Spacing="20">

                        <!-- Summary figures as label/value rows: amounts (and "highest day" with its date) get the full width. -->
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                                    <Label Grid.Column="0" Text="{x:Static res:AppResources.Analysis_Total}" Style="{StaticResource Text.Body2}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding TotalFormatted}" Style="{StaticResource Text.Value}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider.Inset}" Margin="16,0,0,0" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                                    <Label Grid.Column="0" Text="{x:Static res:AppResources.Analysis_DailyAverage}" Style="{StaticResource Text.Body2}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding DailyAverageFormatted}" Style="{StaticResource Text.Value}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider.Inset}" Margin="16,0,0,0" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                                    <Label Grid.Column="0" Text="{x:Static res:AppResources.Analysis_HighestDay}" Style="{StaticResource Text.Body2}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding HighestDayFormatted}" Style="{StaticResource Text.Value}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ════════ By category ════════ -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{x:Static res:AppResources.Analysis_ByCategory}" Style="{StaticResource Text.Overline}" Margin="4,0" SemanticProperties.HeadingLevel="Level2" />
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="16">
                                    <GraphicsView x:Name="CategoryChartView" Drawable="{Binding CategoryChart}" HeightRequest="16"
                                                  SemanticProperties.Description="{x:Static res:AppResources.Analysis_ByCategory}" />
                                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Categories}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryBreakdownItem">
                                                <VerticalStackLayout Spacing="6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                        <BoxView Grid.Column="0" WidthRequest="10" HeightRequest="10" CornerRadius="2" Color="{Binding Color}" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Text.Body}" FontSize="14" VerticalOptions="Center" />
                                                        <Label Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                                                        <Label Grid.Column="3" Text="{Binding FormattedTotal}" Style="{StaticResource Text.Value}" FontSize="14" VerticalOptions="Center" />
                                                    </Grid>
                                                    <ProgressBar Progress="{Binding Fraction}" ProgressColor="{Binding Color}" HeightRequest="4" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ════════ By day ════════ -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{x:Static res:AppResources.Analysis_ByDay}" Style="{StaticResource Text.Overline}" Margin="4,0" SemanticProperties.HeadingLevel="Level2" />
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <GraphicsView x:Name="DailyChartView" Drawable="{Binding DailyChart}" HeightRequest="200"
                                                  SemanticProperties.Description="{Binding DailyChartDescription}" />
                                    <Grid IsVisible="{Binding HasDailyBudget}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <BoxView Grid.Column="0" WidthRequest="14" HeightRequest="2" Color="{DynamicResource tp-accent}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding DailyBudgetText}" Style="{StaticResource Text.Caption}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
