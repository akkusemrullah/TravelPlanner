<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             x:Class="TravelPlanner.Views.PlaceFormPage"
             x:DataType="vm:PlaceFormViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Close}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{x:Static res:AppResources.Page_Place}" Style="{StaticResource Text.AppBarTitle}" Margin="0,0,44,0" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <ScrollView Grid.Row="2">
            <!-- TP-103: the prototype's form - plain fields, the suggestions right under the name -->
            <VerticalStackLayout Padding="16,16,16,32" Spacing="16">
                <Border IsVisible="{Binding IsLocationFromMap}" Style="{StaticResource Banner.Accent}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.Place_FromMapHint}" FontSize="13" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.Place_NameLabel}" Style="{StaticResource Text.Field}" />
                        <Label Grid.Column="1" Text="{Binding Name.Length, StringFormat='{0}/150'}" Style="{StaticResource Text.Counter}" />
                    </Grid>
                    <Border Style="{StaticResource Input}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Style="{StaticResource Input.Icon}" Text="{StaticResource Ic.Pin}" />
                            <Entry Keyboard="{x:Static helpers:AppKeyboards.Words}" Grid.Column="1" Text="{Binding Name}" MaxLength="150" Placeholder="{x:Static res:AppResources.Place_NamePlaceholder}" />
                        </Grid>
                    </Border>
                    <Label Text="{x:Static res:AppResources.Place_LocationHint}" Style="{StaticResource Text.Hint}" />
                    <Border IsVisible="{Binding IsOffline}" Style="{StaticResource Banner.Warning}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.WifiOff}" TextColor="{DynamicResource tp-warning}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{x:Static res:AppResources.Place_SuggestionsOffline}" FontSize="13" TextColor="{DynamicResource tp-warning}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SuggestionsBorder}" IsVisible="{Binding IsNameSuggestionsVisible}">
                        <CollectionView ItemsSource="{Binding NameSuggestions}" SelectionMode="None" MaximumHeightRequest="300">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PlaceSuggestion">
                                    <Grid Padding="14,10" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaceFormViewModel}}, Path=SelectPlaceCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-text-3}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding Name}" FontFamily="InterMedium" FontSize="14.5" TextColor="{DynamicResource tp-text}" />
                                            <Label Text="{Binding DisplayRegion}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.Common_DescriptionLabel}" Style="{StaticResource Text.Field}" />
                        <Label Grid.Column="1" Text="{Binding Description.Length, StringFormat='{0}/500'}" Style="{StaticResource Text.Counter}" />
                    </Grid>
                    <Border Style="{StaticResource Input.Multiline}" MinimumHeightRequest="96">
                        <Editor Text="{Binding Description}" AutoSize="TextChanges" MaxLength="500" Placeholder="{x:Static res:AppResources.Common_OptionalNote}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ════════ Action bar ════════ -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" BackgroundColor="{DynamicResource tp-surface}">
            <BoxView Grid.Row="0" Style="{StaticResource Divider}" />
            <VerticalStackLayout Grid.Row="1" Spacing="10" Padding="16,12">
                <Border IsVisible="{Binding HasValidationError}" Style="{StaticResource Banner.Error}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-danger}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{Binding ValidationMessage}" FontSize="13" TextColor="{DynamicResource tp-danger}" />
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="{x:Static res:AppResources.Common_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource Btn.Secondary}" />
                    <Button Grid.Column="1" Text="{x:Static res:AppResources.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource Btn.Primary}" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
