<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Tab root (Home). Navigation lives in the Shell TabBar (AppShell.xaml), so this page no longer draws
         its own bottom bar. -->
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- ════════ Header ════════ -->
                <Grid Style="{StaticResource PageHeader}" ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{Binding TodayDisplay}" Style="{StaticResource Text.Overline}" />
                        <Label Text="{Binding GreetingText}" Style="{StaticResource Text.H1}" SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{x:Static res:AppResources.Dashboard_Subtitle}" Style="{StaticResource Text.Body2}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1" Style="{StaticResource IconButton.Filled}" VerticalOptions="Start"
                            SemanticProperties.Description="{x:Static res:AppResources.A11y_Add}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAddTripCommand}" />
                        </Border.GestureRecognizers>
                        <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-primary}" />
                    </Border>
                </Grid>
                <BoxView Style="{StaticResource Divider}" />

                <VerticalStackLayout Padding="16,20,16,28" Spacing="24">

                    <!-- ════════ Notice from the admin panel, or "a new version is out" (tap opens the store) ════════ -->
                    <Border IsVisible="{Binding HasNotice}" Style="{StaticResource Banner.Info}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNoticeCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-info}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding NoticeText}" FontSize="13" TextColor="{DynamicResource tp-text}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <Label Grid.Column="2" IsVisible="{Binding CanCloseNotice}" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Close}"
                                   TextColor="{DynamicResource tp-text-3}" VerticalOptions="Start" Padding="8,0,0,8"
                                   SemanticProperties.Description="{x:Static res:AppResources.A11y_CloseNotice}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseNoticeCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <!-- ════════ Featured trip (boarding-pass ticket, see Card.Ticket in Styles.xaml) ════════ -->
                    <Border IsVisible="{Binding HasFeaturedTrip}" Style="{StaticResource Card.Ticket}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFeaturedDetailsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top: royal-blue gradient - status, countdown, destination, departure ✈ return. -->
                        <!-- BindingContext is set on a wrapper so the inner x:DataType (TripTicket) doesn't apply to it. -->
                        <ContentView Grid.Row="0" BindingContext="{Binding FeaturedTicket}">
                        <Grid Padding="20,18,20,18" RowSpacing="16" RowDefinitions="Auto,Auto,Auto" x:DataType="vm:TripTicket">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource TicketStart}" Offset="0" />
                                    <GradientStop Color="{StaticResource TicketEnd}" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Style="{StaticResource Ticket.Pill}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Plane}" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                        <Label Text="{Binding StatusText}" Style="{StaticResource Ticket.PillText}" />
                                    </HorizontalStackLayout>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                    <Label Text="{Binding CountdownValue}" Style="{StaticResource Ticket.Countdown}" />
                                    <Label Text="{Binding CountdownLabel}" IsVisible="{Binding HasCountdownLabel}" Style="{StaticResource Ticket.Muted}"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="{Binding City}" Style="{StaticResource Ticket.City}" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{Binding Country}" IsVisible="{Binding HasCountry}" Style="{StaticResource Ticket.Sub}" />
                                <Label Text="{Binding Name}" IsVisible="{Binding ShowName}" Style="{StaticResource Ticket.Muted}" Margin="0,2,0,0" />
                            </VerticalStackLayout>

                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Label Text="{x:Static res:AppResources.Ticket_Departure}" Style="{StaticResource Ticket.Caption}" />
                                    <Label Text="{Binding StartDay}" Style="{StaticResource Ticket.Day}" />
                                    <Label Text="{Binding StartMonth}" Style="{StaticResource Ticket.Muted}" />
                                </VerticalStackLayout>
                                <!-- Route line: fills as the trip goes by; the plane rides above it. -->
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Plane}" Rotation="45"
                                           TextColor="{StaticResource White}" HorizontalOptions="Center" />
                                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource White}"
                                                 BackgroundColor="Transparent" HeightRequest="4" />
                                    <Label Text="{Binding DurationText}" Style="{StaticResource Ticket.Muted}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="0">
                                    <Label Text="{x:Static res:AppResources.Ticket_Return}" Style="{StaticResource Ticket.Caption}" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding EndDay}" Style="{StaticResource Ticket.Day}" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding EndMonth}" Style="{StaticResource Ticket.Muted}" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                        </ContentView>

                        <!-- Tear line: dashed rule between two page-coloured notches (clipped into half circles). -->
                        <Grid Grid.Row="1">
                            <Grid IsClippedToBounds="True" Margin="24,0" HeightRequest="2" VerticalOptions="Center">
                                <Line X1="0" Y1="1" X2="3000" Y2="1" Stroke="{DynamicResource tp-border-strong}"
                                      StrokeThickness="1.5" StrokeDashArray="3,3" />
                            </Grid>
                            <BoxView Style="{StaticResource Ticket.Notch}" HorizontalOptions="Start" Margin="-12,0,0,0" />
                            <BoxView Style="{StaticResource Ticket.Notch}" HorizontalOptions="End" Margin="0,0,-12,0" />
                        </Grid>

                        <!-- Bottom: duration and budget. -->
                        <ContentView Grid.Row="2" BindingContext="{Binding FeaturedTicket}">
                        <Grid Padding="20,4,20,16" ColumnDefinitions="*,1,*" ColumnSpacing="16" x:DataType="vm:TripTicket">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{x:Static res:AppResources.Ticket_Duration}" Style="{StaticResource Ticket.StatLabel}" />
                                <Label Text="{Binding DurationText}" Style="{StaticResource Ticket.StatValue}" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" WidthRequest="1" Color="{DynamicResource tp-divider}" />
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="{x:Static res:AppResources.Budget_Title}" Style="{StaticResource Ticket.StatLabel}" />
                                <Label Text="{Binding BudgetText}" Style="{StaticResource Ticket.StatValue}" />
                            </VerticalStackLayout>
                        </Grid>
                        </ContentView>

                        <!-- Actions. -->
                        <Grid Grid.Row="3" Padding="20,0,20,18" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="{x:Static res:AppResources.Dashboard_WeatherShort}" Command="{Binding OpenFeaturedWeatherCommand}"
                                    Style="{StaticResource Btn.Secondary.Sm}" ContentLayout="Left,6">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Weather}" Size="15" Color="{DynamicResource tp-accent-text}" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Column="1" Text="{x:Static res:AppResources.Section_Map}" Command="{Binding OpenFeaturedMapCommand}"
                                    Style="{StaticResource Btn.Secondary.Sm}" ContentLayout="Left,6">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Map}" Size="15" Color="{DynamicResource tp-info}" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Column="2" Text="{x:Static res:AppResources.Dashboard_Details}" Command="{Binding OpenFeaturedDetailsCommand}"
                                    Style="{StaticResource Btn.Primary.Sm}" />
                        </Grid>
                        </Grid>
                    </Border>

                    <!-- ════════ Empty state ════════ -->
                    <!-- A blank boarding pass ("Nereye?") in the same ticket style as the featured trip, so the first
                         screen already looks like the app; then a short list of what the app can do. -->
                    <VerticalStackLayout IsVisible="{Binding HasNoTrips}" Spacing="24">
                        <Border Style="{StaticResource Card.Ticket}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToAddTripCommand}" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,24,Auto">
                                <Grid Grid.Row="0" Padding="20,18,20,18" RowSpacing="16" RowDefinitions="Auto,Auto,Auto">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource TicketStart}" Offset="0" />
                                            <GradientStop Color="{StaticResource TicketEnd}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.Background>

                                    <Border Grid.Row="0" Style="{StaticResource Ticket.Pill}">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Star}" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                            <Label Text="{x:Static res:AppResources.Dashboard_EmptyBadge}" Style="{StaticResource Ticket.PillText}" />
                                        </HorizontalStackLayout>
                                    </Border>

                                    <VerticalStackLayout Grid.Row="1" Spacing="2">
                                        <Label Text="{x:Static res:AppResources.Dashboard_EmptyWhere}" Style="{StaticResource Ticket.City}" SemanticProperties.HeadingLevel="Level2" />
                                        <Label Text="{x:Static res:AppResources.Dashboard_EmptyTitle}" Style="{StaticResource Ticket.Sub}" />
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                                            <Label Text="{x:Static res:AppResources.Ticket_Departure}" Style="{StaticResource Ticket.Caption}" />
                                            <Label Text="--" Style="{StaticResource Ticket.Day}" />
                                        </VerticalStackLayout>
                                        <!-- Dashed route with the plane above it: the trip that isn't planned yet. -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Plane}" Rotation="45"
                                                   TextColor="{StaticResource White}" HorizontalOptions="Center" />
                                            <Grid IsClippedToBounds="True" HeightRequest="2">
                                                <Line X1="0" Y1="1" X2="3000" Y2="1" Stroke="{StaticResource White}" Opacity="0.6"
                                                      StrokeThickness="1.5" StrokeDashArray="3,3" />
                                            </Grid>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="0">
                                            <Label Text="{x:Static res:AppResources.Ticket_Return}" Style="{StaticResource Ticket.Caption}" HorizontalTextAlignment="End" />
                                            <Label Text="--" Style="{StaticResource Ticket.Day}" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>

                                <!-- Tear line, as on the featured ticket. -->
                                <Grid Grid.Row="1">
                                    <Grid IsClippedToBounds="True" Margin="24,0" HeightRequest="2" VerticalOptions="Center">
                                        <Line X1="0" Y1="1" X2="3000" Y2="1" Stroke="{DynamicResource tp-border-strong}"
                                              StrokeThickness="1.5" StrokeDashArray="3,3" />
                                    </Grid>
                                    <BoxView Style="{StaticResource Ticket.Notch}" HorizontalOptions="Start" Margin="-12,0,0,0" />
                                    <BoxView Style="{StaticResource Ticket.Notch}" HorizontalOptions="End" Margin="0,0,-12,0" />
                                </Grid>

                                <VerticalStackLayout Grid.Row="2" Padding="20,0,20,18" Spacing="14">
                                    <Label Text="{x:Static res:AppResources.Dashboard_EmptyBody}" Style="{StaticResource Text.Body2}" />
                                    <Button Text="{x:Static res:AppResources.Dashboard_CreateTrip}" Command="{Binding GoToAddTripCommand}"
                                            Style="{StaticResource Btn.Primary}" HorizontalOptions="Fill" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="{x:Static res:AppResources.Dashboard_FeaturesTitle}" Style="{StaticResource Text.Overline}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,12">
                                        <Border Grid.Column="0" Style="{StaticResource IconTile.Tint}">
                                            <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.CalendarDays}" TextColor="{DynamicResource tp-accent-text}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeaturePlan}" Style="{StaticResource Text.Title}" />
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeaturePlanBody}" Style="{StaticResource Text.Caption}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,12">
                                        <Border Grid.Column="0" Style="{StaticResource IconTile.Success}">
                                            <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Wallet}" TextColor="{DynamicResource tp-success}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeatureBudget}" Style="{StaticResource Text.Title}" />
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeatureBudgetBody}" Style="{StaticResource Text.Caption}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,12">
                                        <Border Grid.Column="0" Style="{StaticResource IconTile.Info}">
                                            <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Users}" TextColor="{DynamicResource tp-info}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeatureShare}" Style="{StaticResource Text.Title}" />
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeatureShareBody}" Style="{StaticResource Text.Caption}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,12">
                                        <Border Grid.Column="0" Style="{StaticResource IconTile.Warning}">
                                            <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Compass}" TextColor="{DynamicResource tp-warning}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeatureAi}" Style="{StaticResource Text.Title}" />
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeatureAiBody}" Style="{StaticResource Text.Caption}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ════════ KPIs ════════ -->
                    <VerticalStackLayout IsVisible="{Binding HasAnyTrips}" Spacing="12">
                        <Label Text="{x:Static res:AppResources.Dashboard_Overview}" Style="{StaticResource Text.Overline}" />
                        <!-- Three count tiles side by side (short numbers), the money total on its own full-width row:
                             amounts and labels like "Toplam Harcama" never have to squeeze into a third of the screen. -->
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card.Compact}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding TotalTripsCount}" Style="{StaticResource Text.Metric}" />
                                    <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Trips}" VerticalOptions="Start" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static res:AppResources.Dashboard_TotalTrips}"
                                           Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card.Compact}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding VisitedCountriesCount}" Style="{StaticResource Text.Metric}" />
                                    <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Globe}" VerticalOptions="Start" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static res:AppResources.Dashboard_VisitedCountries}"
                                           Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card.Compact}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding VisitedCitiesCount}" Style="{StaticResource Text.Metric}" />
                                    <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Landmark}" VerticalOptions="Start" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static res:AppResources.Dashboard_VisitedCities}"
                                           Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card.Compact}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Style="{StaticResource IconTile.Success}">
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Wallet}" TextColor="{DynamicResource tp-success}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{x:Static res:AppResources.Dashboard_TotalExpenses}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding TotalExpensesFormatted}" Style="{StaticResource Text.Metric}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ════════ Recent trips ════════ -->
                    <VerticalStackLayout IsVisible="{Binding HasAnyTrips}" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{x:Static res:AppResources.Section_MyTrips}" Style="{StaticResource Text.H3}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"
                                                   SemanticProperties.Description="{x:Static res:AppResources.Common_All}">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToTripListCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="{x:Static res:AppResources.Common_All}" Style="{StaticResource Text.Link}" VerticalOptions="Center" />
                                <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-accent-text}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- at most 5 rows inside the page's ScrollView: a plain stack (a CollectionView in a ScrollView
                             measures and scrolls badly on Android) -->
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RecentTrips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TripSummaryItem">
                                    <Border Style="{StaticResource Card.Compact}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=GoToTripDetailCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0" Style="{StaticResource IconTile}" WidthRequest="56" HeightRequest="56" VerticalOptions="Start">
                                                <Grid>
                                                    <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Briefcase}" />
                                                    <!-- the cover's thumbnail over the icon, as on the trip list -->
                                                    <Image Source="{Binding Trip.CoverThumbFile}" Aspect="AspectFill" IsVisible="{Binding Trip.HasCoverThumb}" />
                                                </Grid>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Text.Title}" VerticalOptions="Center" />
                                                    <Border Grid.Column="1" Style="{StaticResource Tag}"
                                                            BackgroundColor="{Binding Status, Converter={StaticResource TripTagColorConverter}}">
                                                        <Label Text="{Binding Tag}" Style="{StaticResource Tag.Text}"
                                                               TextColor="{Binding Status, Converter={StaticResource TripTagColorConverter}, ConverterParameter=Foreground}" />
                                                    </Border>
                                                </Grid>
                                                <Label Text="{Binding Place}" Style="{StaticResource Text.Body2}" LineBreakMode="TailTruncation" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Grid.Column="0" Text="{Binding Dates}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Budget}" Style="{StaticResource Text.Value}" FontSize="14" />
                                                </Grid>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}"
                                                   TextColor="{DynamicResource tp-text-3}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
