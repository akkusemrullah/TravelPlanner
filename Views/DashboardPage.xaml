<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="{DynamicResource tp-bg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- TP-106: Home. A royal-blue hero on top; with a coming trip a white boarding-pass card overlaps its bottom edge,
         without one a page-coloured sheet with rounded corners does. The floating bottom menu sits over the page. -->
    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="0" Padding="0,0,0,104">

                    <!-- ════════ Hero ════════ -->
                    <Grid BackgroundColor="{DynamicResource tp-hero}" IsClippedToBounds="True">
                        <!-- decoration: two rings top right, a dashed flight path -->
                        <Ellipse InputTransparent="True" WidthRequest="230" HeightRequest="230" Stroke="#24FFFFFF" StrokeThickness="1.5"
                                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-70,-90,0" />
                        <Ellipse InputTransparent="True" WidthRequest="140" HeightRequest="140" Stroke="#24FFFFFF" StrokeThickness="1.5"
                                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-25,-45,0" />
                        <Line InputTransparent="True" X1="0" Y1="330" X2="460" Y2="110" Stroke="#1FFFFFFF" StrokeThickness="1.5" StrokeDashArray="4,4" />

                        <VerticalStackLayout Padding="20,16,20,0" Spacing="0">
                            <!-- Brand · sync badge · avatar (opens Profil) -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource White}" Padding="0" VerticalOptions="Center">
                                    <Label Style="{StaticResource Icon}" FontSize="19" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-hero}" />
                                </Border>
                                <Label Grid.Column="1" VerticalOptions="Center" FontSize="19" TextColor="{StaticResource White}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Travel" FontFamily="InterBold" />
                                            <Span Text="Planner" FontFamily="InterMedium" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <!-- TP-78: offline / changes waiting to be sent -->
                                <Border Grid.Column="2" IsVisible="{Binding ShowSyncBadge}" Style="{StaticResource Tag}" BackgroundColor="#26FFFFFF" Padding="8,2"
                                        VerticalOptions="Center" SemanticProperties.Description="{x:Static res:AppResources.Sync_BadgeA11y}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowSyncStatusCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Style="{StaticResource Icon.Xs}" FontSize="13" Text="{StaticResource Ic.Cloud}" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                        <Label Text="{Binding SyncBadgeText}" Style="{StaticResource Tag.Text}" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Grid Grid.Column="3" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"
                                      SemanticProperties.Description="{x:Static res:AppResources.Home_ProfileA11y}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border IsVisible="{Binding HasAvatarText}" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource White}" Padding="0">
                                        <Label Text="{Binding AvatarText}" FontFamily="InterBold" FontSize="16" TextColor="{DynamicResource tp-hero}"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Border IsVisible="{Binding ShowsAvatarIcon}" StrokeThickness="1" Stroke="#4DFFFFFF"
                                            StrokeShape="RoundRectangle 20" BackgroundColor="#1FFFFFFF" Padding="0">
                                        <Label Style="{StaticResource Icon}" FontSize="19" Text="{StaticResource Ic.UserPlain}" TextColor="{StaticResource White}" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- "Merhaba Yusuf," over the countdown -->
                            <Label IsVisible="{Binding HasFeaturedTrip}" Text="{Binding GreetingText}" FontFamily="InterMedium" FontSize="16"
                                   TextColor="{DynamicResource tp-hero-muted}" Margin="0,28,0,0" />
                            <!-- "Roma'ya 12 gün kaldı" / "Bir sonraki durağın neresi?" -->
                            <Label FontFamily="InterBold" FontSize="30" CharacterSpacing="-0.6" LineHeight="1.1" TextColor="{StaticResource White}"
                                   Margin="0,6,0,0" SemanticProperties.HeadingLevel="Level1">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ShowsCitySearch}" Value="True">
                                        <Setter Property="Margin" Value="0,32,0,0" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding HeroBefore}" />
                                        <Span Text="{Binding HeroHighlight}" TextColor="{DynamicResource tp-hero-accent}" />
                                        <Span Text="{Binding HeroAfter}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- No coming trip: where to? The city goes to the new trip form. -->
                            <VerticalStackLayout IsVisible="{Binding ShowsCitySearch}" Spacing="0">
                                <Label Text="{x:Static res:AppResources.Home_EmptyBody}" FontSize="15" LineHeight="1.2" TextColor="{DynamicResource tp-hero-muted}" Margin="0,12,0,0" />
                                <Border BackgroundColor="{DynamicResource tp-surface}" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="58"
                                        Padding="16,0,8,0" Margin="0,24,0,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Style="{StaticResource Icon}" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-nav-active}" />
                                        <Entry Grid.Column="1" Text="{Binding CityQuery}" Placeholder="{x:Static res:AppResources.Home_CityPlaceholder}"
                                               PlaceholderColor="{DynamicResource tp-text-3}" TextColor="{DynamicResource tp-text}" FontSize="15"
                                               BackgroundColor="Transparent" VerticalOptions="Center" ReturnType="Go" MaxLength="100"
                                               ReturnCommand="{Binding SearchCityCommand}" />
                                        <Border Grid.Column="2" WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{DynamicResource tp-primary}" Padding="0" VerticalOptions="Center"
                                                SemanticProperties.Description="{x:Static res:AppResources.Home_SearchA11y}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SearchCityCommand}" />
                                            </Border.GestureRecognizers>
                                            <Label Style="{StaticResource Icon}" FontSize="20" Text="{StaticResource Ic.ArrowRight}" TextColor="{DynamicResource tp-on-primary}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- TP-48: join with an invite code (on Home with trips it moves to the bottom) -->
                            <HorizontalStackLayout IsVisible="{Binding HasNoTrips}" Spacing="8" Margin="0,20,0,0" Padding="0,4">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding JoinTripCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Ticket}" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                <Label VerticalOptions="Center" FontSize="14" TextColor="{StaticResource White}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static res:AppResources.Home_InviteQuestion}" FontFamily="InterSemiBold" />
                                            <Span Text="  " />
                                            <Span Text="{x:Static res:AppResources.Join_Short}" FontFamily="InterBold" TextDecorations="Underline" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </HorizontalStackLayout>

                            <!-- room the card (coming trip) or the rounded sheet overlaps -->
                            <BoxView IsVisible="{Binding HasFeaturedTrip}" HeightRequest="118" Color="Transparent" />
                            <BoxView IsVisible="{Binding ShowsCitySearch}" HeightRequest="60" Color="Transparent" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- ════════ Coming trip: the boarding-pass card over the hero's edge ════════ -->
                    <Border IsVisible="{Binding HasFeaturedTrip}" Margin="16,-96,16,0" Padding="0" BackgroundColor="{DynamicResource tp-surface}"
                            Stroke="{DynamicResource tp-border}" StrokeThickness="1" StrokeShape="RoundRectangle 22">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.08" Radius="18" Offset="0,6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFeaturedDetailsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,22,Auto">
                            <VerticalStackLayout Grid.Row="0" Padding="18,16,18,10" Spacing="16">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource tp-accent-soft}" Padding="10,5,12,5">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Style="{StaticResource Icon.Xs}" Text="{StaticResource Ic.Plane}" TextColor="{DynamicResource tp-nav-active}" VerticalOptions="Center" />
                                            <Label Text="{Binding FeaturedTicket.StatusText}" FontFamily="InterSemiBold" FontSize="12.5" TextColor="{DynamicResource tp-nav-active}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding FeaturedTicket.Caption}" FontSize="13" TextColor="{DynamicResource tp-text-3}" HorizontalTextAlignment="End"
                                           VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                                </Grid>

                                <!-- Departure · city on the route line · return -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{helpers:Upper Ticket_Departure}" FontFamily="InterSemiBold" FontSize="10.5" CharacterSpacing="1" TextColor="{DynamicResource tp-text-3}" />
                                        <Label Text="{Binding FeaturedTicket.StartDay}" FontFamily="InterBold" FontSize="28" TextColor="{DynamicResource tp-text}" />
                                        <Label Text="{Binding FeaturedTicket.StartShort}" FontSize="12.5" TextColor="{DynamicResource tp-text-2}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding FeaturedTicket.City}" FontFamily="InterBold" FontSize="19" TextColor="{DynamicResource tp-nav-active}"
                                               HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                                        <AbsoluteLayout HeightRequest="24">
                                            <Grid AbsoluteLayout.LayoutBounds="0,0.5,1,2" AbsoluteLayout.LayoutFlags="XProportional,YProportional,WidthProportional"
                                                  IsClippedToBounds="True">
                                                <Line X1="0" Y1="1" X2="3000" Y2="1" Stroke="{DynamicResource tp-border-strong}" StrokeThickness="1.5" StrokeDashArray="3,3" />
                                            </Grid>
                                            <BoxView AbsoluteLayout.LayoutBounds="0,0.5,8,8" AbsoluteLayout.LayoutFlags="PositionProportional"
                                                     Color="{DynamicResource tp-nav-active}" CornerRadius="4" />
                                            <Border AbsoluteLayout.LayoutBounds="1,0.5,9,9" AbsoluteLayout.LayoutFlags="PositionProportional"
                                                    Stroke="{DynamicResource tp-nav-active}" StrokeThickness="1.5" StrokeShape="RoundRectangle 4.5"
                                                    BackgroundColor="{DynamicResource tp-surface}" Padding="0" />
                                            <Label AbsoluteLayout.LayoutBounds="{Binding FeaturedTicket.PlaneBounds}" AbsoluteLayout.LayoutFlags="PositionProportional"
                                                   Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Plane}" Rotation="45"
                                                   TextColor="{DynamicResource tp-accent}" BackgroundColor="{DynamicResource tp-surface}" />
                                        </AbsoluteLayout>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="0">
                                        <Label Text="{helpers:Upper Ticket_Return}" FontFamily="InterSemiBold" FontSize="10.5" CharacterSpacing="1" TextColor="{DynamicResource tp-text-3}"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding FeaturedTicket.EndDay}" FontFamily="InterBold" FontSize="28" TextColor="{DynamicResource tp-text}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding FeaturedTicket.EndShort}" FontSize="12.5" TextColor="{DynamicResource tp-text-2}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Tear line between two page-coloured notches -->
                            <Grid Grid.Row="1">
                                <Grid IsClippedToBounds="True" Margin="18,0" HeightRequest="2" VerticalOptions="Center">
                                    <Line X1="0" Y1="1" X2="3000" Y2="1" Stroke="{DynamicResource tp-border}" StrokeThickness="1.5" StrokeDashArray="3,3" />
                                </Grid>
                                <BoxView Style="{StaticResource Ticket.Notch}" HorizontalOptions="Start" Margin="-12,0,0,0" />
                                <BoxView Style="{StaticResource Ticket.Notch}" HorizontalOptions="End" Margin="0,0,-12,0" />
                            </Grid>

                            <!-- Duration · budget · open -->
                            <Grid Grid.Row="2" Padding="18,4,18,16" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="28">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{helpers:Upper Ticket_Duration}" FontFamily="InterSemiBold" FontSize="10.5" CharacterSpacing="1" TextColor="{DynamicResource tp-text-3}" />
                                    <Label Text="{Binding FeaturedTicket.DurationText}" FontFamily="InterBold" FontSize="16" TextColor="{DynamicResource tp-text}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{helpers:Upper Budget_Title}" FontFamily="InterSemiBold" FontSize="10.5" CharacterSpacing="1" TextColor="{DynamicResource tp-text-3}" />
                                    <Label Text="{Binding FeaturedTicket.BudgetText}" FontFamily="InterBold" FontSize="16" TextColor="{DynamicResource tp-text}" MaxLines="1" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Border Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-primary}"
                                        HeightRequest="42" Padding="16,0,12,0" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenFeaturedDetailsCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{x:Static res:AppResources.Home_Open}" FontFamily="InterBold" FontSize="14" TextColor="{DynamicResource tp-on-primary}" VerticalOptions="Center" />
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-on-primary}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Quick links of the coming trip -->
                    <ScrollView IsVisible="{Binding HasFeaturedTrip}" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,14,0,0">
                        <HorizontalStackLayout Spacing="8" Padding="16,0" BindableLayout.ItemsSource="{Binding Chips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeChip">
                                    <Border Style="{StaticResource Chip}" HeightRequest="40" StrokeShape="RoundRectangle 20" SemanticProperties.Description="{Binding Title}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenChipCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                            <Label Style="{StaticResource Icon.Sm}" Text="{Binding Glyph}" TextColor="{DynamicResource tp-nav-active}" VerticalOptions="Center" />
                                            <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="13.5" TextColor="{DynamicResource tp-text}" VerticalOptions="Center" />
                                            <Label Text="{Binding Count}" IsVisible="{Binding HasCount}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- ════════ Below the hero: a rounded sheet without a coming trip, the plain page with one ════════ -->
                    <Border BackgroundColor="{DynamicResource tp-bg}" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0"
                            Margin="0,-28,0,0" Padding="16,20,16,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasFeaturedTrip}" Value="True">
                                <Setter Property="StrokeShape" Value="Rectangle" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="16,8,16,0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="0">

                            <!-- Notice from the admin panel, or "a new version is out" (tap opens the store) -->
                            <Border IsVisible="{Binding HasNotice}" Style="{StaticResource Banner.Accent}" Padding="14" Margin="0,8,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenNoticeCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Style="{StaticResource Icon}" Text="{StaticResource Ic.Megaphone}" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Start" />
                                    <Label Grid.Column="1" Text="{Binding NoticeText}" FontSize="13.5" TextColor="{DynamicResource tp-accent-text}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                    <Label Grid.Column="2" IsVisible="{Binding CanCloseNotice}" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Close}"
                                           TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Start" Padding="8,0,0,8"
                                           SemanticProperties.Description="{x:Static res:AppResources.A11y_CloseNotice}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CloseNoticeCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>

                            <!-- TP-91: a guest can sign in to back up their trips (Profil has it too) -->
                            <Border IsVisible="{Binding ShowSignInHint}" Style="{StaticResource Banner.Accent}" Padding="14" Margin="0,8,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                    <Label Grid.Column="0" Style="{StaticResource Icon}" Text="{StaticResource Ic.Cloud}" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Start" />
                                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Dashboard_SignInHint}" FontSize="13.5" TextColor="{DynamicResource tp-accent-text}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Close}"
                                           TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Start" Padding="8,0,0,8"
                                           SemanticProperties.Description="{x:Static res:AppResources.A11y_CloseNotice}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CloseSignInHintCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Button Grid.Row="1" Grid.Column="1" Text="{x:Static res:AppResources.Account_SignInOrCreate}" Style="{StaticResource Btn.Primary.Sm}"
                                            HorizontalOptions="Start" Command="{Binding OpenSignInCommand}" />
                                </Grid>
                            </Border>

                            <!-- ════════ With trips: calendar, travel record, invite link ════════ -->
                            <VerticalStackLayout IsVisible="{Binding HasAnyTrips}" Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,24,0,12">
                                    <Label Grid.Column="0" Text="{x:Static res:AppResources.Home_CalendarTitle}" FontFamily="InterBold" FontSize="19"
                                           TextColor="{DynamicResource tp-text}" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="8,6,0,6"
                                                           SemanticProperties.Description="{x:Static res:AppResources.Common_All}">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding GoToTripListCommand}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label Text="{x:Static res:AppResources.Common_All}" FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource tp-nav-active}" VerticalOptions="Center" />
                                        <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-nav-active}" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding CalendarTrips}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HomeTripRow">
                                            <Grid ColumnDefinitions="52,*" ColumnSpacing="14" SemanticProperties.Description="{Binding Title}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=GoToTripDetailCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <!-- date tile: next trip filled, later ones tinted, past ones plain -->
                                                <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 14" Padding="0" VerticalOptions="Center"
                                                        StrokeThickness="0" BackgroundColor="{DynamicResource tp-accent-soft}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{DynamicResource tp-primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsPast}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{DynamicResource tp-surface}" />
                                                            <Setter Property="StrokeThickness" Value="1" />
                                                            <Setter Property="Stroke" Value="{DynamicResource tp-border}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                        <Label Text="{Binding Day}" FontFamily="InterBold" FontSize="18" HorizontalTextAlignment="Center" TextColor="{DynamicResource tp-nav-active}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsPast}" Value="True">
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-text-3}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label Text="{Binding Month}" FontFamily="InterSemiBold" FontSize="10" CharacterSpacing="0.8" HorizontalTextAlignment="Center"
                                                               TextColor="{DynamicResource tp-nav-active}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-on-primary}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsPast}" Value="True">
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-text-3}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                            <Label Text="{Binding Title}" Style="{StaticResource Text.Title}" MaxLines="1" />
                                                            <Label Text="{Binding Sub}" Style="{StaticResource Text.Caption}" FontSize="13" MaxLines="1" LineBreakMode="TailTruncation" />
                                                        </VerticalStackLayout>
                                                        <controls:Badge Grid.Column="1" Text="{Binding BadgeText}" Tone="{Binding BadgeTone}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Seyahat karnen: trips / countries / cities (countries and cities of started trips) -->
                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,28,0,0" StrokeShape="RoundRectangle 18">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToTripListCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="18">
                                        <HorizontalStackLayout Spacing="12">
                                            <Border Style="{StaticResource IconTile.Tint}">
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Globe}" TextColor="{DynamicResource tp-nav-active}" />
                                            </Border>
                                            <Label Text="{x:Static res:AppResources.Home_StatsTitle}" FontFamily="InterBold" FontSize="17" TextColor="{DynamicResource tp-text}"
                                                   VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                                        </HorizontalStackLayout>
                                        <Grid ColumnDefinitions="*,1,*,1,*" ColumnSpacing="16">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding TotalTripsCount}" FontFamily="InterBold" FontSize="26" TextColor="{DynamicResource tp-nav-active}" />
                                                <Label Text="{x:Static res:AppResources.Home_StatTrips}" FontSize="13.5" TextColor="{DynamicResource tp-text-2}" />
                                            </VerticalStackLayout>
                                            <BoxView Grid.Column="1" Color="{DynamicResource tp-divider}" WidthRequest="1" />
                                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                <Label Text="{Binding VisitedCountriesCount}" FontFamily="InterBold" FontSize="26" TextColor="{DynamicResource tp-nav-active}" />
                                                <Label Text="{x:Static res:AppResources.Home_StatCountries}" FontSize="13.5" TextColor="{DynamicResource tp-text-2}" />
                                            </VerticalStackLayout>
                                            <BoxView Grid.Column="3" Color="{DynamicResource tp-divider}" WidthRequest="1" />
                                            <VerticalStackLayout Grid.Column="4" Spacing="2">
                                                <Label Text="{Binding VisitedCitiesCount}" FontFamily="InterBold" FontSize="26" TextColor="{DynamicResource tp-nav-active}" />
                                                <Label Text="{x:Static res:AppResources.Home_StatCities}" FontSize="13.5" TextColor="{DynamicResource tp-text-2}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- TP-48: join with an invite code -->
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,24,0,8" Padding="8,8">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding JoinTripCommand}" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Ticket}" TextColor="{DynamicResource tp-text-2}" VerticalOptions="Center" />
                                    <Label VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource tp-text-2}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static res:AppResources.Home_InviteQuestion}" />
                                                <Span Text=" " />
                                                <Span Text="{x:Static res:AppResources.Join_Short}" FontFamily="InterBold" TextColor="{DynamicResource tp-nav-active}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- ════════ No trips: three steps, ready plans, what the app can do ════════ -->
                            <VerticalStackLayout IsVisible="{Binding HasNoTrips}" Spacing="0">
                                <Border Style="{StaticResource Card}" Padding="18" StrokeShape="RoundRectangle 18" Margin="0,4,0,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToAddTripCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="18">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{x:Static res:AppResources.Home_StepsTitle}" FontFamily="InterBold" FontSize="17" TextColor="{DynamicResource tp-text}"
                                                   VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                                            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-accent-soft}" Padding="10,4">
                                                <Label Text="0/3" FontFamily="InterBold" FontSize="12.5" TextColor="{DynamicResource tp-nav-active}" />
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">
                                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                                <Grid HeightRequest="30">
                                                    <BoxView HeightRequest="2" Color="{DynamicResource tp-border}" VerticalOptions="Center" Margin="38,0,8,0" />
                                                    <Border WidthRequest="30" HeightRequest="30" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                                                            BackgroundColor="{DynamicResource tp-primary}" Padding="0">
                                                        <Label Text="1" FontFamily="InterBold" FontSize="13.5" TextColor="{DynamicResource tp-on-primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <Label Text="{x:Static res:AppResources.Home_Step1}" FontFamily="InterBold" FontSize="14" TextColor="{DynamicResource tp-text}" Margin="0,10,0,0" />
                                                <Label Text="{x:Static res:AppResources.Home_Step1Body}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                                <Grid HeightRequest="30">
                                                    <BoxView HeightRequest="2" Color="{DynamicResource tp-border}" VerticalOptions="Center" Margin="38,0,8,0" />
                                                    <Border WidthRequest="30" HeightRequest="30" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                                                            BackgroundColor="{DynamicResource tp-accent-soft}" Padding="0">
                                                        <Label Text="2" FontFamily="InterBold" FontSize="13.5" TextColor="{DynamicResource tp-nav-active}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <Label Text="{x:Static res:AppResources.Home_Step2}" FontFamily="InterBold" FontSize="14" TextColor="{DynamicResource tp-text}" Margin="0,10,0,0" />
                                                <Label Text="{x:Static res:AppResources.Home_Step2Body}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="0">
                                                <Border WidthRequest="30" HeightRequest="30" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                                                        BackgroundColor="{DynamicResource tp-accent-soft}" Padding="0">
                                                    <Label Text="3" FontFamily="InterBold" FontSize="13.5" TextColor="{DynamicResource tp-nav-active}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                                <Label Text="{x:Static res:AppResources.Home_Step3}" FontFamily="InterBold" FontSize="14" TextColor="{DynamicResource tp-text}" Margin="0,10,0,0" />
                                                <Label Text="{x:Static res:AppResources.Home_Step3Body}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Ready plans from Keşfet (no budget, as in Keşfet) -->
                                <VerticalStackLayout IsVisible="{Binding HasPlans}" Spacing="12" Margin="0,28,0,0">
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,0">
                                        <Label Text="{x:Static res:AppResources.Home_ReadyPlans}" FontFamily="InterBold" FontSize="19" TextColor="{DynamicResource tp-text}"
                                               VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="8,6,0,6">
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenExploreCommand}" />
                                            </HorizontalStackLayout.GestureRecognizers>
                                            <Label Text="{x:Static res:AppResources.Nav_Explore}" FontFamily="InterSemiBold" FontSize="14" TextColor="{DynamicResource tp-nav-active}" VerticalOptions="Center" />
                                            <Label Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.ChevronRight}" TextColor="{DynamicResource tp-nav-active}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Border Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 18" SemanticProperties.Description="{Binding FirstPlan.Title}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenPlanCommand}" CommandParameter="{Binding FirstPlan}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="160,Auto">
                                            <Grid Grid.Row="0" BackgroundColor="{DynamicResource tp-accent-soft}">
                                                <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Compass}" TextColor="{DynamicResource tp-accent-text}" />
                                                <Image helpers:RemoteImage.Url="{Binding FirstPlan.ThumbUrl}" Aspect="AspectFill" />
                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 13" BackgroundColor="{DynamicResource tp-surface}" Padding="10,4"
                                                        HorizontalOptions="Start" VerticalOptions="Start" Margin="12">
                                                    <Label Text="{Binding FirstPlan.Duration}" FontFamily="InterBold" FontSize="12.5" TextColor="{DynamicResource tp-nav-active}" />
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,14">
                                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                                    <Label Text="{Binding FirstPlan.Title}" FontFamily="InterBold" FontSize="16.5" TextColor="{DynamicResource tp-text}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding FirstPlan.Sub}" FontSize="13" TextColor="{DynamicResource tp-text-3}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                                        BackgroundColor="{DynamicResource tp-accent-soft}" Padding="0" VerticalOptions="Center">
                                                    <Label Style="{StaticResource Icon.Sm}" FontSize="18" Text="{StaticResource Ic.ArrowRight}" TextColor="{DynamicResource tp-nav-active}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid IsVisible="{Binding HasMorePlans}" ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 16" SemanticProperties.Description="{Binding SecondPlan.Title}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenPlanCommand}" CommandParameter="{Binding SecondPlan}" />
                                            </Border.GestureRecognizers>
                                            <Grid RowDefinitions="86,Auto">
                                                <Grid Grid.Row="0" BackgroundColor="{DynamicResource tp-accent-soft}">
                                                    <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Compass}" TextColor="{DynamicResource tp-accent-text}" />
                                                    <Image helpers:RemoteImage.Url="{Binding SecondPlan.ThumbUrl}" Aspect="AspectFill" />
                                                </Grid>
                                                <VerticalStackLayout Grid.Row="1" Spacing="2" Padding="12,10,12,12">
                                                    <Label Text="{Binding SecondPlan.Title}" FontFamily="InterBold" FontSize="14" TextColor="{DynamicResource tp-text}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding SecondPlan.ShortSub}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" IsVisible="{Binding ThirdPlan, Converter={StaticResource ObjectNotNullConverter}}" Style="{StaticResource Card}" Padding="0"
                                                StrokeShape="RoundRectangle 16" SemanticProperties.Description="{Binding ThirdPlan.Title}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenPlanCommand}" CommandParameter="{Binding ThirdPlan}" />
                                            </Border.GestureRecognizers>
                                            <Grid RowDefinitions="86,Auto">
                                                <Grid Grid.Row="0" BackgroundColor="{DynamicResource tp-accent-soft}">
                                                    <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Compass}" TextColor="{DynamicResource tp-accent-text}" />
                                                    <Image helpers:RemoteImage.Url="{Binding ThirdPlan.ThumbUrl}" Aspect="AspectFill" />
                                                </Grid>
                                                <VerticalStackLayout Grid.Row="1" Spacing="2" Padding="12,10,12,12">
                                                    <Label Text="{Binding ThirdPlan.Title}" FontFamily="InterBold" FontSize="14" TextColor="{DynamicResource tp-text}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding ThirdPlan.ShortSub}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- What the app can do -->
                                <Label Text="{x:Static res:AppResources.Dashboard_FeaturesTitle}" FontFamily="InterBold" FontSize="19" TextColor="{DynamicResource tp-text}"
                                       Margin="4,28,0,12" SemanticProperties.HeadingLevel="Level2" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12" Margin="0,0,0,12">
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{DynamicResource tp-primary}" Padding="18">
                                        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="0">
                                            <Border Grid.Row="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="#29FFFFFF" Padding="0" HorizontalOptions="Start">
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Sparkles}" TextColor="{StaticResource White}" />
                                            </Border>
                                            <Label Grid.Row="2" Text="{x:Static res:AppResources.Dashboard_FeatureAi}" FontFamily="InterBold" FontSize="18" TextColor="{StaticResource White}"
                                                   Margin="0,24,0,0" />
                                            <Label Grid.Row="3" Text="{x:Static res:AppResources.Dashboard_FeatureAiBody}" FontSize="13" LineHeight="1.15"
                                                   TextColor="{DynamicResource tp-hero-muted}" Margin="0,6,0,0" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="16" StrokeShape="RoundRectangle 18">
                                        <VerticalStackLayout Spacing="12">
                                            <Border Style="{StaticResource IconTile.Tint}">
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.CalendarDays}" TextColor="{DynamicResource tp-nav-active}" />
                                            </Border>
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeaturePlan}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="16" StrokeShape="RoundRectangle 18">
                                        <VerticalStackLayout Spacing="12">
                                            <Border Style="{StaticResource IconTile.Tint}">
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Wallet}" TextColor="{DynamicResource tp-nav-active}" />
                                            </Border>
                                            <Label Text="{x:Static res:AppResources.Dashboard_FeatureBudget}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16" StrokeShape="RoundRectangle 18">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                            <Border Style="{StaticResource IconTile.Tint}">
                                                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Users}" TextColor="{DynamicResource tp-nav-active}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{x:Static res:AppResources.Dashboard_FeatureShare}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" />
                                                <Label Text="{x:Static res:AppResources.Dashboard_FeatureShareBody}" FontSize="13" TextColor="{DynamicResource tp-text-3}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ════════ TP-106: floating bottom menu ════════ -->
        <controls:FloatingTabBar Current="DashboardPage" />
    </Grid>

</ContentPage>
