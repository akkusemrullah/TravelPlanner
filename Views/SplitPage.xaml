<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             x:Class="TravelPlanner.Views.SplitPage"
             x:DataType="vm:SplitViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" Margin="0,0,44,0">
                <Label Text="{x:Static res:AppResources.Split_Title}" Style="{StaticResource Text.AppBarTitle}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding TripName}" Style="{StaticResource Text.Caption}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"
                       IsVisible="{Binding TripName, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <!-- TP-104: the prototype's split screen - who pays whom with avatars, the warning, participants with badges -->
                <VerticalStackLayout Padding="16,16,16,32" Spacing="16">
                    <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" Margin="0,40" />

                    <VerticalStackLayout IsVisible="{Binding HasNoParticipants}" Spacing="12" Padding="16,8">
                        <Border Style="{StaticResource EmptyIcon}">
                            <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.Users}" TextColor="{DynamicResource tp-accent-text}" />
                        </Border>
                        <Label Text="{x:Static res:AppResources.Split_NoParticipants}" Style="{StaticResource Text.EmptyText}" />
                    </VerticalStackLayout>

                    <!-- ════════ Who owes whom ════════ -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasParticipants}">
                        <Label Text="{helpers:Upper Split_WhoOwesWhom}" Style="{StaticResource Text.Overline}" Margin="4,0" SemanticProperties.HeadingLevel="Level2" />
                        <Border Style="{StaticResource Card.List}">
                            <VerticalStackLayout Spacing="0">
                                <Grid IsVisible="{Binding HasSettlements, Converter={StaticResource InvertBoolConverter}}" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="16">
                                    <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Check}" TextColor="{DynamicResource tp-success}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Split_AllSettled}" FontSize="14" TextColor="{DynamicResource tp-success}" VerticalOptions="Center" />
                                </Grid>
                                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding SettlementRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettlementItem">
                                            <VerticalStackLayout Spacing="0">
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8" Padding="16,12" SemanticProperties.Description="{Binding Text}">
                                                    <controls:Avatar Grid.Column="0" Name="{Binding FromName}" Size="34" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Style="{StaticResource Icon}" FontSize="16" Text="{StaticResource Ic.ArrowRight}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                                                    <controls:Avatar Grid.Column="2" Name="{Binding ToName}" Size="34" VerticalOptions="Center" />
                                                    <Label Grid.Column="3" Text="{Binding Text}" FontSize="14" FontFamily="InterMedium" TextColor="{DynamicResource tp-text}" VerticalOptions="Center" Margin="4,0,0,0" />
                                                </Grid>
                                                <BoxView Style="{StaticResource Divider}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" Padding="16,12" BackgroundColor="{DynamicResource tp-surface-alt}">
                                    <Label Grid.Column="0" Text="{x:Static res:AppResources.Split_TotalLabel}" FontSize="13" TextColor="{DynamicResource tp-text-3}" />
                                    <Label Grid.Column="1" Text="{Binding SplitTotalAmount}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding HasUnsplit}" Style="{StaticResource Banner.Warning}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Warning}" TextColor="{DynamicResource tp-warning}" VerticalOptions="Start" />
                                <Label Grid.Column="1" Text="{Binding UnsplitText}" FontSize="13" TextColor="{DynamicResource tp-warning}" VerticalOptions="Center" />
                            </Grid>
                            <Button Text="{x:Static res:AppResources.Split_GoToExpenses}" Command="{Binding GoToExpensesCommand}" Style="{StaticResource Btn.Secondary.Sm}"
                                    HorizontalOptions="Start" Margin="28,0,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ════════ Participants ════════ -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{helpers:Upper Split_ParticipantsTitle}" Style="{StaticResource Text.Overline}" Margin="4,0" SemanticProperties.HeadingLevel="Level2" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                            <Border Grid.Column="0" Style="{StaticResource Input}">
                                <Entry Keyboard="{x:Static helpers:AppKeyboards.Words}" Text="{Binding NewParticipantName}" Placeholder="{x:Static res:AppResources.Split_AddPlaceholder}" MaxLength="60"
                                       ReturnCommand="{Binding AddParticipantCommand}" />
                            </Border>
                            <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource tp-accent}"
                                    SemanticProperties.Description="{x:Static res:AppResources.A11y_Add}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding NewParticipantName.Length, FallbackValue=0, TargetNullValue=0}" Value="0">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddParticipantCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource Icon}" FontSize="22" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-accent}" />
                            </Border>
                        </Grid>
                        <!-- G6: shared trip - add its members (linked to their accounts) -->
                        <Button Text="{x:Static res:AppResources.Split_AddMembers}" Command="{Binding AddMembersCommand}" IsVisible="{Binding CanAddMembers}"
                                Style="{StaticResource Btn.Soft.Sm}" HorizontalOptions="Start" ContentLayout="Left,6">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.UserPlus}" Size="16" Color="{DynamicResource tp-accent-text}" />
                            </Button.ImageSource>
                        </Button>

                        <Border Style="{StaticResource Card.List}" IsVisible="{Binding HasParticipants}" Margin="0,4,0,0">
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Balances}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BalanceItem">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="16,12,6,12">
                                                <controls:Avatar Grid.Column="0" Name="{Binding Name}" Size="40" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding Name}" FontSize="15" FontFamily="InterMedium" TextColor="{DynamicResource tp-text}" LineBreakMode="TailTruncation" />
                                                        <Label Text="{x:Static res:AppResources.Split_Linked}" FontSize="11" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center"
                                                               IsVisible="{Binding IsLinked}" />
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding PaidShareText}" FontSize="12" TextColor="{DynamicResource tp-text-3}" LineBreakMode="TailTruncation" />
                                                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                                        <Border Style="{StaticResource Tag}" HeightRequest="22" BackgroundColor="{DynamicResource tp-surface-alt}">
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsCreditor}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{DynamicResource tp-success-soft}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsDebtor}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{DynamicResource tp-danger-soft}" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Label Text="{Binding StatusText}" Style="{StaticResource Tag.Text}" FontSize="11">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCreditor}" Value="True">
                                                                        <Setter Property="TextColor" Value="{DynamicResource tp-success}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding IsDebtor}" Value="True">
                                                                        <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                        </Border>
                                                        <Label Text="{Binding SignedNetText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsCreditor}" Value="True">
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-success}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsDebtor}" Value="True">
                                                                    <Setter Property="TextColor" Value="{DynamicResource tp-danger}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                                <Border Grid.Column="2" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Edit}"
                                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:SplitViewModel}}, Path=CanEdit}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SplitViewModel}}, Path=RenameParticipantCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Style="{StaticResource Icon}" FontSize="17" Text="{StaticResource Ic.Edit}" TextColor="{DynamicResource tp-text-3}" />
                                                </Border>
                                                <Border Grid.Column="3" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.Common_Delete}"
                                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:SplitViewModel}}, Path=CanEdit}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SplitViewModel}}, Path=DeleteParticipantCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Style="{StaticResource Icon}" FontSize="17" Text="{StaticResource Ic.Delete}" TextColor="{DynamicResource tp-danger}" />
                                                </Border>
                                            </Grid>
                                            <BoxView Style="{StaticResource Divider.Inset}" Margin="68,0,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="{x:Static res:AppResources.Split_RoundingNote}" FontSize="12" TextColor="{DynamicResource tp-text-3}" Margin="4,4,4,0" IsVisible="{Binding HasParticipants}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
