<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.ExploreDetailPage"
             x:DataType="vm:ExploreDetailViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- TP-33: one Keşfet sample trip. "Ekle" copies all of it; "Düzenle ve ekle" shows check boxes first. -->
    <ContentPage.Resources>
        <DataTemplate x:Key="SectionRow" x:DataType="vm:ExploreSectionRow">
            <Label Text="{Binding Title}" Style="{StaticResource Text.Overline}" Padding="20,22,20,6" />
        </DataTemplate>
        <DataTemplate x:Key="DayRow" x:DataType="vm:ExploreDayRow">
            <Label Text="{Binding Header}" Style="{StaticResource Text.Title}" Padding="20,10,20,2" />
        </DataTemplate>
        <DataTemplate x:Key="ActivityRow" x:DataType="vm:ExploreActivityRow">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Padding="14,0,16,0">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Start"
                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreDetailViewModel}}, Path=IsEditing}" />
                <VerticalStackLayout Grid.Column="1" Spacing="0" WidthRequest="44" VerticalOptions="Start" Margin="6,11,0,0">
                    <Label Text="{Binding TimeText}" FontFamily="InterSemiBold" FontSize="13" TextColor="{DynamicResource tp-text}" />
                    <Label Text="{Binding EndText}" IsVisible="{Binding HasEnd}" Style="{StaticResource Text.Caption}" FontSize="12" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="1" Padding="0,10,0,8">
                    <Label Text="{Binding Title}" Style="{StaticResource Text.Body}" FontSize="14" LineBreakMode="WordWrap" />
                    <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PlaceRow" x:DataType="vm:ExplorePlaceRow">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Padding="14,0,16,0">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Start"
                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreDetailViewModel}}, Path=IsEditing}" />
                <Label Grid.Column="1" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-text-3}"
                       VerticalOptions="Start" Margin="6,11,0,0" />
                <VerticalStackLayout Grid.Column="2" Spacing="1" Padding="0,10,0,8">
                    <Label Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="14" />
                    <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TodoRow" x:DataType="vm:ExploreTodoRow">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Padding="14,0,16,0" MinimumHeightRequest="40">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center"
                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreDetailViewModel}}, Path=IsEditing}" />
                <Label Grid.Column="1" Style="{StaticResource Icon.Sm}" Text="{StaticResource Ic.Check}" TextColor="{DynamicResource tp-text-3}"
                       VerticalOptions="Center" Margin="6,0,0,0" />
                <Label Grid.Column="2" Text="{Binding Title}" Style="{StaticResource Text.Body}" FontSize="14" VerticalOptions="Center" LineBreakMode="WordWrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TipRow" x:DataType="vm:ExploreTipRow">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="22,4,20,4">
                <Label Grid.Column="0" Text="•" Style="{StaticResource Text.Body}" />
                <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Text.Body2}" LineBreakMode="WordWrap" />
            </Grid>
        </DataTemplate>
        <views:ExploreRowTemplateSelector x:Key="RowTemplate"
                                          Section="{StaticResource SectionRow}" Day="{StaticResource DayRow}"
                                          Activity="{StaticResource ActivityRow}" Place="{StaticResource PlaceRow}"
                                          Todo="{StaticResource TodoRow}" Tip="{StaticResource TipRow}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" MaxLines="1" LineBreakMode="TailTruncation" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- ════════ Content ════════ -->
        <CollectionView Grid.Row="2" IsVisible="{Binding HasTrip}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">
                    <Grid HeightRequest="200" BackgroundColor="{DynamicResource tp-surface-alt}" IsVisible="{Binding HasCover}">
                        <!-- the list's thumbnail is on the phone already: it shows at once, the cover replaces it when it's here -->
                        <Image helpers:RemoteImage.Url="{Binding ThumbUrl}" Aspect="AspectFill" />
                        <Image helpers:RemoteImage.Url="{Binding CoverUrl}" Aspect="AspectFill" />
                    </Grid>
                    <VerticalStackLayout Padding="20,16,20,0" Spacing="8">
                        <Label Text="{Binding Title}" Style="{StaticResource Text.H2}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Location}" Style="{StaticResource Text.Body2}" />
                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource Tag}">
                                <Label Text="{Binding DurationText}" Style="{StaticResource Tag.Text}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding TagText}" IsVisible="{Binding HasTags}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding MonthsText}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" Style="{StaticResource Text.Body}" FontSize="14"
                               LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Button Text="{x:Static res:AppResources.Explore_ShowMap}" IsVisible="{Binding HasPlaces}" Command="{Binding OpenMapCommand}"
                                Style="{StaticResource Btn.Secondary.Sm}" HorizontalOptions="Start" Margin="0,4,0,0" />
                        <Border Style="{StaticResource Banner.Info}" Margin="0,6,0,0">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{x:Static res:AppResources.Explore_Disclaimer}" Style="{StaticResource Text.Caption}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding ImageCreditText}" IsVisible="{Binding HasImageCredit}" Style="{StaticResource Text.Caption}" FontSize="11" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding IsEditing}" Style="{StaticResource Banner.Warning}">
                            <Label Text="{x:Static res:AppResources.Explore_EditHint}" FontSize="13" TextColor="{DynamicResource tp-warning}" LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="20" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ════════ Loading / failed / offline / gone ════════ -->
        <controls:LoadingLogo Grid.Row="2" IsVisible="{Binding IsLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding HasError}" Spacing="16" Padding="32" VerticalOptions="Center">
            <Label Text="{x:Static res:AppResources.Explore_LoadError}" Style="{StaticResource Text.H3}" HorizontalTextAlignment="Center" />
            <Button Text="{x:Static res:AppResources.Explore_Retry}" Command="{Binding RetryCommand}" Style="{StaticResource Btn.Primary}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsOffline}" Spacing="16" Padding="32" VerticalOptions="Center">
            <Border Style="{StaticResource EmptyIcon}">
                <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.WifiOff}" TextColor="{DynamicResource tp-accent-text}" />
            </Border>
            <Label Text="{x:Static res:AppResources.Explore_OfflineEmpty}" Style="{StaticResource EmptyStateTextLabel}" />
            <Button Text="{x:Static res:AppResources.Explore_Retry}" Command="{Binding RetryCommand}" Style="{StaticResource Btn.Secondary}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsGone}" Spacing="16" Padding="32" VerticalOptions="Center">
            <Label Text="{x:Static res:AppResources.Explore_Gone}" Style="{StaticResource Text.H3}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- ════════ Bottom actions ════════ -->
        <Grid Grid.Row="3" IsVisible="{Binding HasTrip}" Padding="16,10,16,16" BackgroundColor="{DynamicResource tp-surface}">
            <Grid IsVisible="{Binding IsViewing}" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="{x:Static res:AppResources.Explore_EditAndAdd}" Command="{Binding StartEditCommand}" Style="{StaticResource Btn.Secondary}" />
                <Button Grid.Column="1" Text="{x:Static res:AppResources.Explore_Add}" Command="{Binding StartAddCommand}" Style="{StaticResource Btn.Primary}" />
            </Grid>
            <Grid IsVisible="{Binding IsEditing}" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="{x:Static res:AppResources.Common_Cancel}" Command="{Binding CancelEditCommand}" Style="{StaticResource Btn.Secondary}" />
                <Button Grid.Column="1" Text="{x:Static res:AppResources.Explore_Continue}" Command="{Binding ContinueEditCommand}" Style="{StaticResource Btn.Primary}" />
            </Grid>
        </Grid>

        <!-- ════════ "Seyahatlerine ekle" sheet ════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsAddSheetOpen}" RowDefinitions="*,Auto">
            <BoxView Grid.RowSpan="2" Color="{DynamicResource tp-overlay}" Opacity="0.45">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseSheetCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Grid.Row="1" BackgroundColor="{DynamicResource tp-surface}" StrokeThickness="0" StrokeShape="RoundRectangle 20,20,0,0" Padding="20,16,20,16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{x:Static res:AppResources.Explore_SheetTitle}" Style="{StaticResource Text.H3}" />
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{x:Static res:AppResources.Explore_TripName}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding TripName}" MaxLength="100" />
                        </Border>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="{x:Static res:AppResources.Explore_StartDate}" Style="{StaticResource Text.Field}" />
                            <Border Style="{StaticResource Input}">
                                <DatePicker Date="{Binding StartDate}" MinimumDate="{Binding MinimumDate}" MaximumDate="{Binding MaximumDate}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{x:Static res:AppResources.Explore_Currency}" Style="{StaticResource Text.Field}" />
                            <Border Style="{StaticResource Input}">
                                <Picker ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"
                                        Title="{x:Static res:AppResources.Explore_Currency}" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{x:Static res:AppResources.Explore_Budget}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding BudgetText}" Keyboard="Numeric" MaxLength="16" Placeholder="0" />
                        </Border>
                    </VerticalStackLayout>
                    <HorizontalStackLayout IsVisible="{Binding IsAdding}" Spacing="8" HorizontalOptions="Center">
                        <controls:LoadingDots IsVisible="{Binding IsAdding}" DotSize="6" DotColor="{DynamicResource tp-primary}" />
                        <Label Text="{x:Static res:AppResources.Explore_Adding}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="{x:Static res:AppResources.Common_Cancel}" Command="{Binding CloseSheetCommand}" Style="{StaticResource Btn.Secondary}" />
                        <Button Grid.Column="1" Text="{x:Static res:AppResources.Explore_Add}" Command="{Binding ConfirmAddCommand}" Style="{StaticResource Btn.Primary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
