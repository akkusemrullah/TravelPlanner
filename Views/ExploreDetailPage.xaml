<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:helpers="clr-namespace:TravelPlanner.Helpers"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.ExploreDetailPage"
             x:DataType="vm:ExploreDetailViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- TP-33: one Keşfet sample trip. "Ekle" copies all of it; "Düzenle ve ekle" shows check boxes first. -->
    <ContentPage.Resources>
        <!-- TP-105: the prototype's sections - an accent icon + bold title, then one card of rows per day / section -->
        <DataTemplate x:Key="SectionRow" x:DataType="vm:ExploreSectionRow">
            <HorizontalStackLayout Spacing="8" Padding="20,22,20,8">
                <Label Style="{StaticResource Icon}" FontSize="18" Text="{Binding Glyph}" TextColor="{DynamicResource tp-accent}" VerticalOptions="Center" />
                <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="15" TextColor="{DynamicResource tp-text}" VerticalOptions="Center"
                       SemanticProperties.HeadingLevel="Level2" />
            </HorizontalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="DayRow" x:DataType="vm:ExploreDayRow">
            <Grid Padding="0,12,0,0">
                <Border BackgroundColor="{DynamicResource tp-surface-alt}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="16,10" Margin="16,0"
                        StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}">
                    <Label Text="{Binding Header}" FontFamily="InterBold" FontSize="13" TextColor="{DynamicResource tp-text-2}" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ActivityRow" x:DataType="vm:ExploreActivityRow">
            <Border BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0" Margin="16,0"
                    StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding ListPosition}" Value="{x:Static helpers:ListPosition.Middle}">
                        <Setter Property="Margin" Value="16,-1,16,0" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding ListPosition}" Value="{x:Static helpers:ListPosition.Last}">
                        <Setter Property="Margin" Value="16,-1,16,0" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,44,*" ColumnSpacing="12" Padding="16,10" BackgroundColor="Transparent">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRowTapped" />
                    </Grid.GestureRecognizers>
                    <controls:CheckMark Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Start" Margin="0,1,0,0" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreDetailViewModel}}, Path=IsEditing}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Start" Margin="0,1,0,0">
                        <Label Text="{Binding TimeText}" FontFamily="InterBold" FontSize="13" TextColor="{DynamicResource tp-text}" />
                        <Label Text="{Binding EndText}" IsVisible="{Binding HasEnd}" FontSize="12" TextColor="{DynamicResource tp-text-3}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="1">
                        <Label Text="{Binding Title}" FontSize="14.5" TextColor="{DynamicResource tp-text}" LineBreakMode="WordWrap">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PlaceRow" x:DataType="vm:ExplorePlaceRow">
            <Border BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0" Margin="16,0"
                    StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding ListPosition}" Value="{x:Static helpers:ListPosition.Middle}">
                        <Setter Property="Margin" Value="16,-1,16,0" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding ListPosition}" Value="{x:Static helpers:ListPosition.Last}">
                        <Setter Property="Margin" Value="16,-1,16,0" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,10" BackgroundColor="Transparent">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRowTapped" />
                    </Grid.GestureRecognizers>
                    <controls:CheckMark Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Start" Margin="0,1,0,0" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreDetailViewModel}}, Path=IsEditing}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="{Binding Name}" FontSize="14.5" TextColor="{DynamicResource tp-text}" LineBreakMode="WordWrap">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TodoRow" x:DataType="vm:ExploreTodoRow">
            <Border BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0" Margin="16,0"
                    StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding ListPosition}" Value="{x:Static helpers:ListPosition.Middle}">
                        <Setter Property="Margin" Value="16,-1,16,0" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding ListPosition}" Value="{x:Static helpers:ListPosition.Last}">
                        <Setter Property="Margin" Value="16,-1,16,0" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="44" BackgroundColor="Transparent">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRowTapped" />
                    </Grid.GestureRecognizers>
                    <controls:CheckMark Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreDetailViewModel}}, Path=IsEditing}" />
                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="14.5" TextColor="{DynamicResource tp-text}" VerticalOptions="Center" LineBreakMode="WordWrap">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                <Setter Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TipRow" x:DataType="vm:ExploreTipRow">
            <Border BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0" Margin="16,0"
                    StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding ListPosition}" Value="{x:Static helpers:ListPosition.Middle}">
                        <Setter Property="Margin" Value="16,-1,16,0" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding ListPosition}" Value="{x:Static helpers:ListPosition.Last}">
                        <Setter Property="Margin" Value="16,-1,16,0" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="16,10">
                    <Label Grid.Column="0" Text="•" FontSize="13.5" TextColor="{DynamicResource tp-warning}" />
                    <Label Grid.Column="1" Text="{Binding Text}" FontSize="13.5" TextColor="{DynamicResource tp-text-2}" LineBreakMode="WordWrap" />
                </Grid>
            </Border>
        </DataTemplate>
        <views:ExploreRowTemplateSelector x:Key="RowTemplate"
                                          Section="{StaticResource SectionRow}" Day="{StaticResource DayRow}"
                                          Activity="{StaticResource ActivityRow}" Place="{StaticResource PlaceRow}"
                                          Todo="{StaticResource TodoRow}" Tip="{StaticResource TipRow}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.AppBarTitle}" Margin="0,0,44,0" MaxLines="1" LineBreakMode="TailTruncation" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- ════════ Content ════════ -->
        <CollectionView Grid.Row="2" IsVisible="{Binding HasTrip}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">
                    <!-- TP-105: 16:9 cover like the prototype -->
                    <Grid HeightRequest="210" BackgroundColor="{DynamicResource tp-surface-alt}" IsVisible="{Binding HasCover}">
                        <!-- the list's thumbnail is on the phone already: it shows at once, the cover replaces it when it's here -->
                        <Image helpers:RemoteImage.Url="{Binding ThumbUrl}" Aspect="AspectFill" />
                        <Image helpers:RemoteImage.Url="{Binding CoverUrl}" Aspect="AspectFill" />
                    </Grid>
                    <VerticalStackLayout Padding="16,16,16,0" Spacing="0">
                        <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="22" TextColor="{DynamicResource tp-text}" LineBreakMode="WordWrap"
                               SemanticProperties.HeadingLevel="Level1" />
                        <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                            <Label Style="{StaticResource Icon}" FontSize="14" Text="{StaticResource Ic.Pin}" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                            <Label Text="{Binding LocationLine}" FontSize="13.5" TextColor="{DynamicResource tp-text-3}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <FlexLayout BindableLayout.ItemsSource="{Binding TagLabels}" Wrap="Wrap" Margin="0,10,0,0" IsVisible="{Binding HasTags}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <controls:Badge Text="{Binding .}" Margin="0,0,6,6" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <controls:Badge Text="{Binding MonthsText}" Tone="info" Icon="{StaticResource Ic.CalendarDays}" HorizontalOptions="Start" Margin="0,4,0,6" />
                        <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="14" LineHeight="1.35" TextColor="{DynamicResource tp-text-2}"
                               LineBreakMode="WordWrap" Margin="0,6,0,0" />
                        <Button Text="{x:Static res:AppResources.Explore_ShowMap}" IsVisible="{Binding HasPlaces}" Command="{Binding OpenMapCommand}"
                                Style="{StaticResource Btn.Soft.Sm}" HorizontalOptions="Start" Margin="0,12,0,0" ContentLayout="Left,6">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Map}" Size="15" Color="{DynamicResource tp-accent-text}" />
                            </Button.ImageSource>
                        </Button>
                        <Border IsVisible="{Binding IsEditing}" Style="{StaticResource Banner.Accent}" Margin="0,16,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Info}" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Start" />
                                <Label Grid.Column="1" Text="{x:Static res:AppResources.Explore_EditHint}" FontSize="13" TextColor="{DynamicResource tp-accent-text}" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.Footer>
                <VerticalStackLayout Spacing="2" Padding="24,20,24,28">
                    <Label Text="{x:Static res:AppResources.Explore_Disclaimer}" FontSize="12" TextColor="{DynamicResource tp-text-3}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ImageCreditText}" IsVisible="{Binding HasImageCredit}" FontSize="12" TextColor="{DynamicResource tp-text-3}"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <!-- ════════ Loading / failed / offline / gone ════════ -->
        <controls:LoadingLogo Grid.Row="2" IsVisible="{Binding IsLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding HasError}" Spacing="16" Padding="32" VerticalOptions="Center">
            <Label Text="{x:Static res:AppResources.Explore_LoadError}" Style="{StaticResource Text.H3}" HorizontalTextAlignment="Center" />
            <Button Text="{x:Static res:AppResources.Explore_Retry}" Command="{Binding RetryCommand}" Style="{StaticResource Btn.Primary}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsOffline}" Spacing="16" Padding="32" VerticalOptions="Center">
            <Border Style="{StaticResource EmptyIcon}">
                <Label Style="{StaticResource Icon.Lg}" Text="{StaticResource Ic.WifiOff}" TextColor="{DynamicResource tp-accent-text}" />
            </Border>
            <Label Text="{x:Static res:AppResources.Explore_OfflineEmpty}" Style="{StaticResource EmptyStateTextLabel}" />
            <Button Text="{x:Static res:AppResources.Explore_Retry}" Command="{Binding RetryCommand}" Style="{StaticResource Btn.Secondary}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsGone}" Spacing="16" Padding="32" VerticalOptions="Center">
            <Label Text="{x:Static res:AppResources.Explore_Gone}" Style="{StaticResource Text.H3}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- ════════ Bottom actions ════════ -->
        <Grid Grid.Row="3" IsVisible="{Binding HasTrip}" Padding="16,12,16,16" BackgroundColor="{DynamicResource tp-surface}">
            <BoxView Style="{StaticResource Divider}" VerticalOptions="Start" Margin="-16,-12,-16,0" />
            <Grid IsVisible="{Binding IsViewing}" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="{x:Static res:AppResources.Explore_EditAndAdd}" Command="{Binding StartEditCommand}" Style="{StaticResource Btn.Secondary}" ContentLayout="Left,6">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Pencil}" Size="16" Color="{DynamicResource tp-text}" />
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="1" Text="{x:Static res:AppResources.Explore_Add}" Command="{Binding StartAddCommand}" Style="{StaticResource Btn.Primary}" ContentLayout="Left,6">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Lucide" Glyph="{StaticResource Ic.Plus}" Size="16" Color="{DynamicResource tp-on-primary}" />
                    </Button.ImageSource>
                </Button>
            </Grid>
            <Grid IsVisible="{Binding IsEditing}" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="{x:Static res:AppResources.Common_Cancel}" Command="{Binding CancelEditCommand}" Style="{StaticResource Btn.Secondary}" />
                <Button Grid.Column="1" Text="{x:Static res:AppResources.Explore_Continue}" Command="{Binding ContinueEditCommand}" Style="{StaticResource Btn.Primary}" />
            </Grid>
        </Grid>

        <!-- ════════ "Seyahatlerine ekle" sheet ════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsAddSheetOpen}" RowDefinitions="*,Auto">
            <BoxView Grid.RowSpan="2" Color="{DynamicResource tp-overlay}" Opacity="0.45">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseSheetCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Grid.Row="1" BackgroundColor="{DynamicResource tp-surface}" StrokeThickness="0" StrokeShape="RoundRectangle 20,20,0,0" Padding="20,16,20,16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{x:Static res:AppResources.Explore_SheetTitle}" Style="{StaticResource Text.H3}" />
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{x:Static res:AppResources.Explore_TripName}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding TripName}" MaxLength="100" />
                        </Border>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="{x:Static res:AppResources.Explore_StartDate}" Style="{StaticResource Text.Field}" />
                            <Border Style="{StaticResource Input}">
                                <DatePicker Date="{Binding StartDate}" MinimumDate="{Binding MinimumDate}" MaximumDate="{Binding MaximumDate}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{x:Static res:AppResources.Explore_Currency}" Style="{StaticResource Text.Field}" />
                            <Border Style="{StaticResource Input}">
                                <Picker ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"
                                        Title="{x:Static res:AppResources.Explore_Currency}" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{x:Static res:AppResources.Explore_Budget}" Style="{StaticResource Text.Field}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding BudgetText}" Keyboard="Numeric" MaxLength="16" Placeholder="0" />
                        </Border>
                    </VerticalStackLayout>
                    <HorizontalStackLayout IsVisible="{Binding IsAdding}" Spacing="8" HorizontalOptions="Center">
                        <controls:LoadingDots IsVisible="{Binding IsAdding}" DotSize="6" DotColor="{DynamicResource tp-primary}" />
                        <Label Text="{x:Static res:AppResources.Explore_Adding}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="{x:Static res:AppResources.Common_Cancel}" Command="{Binding CloseSheetCommand}" Style="{StaticResource Btn.Secondary}" />
                        <Button Grid.Column="1" Text="{x:Static res:AppResources.Explore_Add}" Command="{Binding ConfirmAddCommand}" Style="{StaticResource Btn.Primary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
