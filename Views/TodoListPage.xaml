<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelPlanner.Controls"
             xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
             xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
             xmlns:models="clr-namespace:TravelPlanner.Models"
             xmlns:views="clr-namespace:TravelPlanner.Views"
             x:Class="TravelPlanner.Views.TodoListPage"
             x:DataType="vm:TodoListViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- ════════ App bar ════════ -->
        <Grid Grid.Row="0" Style="{StaticResource AppBar}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" IsVisible="{Binding Selection.IsInactive}">
            <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.A11y_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Back}" TextColor="{DynamicResource tp-text}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.Section_Tasks}" Style="{StaticResource Text.AppBarTitle}" />
                <Label Text="{Binding TripName}" Style="{StaticResource Text.AppBarSubtitle}" IsVisible="{Binding TripName, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.Packing_Suggest}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowSuggestionsCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Star}" />
            </Border>
            <Border Grid.Column="3" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.Packing_Templates}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ManageTemplatesCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.ClipboardList}" />
            </Border>
            <Border Grid.Column="4" Style="{StaticResource IconButton}" IsVisible="{Binding ShowDeleteMenu}"
                    SemanticProperties.Description="{x:Static res:AppResources.Selection_MenuA11y}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Selection.StartCommand}" />
                </Border.GestureRecognizers>
                <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Delete}" />
            </Border>
        </Grid>
        <!-- "Seçerek sil" mode: [×] 3 seçildi [Tümünü seç] [sil] -->
        <views:SelectionAppBar Grid.Row="0" IsVisible="{Binding Selection.IsActive}" />
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- ════════ Quick add (field + 48 accent button), progress, suggestions ════════ -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" Padding="16,16,16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowQuickAdd}">
                <Border Grid.Column="0" Style="{StaticResource Input}">
                    <Entry Text="{Binding NewTaskTitle}" MaxLength="150" Placeholder="{x:Static res:AppResources.Todo_NewPlaceholder}"
                           ReturnCommand="{Binding AddTaskCommand}" />
                </Border>
                <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{DynamicResource tp-accent}" Opacity="0.4"
                        SemanticProperties.Description="{x:Static res:AppResources.A11y_AddTask}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding CanAddTask}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddTaskCommand}" />
                    </Border.GestureRecognizers>
                    <Label Style="{StaticResource Icon.Bar}" Text="{StaticResource Ic.Plus}" TextColor="{DynamicResource tp-on-accent}" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="4,0" IsVisible="{Binding HasTasks}">
                <controls:ProgressPill Grid.Column="0" Progress="{Binding DoneProgress}" Tone="success" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding DoneText}" FontFamily="InterSemiBold" FontSize="12.5" TextColor="{DynamicResource tp-text-2}" VerticalOptions="Center" />
            </Grid>

            <!-- "Akıllı bavul önerileri" -->
            <Border IsVisible="{Binding IsSuggestionPanelVisible}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="{x:Static res:AppResources.Packing_SuggestionsTitle}" FontFamily="InterBold" FontSize="17" TextColor="{DynamicResource tp-text}"
                               VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                        <Border Grid.Column="1" Style="{StaticResource IconButton}" WidthRequest="36" HeightRequest="36"
                                SemanticProperties.Description="{x:Static res:AppResources.Packing_Close}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding HideSuggestionsCommand}" />
                            </Border.GestureRecognizers>
                            <Label Style="{StaticResource Icon.Bar}" FontSize="20" Text="{StaticResource Ic.Close}" />
                        </Border>
                    </Grid>
                    <controls:LoadingDots IsVisible="{Binding IsLoadingSuggestions}" DotSize="8" DotColor="{DynamicResource tp-accent}" />
                    <Border Style="{StaticResource Banner.Accent}" IsVisible="{Binding HasSuggestions}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource Ic.Sparkles}" TextColor="{DynamicResource tp-accent-text}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding SuggestionHint}" FontSize="13" TextColor="{DynamicResource tp-accent-text}" />
                        </Grid>
                    </Border>
                    <Label Text="{x:Static res:AppResources.Packing_NoSuggestions}" FontSize="14" TextColor="{DynamicResource tp-text-3}" IsVisible="{Binding HasNoSuggestions}" />
                    <ScrollView MaximumHeightRequest="300" IsVisible="{Binding HasSuggestions}">
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Suggestions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PackingSuggestion">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,10" BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=ToggleSuggestionCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <controls:CheckMark Grid.Column="0" IsChecked="{Binding IsSelected}" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <Label Text="{Binding Title}" FontFamily="InterMedium" FontSize="14.5" TextColor="{DynamicResource tp-text}" />
                                            <Label Text="{Binding Reason}" FontSize="12.5" TextColor="{DynamicResource tp-text-3}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Button Text="{x:Static res:AppResources.Packing_AddSelected}" Command="{Binding AddSelectedSuggestionsCommand}"
                            IsVisible="{Binding HasSuggestions}" Style="{StaticResource Btn.Primary}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="3">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadTasksCommand}" IsVisible="{Binding HasTasks}">
                <CollectionView x:Name="TasksCollectionView" ItemsSource="{Binding Tasks}">
                    <CollectionView.Footer>
                        <BoxView HeightRequest="40" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TodoItem">
                            <!-- one slice of the list card (Helpers/ListPositions) -->
                            <Border BackgroundColor="{DynamicResource tp-surface}" Stroke="{DynamicResource tp-border}" StrokeThickness="1" Padding="0"
                                    StrokeShape="{Binding ListPosition, Converter={StaticResource ListPositionShapeConverter}}"
                                    Margin="{Binding ListPosition, Converter={StaticResource ListPositionMarginConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=TaskTappedCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,0,6,0" MinimumHeightRequest="54" BackgroundColor="Transparent">
                                    <!-- Selection mode: the red select circle instead of the tick box, and no edit button. -->
                                    <controls:CheckMark Grid.Column="0" IsChecked="{Binding IsCompleted}"
                                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=Selection.IsInactive}" />
                                    <controls:SelectCircle Grid.Column="0" IsOn="{Binding IsSelected}"
                                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=Selection.IsActive}" />
                                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="15" TextColor="{DynamicResource tp-text}" VerticalOptions="Center" Padding="0,12"
                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource CompletedToStrikethroughConverter}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource tp-text-3}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border Grid.Column="2" Style="{StaticResource IconButton}"
                                            SemanticProperties.Description="{x:Static res:AppResources.A11y_Edit}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=ShowRowEdit}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=EditTaskCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Style="{StaticResource Icon}" FontSize="17" Text="{StaticResource Ic.Edit}" TextColor="{DynamicResource tp-text-3}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <controls:LoadingLogo IsVisible="{Binding IsInitialLoading}" Size="56" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasNoTasks}" Spacing="0" Padding="32,24" VerticalOptions="Start">
                <Border Style="{StaticResource EmptyIcon}">
                    <Label Style="{StaticResource Icon}" FontSize="30" Text="{StaticResource Ic.ListChecks}" TextColor="{DynamicResource tp-accent-text}" />
                </Border>
                <Label Text="{x:Static res:AppResources.Todo_Empty}" Style="{StaticResource Text.EmptyText}" Margin="0,16,0,0" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
