<?xml version="1.0" encoding="utf-8" ?>
<!--
    App bar shown instead of a list page's normal one while the list is in "Seçerek sil" mode:
    [×]  3 seçildi  [Tümünü seç]  [🗑]
    Binds to the page's view model through ISelectableListViewModel (its BindingContext is inherited from the page).
-->
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:res="clr-namespace:TravelPlanner.Resources.Strings"
      xmlns:vm="clr-namespace:TravelPlanner.ViewModels"
      x:Class="TravelPlanner.Views.SelectionAppBar"
      x:DataType="vm:ISelectableListViewModel"
      Style="{StaticResource AppBar}"
      ColumnDefinitions="Auto,*,Auto,Auto">

    <Border Grid.Column="0" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.Selection_Done}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Selection.CancelCommand}" />
        </Border.GestureRecognizers>
        <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Close}" TextColor="{DynamicResource tp-text}" />
    </Border>

    <Label Grid.Column="1" Text="{Binding Selection.Title}" Style="{StaticResource Text.AppBarTitle}" Margin="4,0,0,0" />

    <Button Grid.Column="2" Text="{Binding Selection.ToggleAllText}" Command="{Binding Selection.ToggleAllCommand}"
            Style="{StaticResource Btn.Ghost.Sm}" Padding="10,0" VerticalOptions="Center" />

    <Border Grid.Column="3" Style="{StaticResource IconButton}" SemanticProperties.Description="{x:Static res:AppResources.Selection_DeleteSelectedTitle}"
            ToolTipProperties.Text="{x:Static res:AppResources.Selection_DeleteSelectedTitle}" Opacity="0.4">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding Selection.HasSelection}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding DeleteSelectedCommand}" />
        </Border.GestureRecognizers>
        <Label Style="{StaticResource Icon}" Text="{StaticResource Ic.Delete}" TextColor="{DynamicResource tp-danger}" />
    </Border>
</Grid>
