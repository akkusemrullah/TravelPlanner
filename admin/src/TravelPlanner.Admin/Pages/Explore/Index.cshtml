@page
@model TravelPlanner.Admin.Pages.Explore.IndexModel
@{
    ViewData["Title"] = "Keşfet";
}
<div class="page-head">
    <h1>Keşfet</h1>
    <a class="button" asp-page="Edit">Yeni plan</a>
</div>

<nav class="tabs">
    <a asp-page="Index" class="@(string.IsNullOrEmpty(Model.Status) ? "on" : "")">Tümü</a>
    @foreach (var s in ExploreForm.AllStatuses)
    {
        <a asp-page="Index" asp-route-status="@s" class="@(Model.Status == s ? "on" : "")">@J.StatusText(s)</a>
    }
</nav>

@if (Model.Error is not null)
{
    <p class="alert error">@Model.Error</p>
}
else if (Model.Trips.Count == 0)
{
    <p class="muted">Plan yok.</p>
}
else
{
    <ul class="list">
        @foreach (var t in Model.Trips)
        {
            var slug = J.S(t, "slug");
            var status = J.S(t, "status");
            var thumb = Model.Supabase.ImageUrl(J.S(t, "thumb_path"));
            <li class="row">
                @if (thumb is not null)
                {
                    <img src="@thumb" alt="" class="thumb" loading="lazy" />
                }
                else
                {
                    <span class="thumb empty"></span>
                }
                <div class="grow">
                    <a asp-page="Edit" asp-route-slug="@slug" class="title">@J.S(t, "title")</a>
                    <div class="muted">
                        @J.S(t, "city"), @J.S(t, "country") · @J.S(t, "duration_days") gün · sıra @J.S(t, "sort_rank")
                        @if (J.B(t, "is_featured")) { <span class="badge">Öne çıkan</span> }
                    </div>
                    <div class="muted small">@slug · v@(J.S(t, "content_version")) · @J.When(t, "updated_at")</div>
                </div>
                <span class="badge @status">@J.StatusText(status)</span>
                <form method="post" asp-page-handler="Status" asp-route-status="@Model.Status" class="row-actions">
                    <input type="hidden" name="slug" value="@slug" />
                    @foreach (var s in ExploreForm.AllStatuses.Where(s => s != status))
                    {
                        <button type="submit" name="newStatus" value="@s" class="small secondary">@(s switch { "published" => "Yayınla", "draft" => "Taslağa al", _ => "Arşivle" })</button>
                    }
                </form>
            </li>
        }
    </ul>
}
