@page
@model TravelPlanner.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Kullanıcılar";
}
<h1>Kullanıcılar</h1>
<form method="get" class="search">
    <input asp-for="Q" type="search" placeholder="E-posta veya ad" maxlength="100" />
    <button type="submit">Ara</button>
</form>
@if (Model.Error is not null)
{
    <p class="alert error">@Model.Error</p>
}
else if (Model.Users.Count == 0)
{
    <p class="muted">Kullanıcı bulunamadı.</p>
}
else
{
    <p class="muted small">En yeni 50 hesap gösterilir.</p>
    <ul class="list">
        @foreach (var u in Model.Users)
        {
            var custom = J.N(u, "ai_custom_limit");
            <li class="row">
                <div class="grow">
                    <a asp-page="Detail" asp-route-id="@J.S(u, "id")" class="title">@J.S(u, "email")</a>
                    <div class="muted">@J.S(u, "display_name") · @J.S(u, "trips") seyahat · kayıt @J.When(u, "created_at")</div>
                </div>
                <span class="badge" title="Bugün kullanılan / günlük hak">AI @J.S(u, "ai_used_today")/@J.S(u, "ai_limit")@(custom is null ? "" : " ★")</span>
                @if (J.S(u, "state") != "active")
                {
                    <span class="badge archived">@J.StateText(J.S(u, "state"))</span>
                }
            </li>
        }
    </ul>
}
