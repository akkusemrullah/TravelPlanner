@page
@model TravelPlanner.Admin.Pages.Users.DetailModel
@{
    var a = Model.Account;
    ViewData["Title"] = J.S(a, "email");
}
<p><a asp-page="Index">← Kullanıcılar</a></p>
@if (Model.Error is not null)
{
    <p class="alert error">@Model.Error</p>
}
else
{
    <h1>@J.S(a, "email")</h1>
    <dl class="facts">
        <dt>Ad</dt><dd>@J.S(a, "display_name")</dd>
        <dt>Durum</dt><dd>@J.StateText(J.S(a, "state"))</dd>
        <dt>Kayıt</dt><dd>@J.When(a, "created_at")</dd>
        <dt>Son giriş</dt><dd>@J.When(a, "last_sign_in_at")</dd>
        <dt>Seyahat</dt><dd>@J.S(a, "trips")</dd>
    </dl>

    <section class="card">
        <h2>AI planlama</h2>
        <div class="stats">
            <div class="stat"><span>Bugün</span><strong>@J.S(a, "ai_used_today") / @J.S(a, "ai_limit")</strong></div>
            <div class="stat"><span>Günlük hak</span><strong>@(J.N(a, "ai_custom_limit")?.ToString() ?? "Varsayılan")</strong></div>
        </div>

        <form method="post" asp-page-handler="Limit" asp-route-id="@Model.Id" class="inline">
            <label>Günlük hak (boş = varsayılan)
                <input asp-for="DailyLimit" type="number" min="0" max="100" />
            </label>
            <button type="submit">Kaydet</button>
        </form>
        <form method="post" asp-page-handler="Reset" asp-route-id="@Model.Id" class="inline">
            <button type="submit" class="secondary">Bugünü sıfırla</button>
            <span class="muted small">Bugünkü hakları baştan verir.</span>
        </form>
        <p class="muted small">Tüm kullanıcıların toplam günlük sınırı yine geçerlidir.</p>

        <h3>Son 14 gün</h3>
        @if (!J.Items(a?["ai_history"]).Any())
        {
            <p class="muted">Kullanım yok.</p>
        }
        else
        {
            <table class="simple">
                @foreach (var d in J.Items(a?["ai_history"]))
                {
                    <tr><td>@J.Day(d, "day")</td><td>@J.S(d, "count")</td></tr>
                }
            </table>
        }
    </section>
}
