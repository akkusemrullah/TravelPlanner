@page
@model IndexModel
@{
    ViewData["Title"] = "Genel";
    var o = Model.Overview;
}
<h1>Genel</h1>
@if (Model.Error is not null)
{
    <p class="alert error">@Model.Error</p>
}
else
{
    <div class="stats">
        <div class="stat"><span>Kullanıcı</span><strong>@J.S(o, "users")</strong><small>Son 7 gün: @J.S(o, "users_7d")</small></div>
        <div class="stat"><span>Seyahat</span><strong>@J.S(o, "trips")</strong></div>
        <div class="stat"><span>Bugün AI planı</span><strong>@J.S(o, "ai_today") / @J.S(o, "ai_global_limit")</strong><small>Kişi başı günlük: @J.S(o, "ai_daily_limit")</small></div>
        <div class="stat"><span>Keşfet</span><strong>@J.S(o, "explore_published")</strong><small>Taslak @J.S(o, "explore_draft") · Arşiv @J.S(o, "explore_archived")</small></div>
    </div>
    <p class="actions">
        <a class="button" asp-page="/Explore/Edit">Yeni Keşfet planı</a>
        <a class="button secondary" asp-page="/Users/Index">Kullanıcı ara</a>
    </p>
}
