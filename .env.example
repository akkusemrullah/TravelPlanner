# TravelPlanner - secret and setting names (TEMPLATE ONLY - never put real values in this file or in git)
#
# The mobile app itself needs NO API keys: the free services it calls from the device (Open-Meteo, Photon,
# OpenFreeMap, Frankfurter) need none, and the Supabase URL + publishable key in Helpers/SupabaseConfig.cs are
# public by design (row-level security protects the data). Everything secret lives in the places below.
# Not used by this project (so there is nothing to configure): Gemini, Mapbox, Amadeus, Skyscanner.
# Copy to .env (git-ignored) only if you run the Edge Functions locally: npx supabase functions serve --env-file .env

# ---------------------------------------------------------------- Supabase -> Edge Functions -> Secrets
# plan-trip (supabase/functions/plan-trip/index.ts)
OPENAI_API_KEY=sk-...                    # required for AI planning; OpenAI project key
AI_MODEL=gpt-5-mini                      # optional; code default gpt-5-mini (gpt-5-nano is cheaper, see supabase/README.md)
AI_REASONING=low                         # optional; minimal | low | medium (default: low, minimal for nano models)
AI_MAX_TOKENS=16000                      # optional; upper bound of max_completion_tokens per plan

# purge-files (supabase/functions/purge-files/index.ts)
FILE_CLEANUP_SECRET=<openssl rand -hex 32>   # same value as vault secret 'file_cleanup_secret'

# Provided by Supabase automatically in deployed functions (set them only for local runs)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key - server only, never in the app>

# ---------------------------------------------------------------- Supabase Dashboard (not env vars)
# Authentication -> Attack Protection -> CAPTCHA: Cloudflare Turnstile SECRET key (site key is public:
#   Helpers/SupabaseConfig.CaptchaSiteKey)
# Authentication -> Providers -> Google: OAuth client id + secret

# ---------------------------------------------------------------- Release signing (build-apk.ps1 asks for them)
TP_STORE_PASS=<keystore password>
TP_KEY_PASS=<key password>
# GitHub Actions secrets (docs/ci/ci.yml): ANDROID_KEYSTORE_BASE64, ANDROID_KEY_ALIAS,
#   ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_PASSWORD
