<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Static (non-theme-swapping) colours. Pages use the tp- tokens from DesignTokens.xaml / Themes via
     DynamicResource; these keys exist for the few places that need a StaticResource (MAUI template controls,
     converters) and are kept in step with the royal blue logo palette.
     The Graphite/Coral key names are kept for compatibility; they now hold the royal blue / bright blue brand colours.
     Android status/navigation bar colours: Platforms/Android/Resources/values/colors.xml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand (Travel Planner logo): Royal Blue #1E3A8A, Bright Blue #2563EB, White -->
    <Color x:Key="RoyalBlue">#1E3A8A</Color>
    <!-- Brand surfaces that stay royal blue in light AND dark mode: splash screen, trip ticket card. -->
    <Color x:Key="BrandRoyal">#1E3A8A</Color>
    <Color x:Key="BrandMuted">#C3CEEB</Color>
    <Color x:Key="BrandLine">#3A55A3</Color>
    <Color x:Key="TicketStart">#1E3A8A</Color>
    <Color x:Key="TicketEnd">#2F5BD3</Color>
    <Color x:Key="RoyalBlueDeep">#172554</Color>
    <Color x:Key="BrightBlue">#2563EB</Color>
    <Color x:Key="Graphite">#1E3A8A</Color>
    <Color x:Key="GraphiteDeep">#172554</Color>
    <Color x:Key="Coral">#2563EB</Color>
    <Color x:Key="CoralLight">#3B82F6</Color>

    <Color x:Key="Primary">#1E3A8A</Color>
    <Color x:Key="PrimaryDark">#2563EB</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#E6EDFC</Color>
    <Color x:Key="SecondaryDarkText">#60A5FA</Color>
    <Color x:Key="Tertiary">#2563EB</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#14161B</Color>

    <Color x:Key="Gray100">#ECEEF1</Color>
    <Color x:Key="Gray200">#E2E5EA</Color>
    <Color x:Key="Gray300">#C9CED6</Color>
    <Color x:Key="Gray400">#9AA1AD</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4A505C</Color>
    <Color x:Key="Gray900">#1C2026</Color>
    <Color x:Key="Gray950">#0E1013</Color>

    <!-- Semantic -->
    <Color x:Key="Success">#1B7543</Color>
    <Color x:Key="SuccessDark">#4CC27E</Color>
    <Color x:Key="Danger">#C42B2B</Color>
    <Color x:Key="DangerDark">#FF6B6B</Color>
    <Color x:Key="Warning">#A15C00</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#16191E</Color>
    <Color x:Key="PageBackgroundLight">#F3F4F6</Color>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
